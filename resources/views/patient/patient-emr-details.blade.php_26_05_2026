        <!-- JavaScript -->
        <script>
            // Handle Top Tabs + Left Tabs (Main Navigation)
            const allTabs = document.querySelectorAll('.top-tab, .left-tab');
            const allContents = document.querySelectorAll('.content-area');

            allTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    allTabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');

                    const tabKey = tab.getAttribute('data-tab');
                    allContents.forEach(content => {
                        const contentKey = content.getAttribute('data-tab-content');
                        content.classList.toggle('active', contentKey === tabKey);
                    });
                });
            });

            // Handle Inner Tabs inside Prescription Details
            const innerTabs = document.querySelectorAll('.inner-tab');
            const innerContents = document.querySelectorAll('.inner-tab-content');

            innerTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    innerTabs.forEach(t => t.classList.remove('active'));
                    innerContents.forEach(c => c.classList.remove('active'));

                    tab.classList.add('active');
                    const target = tab.getAttribute('data-inner-tab');
                    const targetContent = document.querySelector(`[data-inner-content="${target}"]`);
                    if (targetContent) {
                        targetContent.classList.add('active');
                    }
                });
            });
        </script>
