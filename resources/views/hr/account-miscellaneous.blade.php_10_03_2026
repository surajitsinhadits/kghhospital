    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const payButtons = document.querySelectorAll('.pay-trigger');
            const paymentForm = document.getElementById('paymentForm');
            if (!paymentForm) return;
            const remainingDueEl = document.getElementById('modalRemainingDue');
            const historyList = document.getElementById('paymentHistory');
            const paymentModal = document.getElementById('paymentModal');
            const payAmountInput = paymentForm.querySelector('input[name="amount_paid"]');
            const routeTemplate = "{{ route('hr.miscellaneous.pay', ['id' => '__id__']) }}";

            const parseAmount = (value) => {
                const parsed = parseFloat(value);
                return Number.isFinite(parsed) ? parsed : null;
            };

            payButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const id = button.getAttribute('data-id');
                    const dueValue = parseAmount(button.getAttribute('data-due'));
                    const totalAmount = parseAmount(button.getAttribute('data-total-amount'));
                    const displayAmount = dueValue ?? totalAmount ?? 0;
                    let payments = [];
                    try {
                        payments = JSON.parse(button.getAttribute('data-payments') || '[]');
                    } catch (e) {
                        payments = [];
                    }
                    paymentForm.setAttribute('action', routeTemplate.replace('__id__', id));
                    const formattedAmount = displayAmount.toFixed(2);
                    remainingDueEl.textContent = formattedAmount;
                    if (payAmountInput) {
                        payAmountInput.value = formattedAmount;
                    }
                    historyList.innerHTML = '';
                    if (payments.length) {
                        payments.forEach(payment => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item small';
                            const details = (payment.details && payment.details.trim()) ? payment.details : 'No details';
                            const paidAt = payment.paid_at ? `<br><small>${payment.paid_at}</small>` : '';
                            li.innerHTML =
                                `<strong>${payment.amount_paid}</strong> paid, discount <strong>${payment.discount}</strong><br>${details}${paidAt}`;
                            historyList.appendChild(li);
                        });
                    } else {
                        const li = document.createElement('li');
                        li.className = 'list-group-item small text-muted';
                        li.textContent = 'No payments recorded yet.';
                        historyList.appendChild(li);
                    }
                    $(paymentModal).modal('show');
                });
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = $('#miscFormModal');
            const form = document.getElementById('misc-form');
            const submitBtn = document.getElementById('formSubmitButton');
            const verifyBtn = document.getElementById('formVerifyButton');
            const approveBtn = document.getElementById('formApproveButton');
            const editButtons = document.querySelectorAll('.edit-misc-btn');
            const methodInput = document.getElementById('formMethod');
            const modalTitle = document.getElementById('modalTitle');
            const defaultAction = form.dataset.defaultAction;
            const billPurpose = document.getElementById('bill_purpose');
            const serviceProvider = document.getElementById('service_provider');
            const billAmount = document.getElementById('bill_amount');
            const gstField = document.getElementById('gst');
            const discountInput = document.getElementById('discount');
            const totalAmountInput = document.getElementById('total_amount_input');
            const markVerifiedInput = document.getElementById('mark_verified');
            const markApprovedInput = document.getElementById('mark_approved');

            const parseNumericInput = (value) => {
                const parsed = parseFloat(value);
                return Number.isFinite(parsed) ? parsed : null;
            };

            const setTotalAmountValue = (value) => {
                if (!totalAmountInput) {
                    return;
                }
                const formatted = Number.isFinite(value) ? value.toFixed(2) : '';
                totalAmountInput.value = formatted;
            };

            const calculateTotal = () => {
                const baseAmount = parseNumericInput(billAmount.value);
                if (baseAmount === null) {
                    setTotalAmountValue(null);
                    return;
                }
                const gstValue = parseNumericInput(gstField.value);
                const effectiveGst = gstValue ?? 0;
                const total = baseAmount + (baseAmount * effectiveGst) / 100;
                if (!Number.isFinite(total)) {
                    setTotalAmountValue(null);
                    return;
                }
                const discountValue = parseNumericInput(discountInput.value) ?? 0;
                const totalAfterDiscount = Math.max(total - discountValue, 0);
                setTotalAmountValue(totalAfterDiscount);
            };

            gstField.addEventListener('input', calculateTotal);
            billAmount.addEventListener('input', calculateTotal);
            discountInput.addEventListener('input', calculateTotal);

            function resetModalFields() {
                form.reset();
                gstField.value = '';
                discountInput.value = '';
                if (totalAmountInput) {
                    totalAmountInput.value = '';
                }
                verifyBtn.classList.add('d-none');
                if (approveBtn) {
                    approveBtn.classList.add('d-none');
                }
                markVerifiedInput.value = '0';
                markApprovedInput.value = '0';
            }

            function populateModal(button) {
                methodInput.value = 'PATCH';
                form.setAttribute('action', button.dataset.action);
                submitBtn.textContent = 'Update Bill';
                submitBtn.dataset.submitted = 'false';
                submitBtn.disabled = false;
                modalTitle.textContent = 'Edit Account Miscellaneous Bill';
                markVerifiedInput.value = '0';
                markApprovedInput.value = '0';
                const isVerified = button.dataset.verified === '1';
                if (!isVerified) {
                    verifyBtn.classList.remove('d-none');
                } else {
                    verifyBtn.classList.add('d-none');
                }
                const isApproved = button.dataset.approved === '1';
                if (isVerified && !isApproved) {
                    approveBtn.classList.remove('d-none');
                } else {
                    approveBtn.classList.add('d-none');
                }

                billPurpose.value = button.dataset.billPurpose || '';
                const svcValue = (button.dataset.serviceProvider || '').trim();
                if (svcValue) {
                    const match = Array.from(serviceProvider.options).find(opt => {
                        const optValue = (opt.value || '').trim();
                        const optText = (opt.textContent || '').trim();
                        return optValue.toLowerCase() === svcValue.toLowerCase()
                            || optText.toLowerCase() === svcValue.toLowerCase();
                    });
                    serviceProvider.value = match ? match.value : '';
                } else {
                    serviceProvider.value = '';
                }

                billAmount.value = button.dataset.billAmount || '';
                const dataTotalValue = button.dataset.totalAmount || '';
                if (totalAmountInput) {
                    totalAmountInput.value = dataTotalValue || '';
                }
                gstField.value = button.dataset.gst || '';
                discountInput.value = button.dataset.discount || '';
                calculateTotal();
                modal.modal('show');
            }

            editButtons.forEach(button => {
                button.addEventListener('click', () => populateModal(button));
            });

            verifyBtn.addEventListener('click', () => {
                markVerifiedInput.value = '1';
                markApprovedInput.value = '0';
                submitBtn.textContent = 'Update & Verified';
                submitBtn.dataset.submitted = 'false';
                submitBtn.disabled = false;
                verifyBtn.classList.add('d-none');
                submitBtn.click();
            });
            approveBtn.addEventListener('click', () => {
                markApprovedInput.value = '1';
                markVerifiedInput.value = '0';
                submitBtn.textContent = 'Update & Approve';
                submitBtn.dataset.submitted = 'false';
                submitBtn.disabled = false;
                approveBtn.classList.add('d-none');
                submitBtn.click();
            });

            modal.on('hidden.bs.modal', function () {
                resetModalFields();
                methodInput.value = 'POST';
                form.setAttribute('action', defaultAction);
                submitBtn.textContent = 'Save Bill';
                submitBtn.dataset.submitted = 'false';
                submitBtn.disabled = false;
            });
        });
    </script>
