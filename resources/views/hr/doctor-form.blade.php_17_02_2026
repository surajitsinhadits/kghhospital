    <script>
        const cat = @json(@$edit->category_id ?? old('charges_catagory'));
        const subCat = @json(@$edit->sub_category_id ?? old('charges_sub_catagory'));
        const docfee = @json(@$edit->doctor_fees ?? old('doctor_fees'));
        if(subCat){
            get_sub_category(cat, subCat);
        }
        function get_sub_category(cate_id, sub_cate_id = 0) {
            var div_data = '';
            $('#doctor_fees').val(docfee);
            $('#charges_sub_catagory').html(`<option value="">Select Sub-Category</option>`);
            $.ajax({
                url: "{{Route('hr.sub-categories-res')}}/"+cate_id,
                type: "GET",
                success: function(response) {
                    $.each(response, function(key, value) {
                        div_data += `<option value="${value.id}" ${sub_cate_id == value.id ? 'selected' : ''}>${value.charges_catagories_name}</option>`
                    });
                    $('#charges_sub_catagory').append(div_data);
                },
                error: function(error) {
                    console.log(error);
                }
            });
        }
    </script>
