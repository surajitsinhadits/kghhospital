@push('js')
    <script type="text/javascript">
        $(function() {
            var table = $('.data-table').DataTable({
                processing: true,
                serverSide: true,
                ajax: "{{ $action }}",
                columns: [{
                        data: null,
                        name: 'sl_no',
                        title: 'Sl. No',
                        render: function(data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        },
                        orderable: false,
                        searchable: false
                    },
                    {
                        data: 'requisition_no',
                        name: 'requisition_no',
                        title: 'Requisition No',
                        orderable: true,
                        searchable: false
                    },
                    {
                        data: 'requisition_date',
                        name: 'st_requisitions.requisition_date',
                        title: 'Requisition Date',
                        render: function(data, type, row) {
                            return `${formatDateTime(row.requisition_date)}`;
                        },
                        orderable: false,
                        searchable: true
                    },
                    {
                        data: 'generated_by',
                        name: 'u.name',
                        title: 'Generated By'
                    },
                    {
                        data: 'department',
                        name: 'd.department_name',
                        title: 'Department',

                    },
                    {
                        data: 'is_given',
                        name: 'is_given',
                        title: 'Status',
                        render: function(data, type, row) {
                            if (data == '0') {
                                return '<span class="badge badge-danger">Not Issued</span>';
                            } else {
                                return '<span class="badge badge-primary">Issued</span>';
                            }
                        }
                    },
                    {
                        data: 'action',
                        name: 'action',
                        title: 'Action'
                    },
                ],

            });
        });
    </script>
@endpush
