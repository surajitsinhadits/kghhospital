<script type="text/javascript">

    function setAction(value) {
        document.getElementById('saveAction').value = value;
    }

    function getItemDetails(item_id, element) {

        var dept = document.getElementById('department_id');
        if( !dept || !dept.value ) {
            alert('Please select a department first and again select item.');
            element.value = '';
            return;
        }
        var department_id = dept.value;

        if (item_id !== '' && department_id !== '') {
            $.ajax({
                url: "{{ route('store.get-item-unit-and-sub-unit') }}",
                type: "POST",
                data: {
                    itemId: item_id,
                    departmentId: department_id,
                    _token: '{{ csrf_token() }}'
                },
                dataType: 'json',
                success: function(res) {
                    let row = $(element).closest('tr');

                    let selectedOption = element.options[element.selectedIndex];
                    let price = parseFloat(selectedOption.getAttribute('data-price')) || 0;

                    row.find('.unit').val(res.unit || '');
                    row.find('.sub_unit').val(res.sub_unit || '');
                    row.find('.unit_id').val(res.unit_id || '');
                    row.find('.sub_unit_id').val(res.sub_unit_id || '');
                    row.find('.sub_unit_qty').attr('max', (res.sub_unit_no || 0) - 1);

                    row.find('.unit_qty').val(1);
                    row.find('input[name="item_price"]').val(price.toFixed(2));
                    row.find('input[name="total_price"]').val(price.toFixed(2));

                    row.find('input[name="dept_qty"]').val(res.dept_unit || 0);
                    row.find('input[name="tot_qty"]').val(res.total_unit || 0);

                    updateGrandTotal();
                },
                error: function() {
                    let row = $(element).closest('tr');
                    row.find('.unit').val('');
                    row.find('.sub_unit').val('');
                    updateGrandTotal();
                }
            });
        }
    }

    // ✅ First row total calculation
    function priceCalculations(input) {
        let row = input.closest('tr');
        let select = row.querySelector('.item_id');
        if(!select) return;

        let selectedOption = select.options[select.selectedIndex];
        let unitQty = parseFloat(row.querySelector('[name="unit_qty"]').value) || 0;
        let subUnitQty = parseFloat(row.querySelector('[name="sub_unit_qty"]').value) || 0;

        let unitPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
        let subUnitNo = parseFloat(selectedOption.getAttribute('data-sub-unit-no')) || 0;

        let totalPrice = (unitQty * unitPrice) + (subUnitNo > 0 ? (subUnitQty * (unitPrice / subUnitNo)) : 0);

        $(row).find('input[name="total_price"]').val(totalPrice.toFixed(2));
        $(row).find('input[name="item_price"]').val(unitPrice.toFixed(2));

        updateGrandTotal();
    }

    // ✅ Existing rows calculation (EDIT PAGE FIX)
    function valueCalculations(input) {
        let row = input.closest('tr');

        // ✅ read price from item_price[] input (works on edit page)
        let unitPrice = parseFloat(row.querySelector('[name="item_price[]"]')?.value) || 0;

        // sub unit no from selected option if present
        let select = row.querySelector('[name="item_id[]"]');
        let subUnitNo = 0;
        if(select && select.options.length){
            let opt = select.options[select.selectedIndex];
            subUnitNo = parseFloat(opt.getAttribute('data-sub-unit-no')) || 0;
        }

        let unitQty = parseFloat(row.querySelector('[name="unit_qty[]"]')?.value) || 0;
        let subUnitQty = parseFloat(row.querySelector('[name="sub_unit_qty[]"]')?.value) || 0;

        let totalPrice = (unitQty * unitPrice) + (subUnitNo > 0 ? (subUnitQty * (unitPrice / subUnitNo)) : 0);

        row.querySelector('[name="total_price[]"]').value = totalPrice.toFixed(2);

        updateGrandTotal();
    }

    function validation(input) {

        var row = $('#chargeTable').find('tr:first');
        var itemSelect = row.find('.item_id').val();
        var unitQtyInput = row.find('.unit_qty');
        var subUnitQtyInput = row.find('.sub_unit_qty');
        var unitQty = parseFloat(unitQtyInput.val());
        var subUnitQty = parseFloat(subUnitQtyInput.val());
        var maxSubUnitQty = parseFloat(subUnitQtyInput.attr('max'));

        if (itemSelect === '') {
            alert('Please Select an Item & Unit!');
        } else if (unitQty <= 0 && subUnitQty <= 0) {
            alert('Please Select Unit or Subunit!');
        } else if (!isNaN(maxSubUnitQty) && subUnitQty > maxSubUnitQty) {
            alert('Sub Unit Qty cannot exceed the maximum allowed value (' + maxSubUnitQty + ')!');
        } else {
            addNewrow(input);
        }
    }

    function addNewrow(input) {

        let row = input.closest('tr');
        let select = row.querySelector('[name="item_id"]');
        let selectedOption = select.options[select.selectedIndex];

        let unitPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
        let subUnitNo = parseFloat(selectedOption.getAttribute('data-sub-unit-no')) || 0;

        let firstRow = $('#chargeTable').find('tr:first');
        let item_id = firstRow.find('.item_id').val();
        let item_text = firstRow.find('.item_id option:selected').text();
        let unit_qty = firstRow.find('.unit_qty').val();
        let unit = firstRow.find('.unit').val();
        let sub_unit_qty = firstRow.find('.sub_unit_qty').val();
        let sub_unit = firstRow.find('.sub_unit').val();
        let unit_id = firstRow.find('.unit_id').val();
        let sub_unit_id = firstRow.find('.sub_unit_id').val();
        let item_price = firstRow.find('input[name="item_price"]').val();
        let total_price = firstRow.find('input[name="total_price"]').val();
        let dept_qty = firstRow.find('input[name="dept_qty"]').val();
        let tot_qty = firstRow.find('input[name="tot_qty"]').val();

        let newRow = `
            <tr>
                <td>
                    <select class="form-control" name="item_id[]">
                        <option data-price="${unitPrice}" data-sub-unit-no="${subUnitNo}" value="${item_id}" selected>${item_text}</option>
                    </select>
                </td>
                <td>
                    <div class="input-group mt-1">
                        <input style="padding-left: 0.50rem;" onkeyup="valueCalculations(this);" class="form-control col-7" type="number" step="0.1" min="0" name="unit_qty[]" value="${unit_qty}" placeholder="Qty" />
                        <input class="form-control col-5" style="padding-left: 0.50rem;" readonly type="text" name="unit_name[]" value="${unit}" placeholder="Unit" />
                    </div>
                </td>
                <td>
                    <div class="input-group mt-1" style="width: 100%;">
                        <input class="form-control col-7" type="number" step="0.1" min="0" style="padding-left: 0.50rem;" onkeyup="valueCalculations(this);" name="sub_unit_qty[]" value="${sub_unit_qty}" placeholder="Sub Qty" />
                        <input class="form-control col-5" readonly type="text" name="sub_unit_name[]" value="${sub_unit}" style="padding-left: 0.50rem;" placeholder="Sub Unit" />
                    </div>
                </td>
                <td>
                    <input type="text" name="item_price[]" class="form-control" readonly value="${item_price}">
                </td>
                <td>
                    <input type="text" name="dept_qty[]" class="form-control" readonly value="${dept_qty}">
                </td>
                <td>
                    <input type="text" name="tot_qty[]" class="form-control" readonly value="${tot_qty}">
                </td>
                <td>
                    <input type="text" name="total_price[]" class="form-control total_price_row" readonly value="${total_price}">
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                </td>
                <input type="hidden" name="unit_id[]" value="${unit_id}">
                <input type="hidden" name="sub_unit_id[]" value="${sub_unit_id}">
            </tr>
        `;
        $('#chargeTable').append(newRow);

        // Reset first row
        firstRow.find('.item_id').val('').trigger('change');
        firstRow.find('.unit_qty').val('0');
        firstRow.find('.unit').val('');
        firstRow.find('.sub_unit_qty').val('0');
        firstRow.find('.sub_unit').val('');
        firstRow.find('.unit_id').val('');
        firstRow.find('.sub_unit_id').val('');
        firstRow.find('input[name="item_price"]').val(0);
        firstRow.find('input[name="total_price"]').val(0);
        firstRow.find('input[name="dept_qty"]').val(0);
        firstRow.find('input[name="tot_qty"]').val(0);

        updateGrandTotal();
    }

    function removeRow(button) {
        let row = button.closest('tr');
        row.remove();
        updateGrandTotal();
    }

    // ✅ GRAND TOTAL CALCULATION (ALWAYS WORKS FOR EDIT PAGE)
    function updateGrandTotal() {
        let grandTotal = 0;

        // sum existing rows total_price[]
        document.querySelectorAll('#chargeTable input[name="total_price[]"]').forEach((el) => {
            grandTotal += parseFloat(el.value) || 0;
        });

        // include first add row total_price (only when item selected)
        const firstRow = document.querySelector('#chargeTable tr:first-child');
        if (firstRow) {
            const itemSelect = firstRow.querySelector('select[name="item_id"]');
            const firstTotalInput = firstRow.querySelector('input[name="total_price"]');
            if (itemSelect && itemSelect.value && firstTotalInput) {
                grandTotal += parseFloat(firstTotalInput.value) || 0;
            }
        }

        document.getElementById('grand_total').value = grandTotal.toFixed(2);
    }

    // ✅ IMPORTANT: calculate grand total on load for ALL PAGES (edit/verify/approve/default)
    $(document).ready(function () {
        updateGrandTotal();

        // sometimes select2/layout loads late, re-calc once
        setTimeout(function(){
            updateGrandTotal();
        }, 300);

        // keep submit validation only for default/add page
        @php if( (!empty($type) && $type == 'default') || empty($type) ): @endphp
        $('#yourFormId').submit(function (e) {
            e.preventDefault();
            if ($('#chargeTable').find('tr').length <= 1) {
                alert('Please add at least one item.');
                return false;
            }
            this.submit();
        });
        @php endif @endphp
    });

</script>

