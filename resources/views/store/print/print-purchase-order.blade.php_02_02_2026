                @if(!empty($item_list))
                    @foreach($item_list as $list)
                        @php
                            $qty  = (float) ($list->unit_qty ?? 0);
                            $rate = (float) ($list->rate ?? 0);

                            // ✅ Base amount (rate * qty)
                            $base_amount = $qty * $rate;

                            // ✅ Discount
                            $discount_percent = (float) ($list->discount ?? 0);
                            $discount_amount  = ($discount_percent > 0) ? ($base_amount * $discount_percent / 100) : 0;

                            // ✅ Taxable after discount
                            $taxable_amount = max(0, $base_amount - $discount_amount);

                            // ✅ GST %
                            $cgst_percent = (float) ($list->cgst ?? 0);
                            $sgst_percent = (float) ($list->sgst ?? 0);
                            $igst_percent = (float) ($list->igst ?? 0);

                            // ✅ GST Amounts (calculated on taxable)
                            $cgst_amount = ($cgst_percent > 0) ? ($taxable_amount * $cgst_percent / 100) : 0;
                            $sgst_amount = ($sgst_percent > 0) ? ($taxable_amount * $sgst_percent / 100) : 0;
                            $igst_amount = ($igst_percent > 0) ? ($taxable_amount * $igst_percent / 100) : 0;

                            $gst_total = $cgst_amount + $sgst_amount + $igst_amount;

                            // ✅ Final total
                            $final_total = $taxable_amount + $gst_total;

                            // ✅ Grand total
                            $grand_total += $final_total;
                        @endphp

