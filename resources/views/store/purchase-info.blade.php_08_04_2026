@php
    /**
     * USER REQUIREMENT:
     * 1) discount_amount deduct from total amount
     * 2) then deduct vendor_pay_amount from that total
     * 3) remaining = due amount
     *
     * Table fields:
     * - total (decimal)
     * - discount_amount (decimal)
     * - discount_type (percentage/Rs)
     * - vendor_pay_amount (decimal)
     */

    $dbTotal        = (float) (@$data->sub_total ?? 0);               // total from DB
    $discountAmount = (float) (@$data->discount_amount ?? 0);
    $discountType   = (string) (@$data->discount_type ?? '');     // 'percentage' OR 'Rs' (or empty)
    $vendorPaid     = (float) (@$data->vendor_pay_amount ?? 0);

    // ✅ compute discount value
    // If discount_type == percentage => discount value = total * (discount_amount/100)
    // else => discount value = discount_amount (Rs)
    $discountValue = 0.0;
    if (strtolower($discountType) === 'percentage') {
        $discountValue = ($dbTotal * $discountAmount) / 100;
    } else {
        $discountValue = $discountAmount;
    }

    // ✅ after-discount total
    $netTotal = max($dbTotal - $discountValue, 0);

    // ✅ due = netTotal - vendorPaid
    $due = max($netTotal - $vendorPaid, 0);

    // ✅ Optional: prevent showing vendorPaid more than netTotal
    $vendorPaidDisplay = min($vendorPaid, $netTotal);

    // prepare discount type helpers
    $discountTypeNormalized = strtolower(trim((string) $discountType));
    $discountTypeNormalized = $discountTypeNormalized === 'percentage' ? 'percentage' : 'rs';
    $discountUnitLabel = $discountTypeNormalized === 'percentage' ? '%' : '₹';
