<script>
document.addEventListener('DOMContentLoaded', function () {
    const parseNumber = (value) => {
        const parsed = Number(value);
        return Number.isFinite(parsed) ? parsed : 0;
    };

    const formatWithTwoDecimals = (value) => {
        const number = Number(value);
        return Number.isFinite(number) ? number.toFixed(2) : '0.00';
    };

    // ✅ due should be based on (total - discountValue - vendor_pay_amount)
    const dueAmount = parseNumber(@json((float)$due));
    const subTotal = parseNumber(@json((float)$dbTotal));
    const discountTypeNormalized = @json($discountTypeNormalized);
    const initialDiscountAmount = parseNumber(@json((float)$discountAmount));
    const initialDiscountValue = parseNumber(@json((float)$discountValue));
    const modal     = document.getElementById('ekPayModal');

    const openBtn   = document.getElementById('openMakePaymentModal');
    const closeBtn  = document.getElementById('ekPayCloseBtn');
    const cancelBtn = document.getElementById('ekCancelBtn');

    const payInput  = document.getElementById('ek_pay_amount');
    const discountInput = document.getElementById('ek_discount_amount');
    const useDueBtn = document.getElementById('ekUseDueBtn');
    const saveBtn   = document.getElementById('ekSavePayBtn');
    const errBox    = document.getElementById('ek_pay_error');
    const dueTextEl = document.getElementById('ek_due_text');

    const getDiscountValue = (rawValue) => {
        const numeric = parseNumber(rawValue);
        if (discountTypeNormalized === 'percentage') {
            return (subTotal * numeric) / 100;
        }
        return numeric;
    };

    const getDiscountFromInput = () => {
        const raw = discountInput ? discountInput.value : initialDiscountAmount;
        return getDiscountValue(raw);
    };

    const getAdjustedDueAmount = () => {
        const discountDiff = getDiscountFromInput() - initialDiscountValue;
        return Math.max(dueAmount - discountDiff, 0);
    };

    const updateDueDisplay = () => {
        if (!dueTextEl) return;
        dueTextEl.innerText = getAdjustedDueAmount().toFixed(2);
    };

    function openModal(){
        if (!modal) return;
        modal.style.display = 'flex';
        if (payInput) payInput.value = '';
        if (discountInput) discountInput.value = formatWithTwoDecimals(initialDiscountAmount);
        if (errBox){ errBox.style.display = 'none'; errBox.innerText = ''; }
        updateDueDisplay();
    }

    function closeModal(){
        if (!modal) return;
        modal.style.display = 'none';
    }

    // ✅ open
    if (openBtn) openBtn.addEventListener('click', openModal);

    // ✅ close
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

    if (discountInput) {
        discountInput.addEventListener('input', updateDueDisplay);
    }

    // ✅ close when clicking overlay
    if (modal) {
        modal.addEventListener('click', function(e){
            if (e.target === modal) closeModal();
        });
    }

    // ✅ fill due
    if (useDueBtn) {
        useDueBtn.addEventListener('click', function(){
            if (payInput) payInput.value = formatWithTwoDecimals(getAdjustedDueAmount());
        });
    }

    // ✅ save
    if (saveBtn) {
        saveBtn.addEventListener('click', async function () {
            if (errBox){ errBox.style.display = 'none'; errBox.innerText = ''; }

            const payAmount = parseFloat((payInput && payInput.value) ? payInput.value : '0');
            const discountAmount = Math.max(0, parseNumber(discountInput ? discountInput.value : initialDiscountAmount));
            const adjustedDue = getAdjustedDueAmount();

            if (!payAmount || payAmount <= 0) {
                errBox.innerText = 'Please enter a valid pay amount.';
                errBox.style.display = 'block';
                return;
            }

            if (payAmount > adjustedDue) {
                errBox.innerText = 'Pay amount cannot be greater than the due amount after discount.';
                errBox.style.display = 'block';
                return;
            }

            saveBtn.disabled = true;

            try {
                const res = await fetch("{{ route('st.purchases.make-payment', @$data->id) }}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRF-TOKEN": "{{ csrf_token() }}",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({ pay_amount: payAmount, discount_amount: discountAmount })
                });

                const data = await res.json().catch(() => ({}));

                if (!res.ok || !data.status) {
                    errBox.innerText = (data && data.message) ? data.message : 'Payment failed. Try again.';
                    errBox.style.display = 'block';
                    saveBtn.disabled = false;
                    return;
                }

                window.location.reload();

            } catch (e) {
                errBox.innerText = 'Network error. Please try again.';
                errBox.style.display = 'block';
                saveBtn.disabled = false;
            }
        });
    }
});
</script>
