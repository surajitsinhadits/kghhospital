@push('js')
<script type="text/javascript">

    function getItemDetails(issue_id){
        $('#chargeTable').html('');
        $('.sub-btn').hide();

        if (issue_id) {
            $.ajax({
                url: "{{ route('store.get-issue-items') }}",
                type: "post",
                data: {
                    issue_id: issue_id,
                    _token: '{{ csrf_token() }}',
                },
                dataType: 'json',
                success: function(res) {
                    if (res.status) {

                        let newRow = null;
                        let table = document.getElementById("chargeTable");
                        let rowCount = table.rows.length;
                        // $('#department').val(res.data.department_id).trigger('change');
                        // $('#chargeTable tr:first').hide();
                        res.data.forEach(item => {
                            // Extract values from each item
                            let itemValue = item.item_id;
                            let itemText = item.item_name || '';
                            let unit_id = item.unit_id || '';
                            let unit = item.unit_name || '';
                            let sub_unit_id = item.sub_unit_id || '';
                            let sub_unit = item.sub_unit_name || '';
                            let sub_unit_no = item.sub_unit_no || 1;
                            let avi = item.avail_qty;

                            // Create new row
                            newRow = table.insertRow(table.rows.length);

                            newRow.insertCell(0).innerHTML =
                                `<select class="form-control" name="item_name[]">
                                    <option value="${itemValue}">${itemText}</option>
                                </select>
                                <input class="form-control" type="hidden" name="unit_id[]" value="${unit_id}" />
                                <input class="form-control" type="hidden" name="sub_unit_id[]" value="${sub_unit_id}" />`;

                            newRow.insertCell(1).innerHTML =
                                `
                                <div class="input-group">
                                    <input required style="padding-left: 0.50rem;" class="form-control col-7 unit_qty" type="number" min="0" max="${avi}" id="unit_qty" name="unit_qty[]" value="" step="0.1" placeholder="Qty" />
                                    <input class="form-control col-5 unit" style="padding-left: 0.50rem;" readonly type="text" name="unit_name[]" value="${unit}" placeholder="Unit" />
                                </div>`;

                            newRow.insertCell(2).innerHTML =
                                `
                                <div class="input-group" style="width: 100%;">
                                    <input class="form-control col-7 sub_unit_qty" max="${sub_unit_no-1}" type="number" min="0" style="padding-left: 0.50rem;" name="sub_unit_qty[]" value="0" step="0.1" placeholder="Sub Qty" />
                                    <input class="form-control col-5 sub_unit" readonly type="text" name="sub_unit_name[]" value="${sub_unit}" style="padding-left: 0.50rem;" placeholder="Sub Unit" />
                                </div>`;

                            newRow.insertCell(3).innerHTML =
                                `<input class="form-control avi_qty" id="avi_qty" readonly type="text" name="avi_qty" value="${avi}" />`;

                            newRow.insertCell(4).innerHTML =
                                `<button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>`;

                            rowCount++;
                        });
                        $('.sub-btn').show();
                    } else {
                        alert('Requisition not found');
                    }
                }
            });
        }else{
            $('#chargeTable tr:first').show();
        }
    }

    function setAction(value) {
        document.getElementById('saveAction').value = value;
    }

    $('#item_id').on('change', function () {

        const $opt = $(this).find('option:selected');
        const aviQty = $opt.data('avi-qty');
        $('#avi_qty').val(aviQty ?? 0);
        $('#unit_qty').attr('max', aviQty ?? 0);

        const subUnitNo = $opt.data('sub-unit-no');
        $('.sub_unit_qty').attr('max', (subUnitNo - 1) ?? 0);

    });

    $('#expense_type').on('change', function () {

        $('.hide-all').hide();

        const $opt = $(this).find('option:selected');
        const expenseType = $opt.val();
        if( expenseType == 'doctor' ){
            $('#doctor_id').show();
        } else if( expenseType == 'patient' ){
            $('#patient_id').show();
        } else if( expenseType == 'staff' ){
            $('#staff_id').show();
        }

    });

    function validation(input) {

        var row = $('#chargeTable').find('tr:first');
        var itemSelect = row.find('.item_id').val();
        var itemSelect = row.find('.expense_type').val();
        var unitQtyInput = row.find('.unit_qty');
        var subUnitQtyInput = row.find('.sub_unit_qty');
        var unitQty = parseFloat(unitQtyInput.val());
        var subUnitQty = parseFloat(subUnitQtyInput.val());
        var maxSubUnitQty = parseFloat(subUnitQtyInput.attr('max'));

        if (itemSelect === '') {
            alert('Please Select an Item & Unit!');
        } else if (unitQty <= 0 && subUnitQty <= 0) {
            alert('Please Select Unit or Subunit!');
        } else if (!isNaN(maxSubUnitQty) && subUnitQty > maxSubUnitQty) {
            alert('Sub Unit Qty cannot exceed the maximum allowed value (' + maxSubUnitQty + ')!');
        } else {
            addNewrow(input);
        }

    }

    function addNewrow(input) {

        let firstRow        = $('#chargeTable').find('tr:first');
        let item_id         = firstRow.find('.item_id').val();
        let item_text       = firstRow.find('.item_id option:selected').text();

        let expense_id      = firstRow.find('.expense_type').val();
        let expense_text    = firstRow.find('.expense_type option:selected').text();

        let aviQty = firstRow.find('.item_id option:selected').attr('data-avi-qty') || 0;
        let subUnitNo = firstRow.find('.item_id option:selected').attr('data-sub-unit-no') || 0;

        let unit_id = firstRow.find('.item_id option:selected').attr('data-unit-id') || 0;
        let sub_unit_id = firstRow.find('.item_id option:selected').attr('data-sub-unit-id') || 0;

        let unit_qty        = firstRow.find('.unit_qty').val();
        let unit            = firstRow.find('.unit').text();
        let sub_unit_qty    = firstRow.find('.sub_unit_qty').val();
        let sub_unit        = firstRow.find('.sub_unit').text();

        let newRow = `
            <tr>
                <td>
                    <select class="form-control" name="item_id[]">
                        <option value="${item_id}" selected>${item_text}</option>
                    </select>
                </td>
                <td>
                    <select class="form-control" name="expense_type[]">
                        <option value="${expense_id}" selected>${expense_text}</option>
                    </select>
                </td>
                <td>
                    <div class="input-group mt-1">
                        <input style="padding-left: 0.50rem;" class="form-control col-7" type="text" max="${aviQty}" name="unit_qty[]" value="${unit_qty}" placeholder="Qty" />
                        <input class="form-control col-5" style="padding-left: 0.50rem;" readonly type="text" name="unit_name[]" value="${unit}" placeholder="Unit" />
                    </div>
                </td>
                <td>
                    <div class="input-group mt-1" style="width: 100%;">
                        <input class="form-control col-7" type="text" style="padding-left: 0.50rem;" name="sub_unit_qty[]" value="${sub_unit_qty}" placeholder="Sub Qty" />
                        <input class="form-control col-5" readonly type="text" max="${subUnitNo-1}" name="sub_unit_name[]" value="${sub_unit}" style="padding-left: 0.50rem;" placeholder="Sub Unit" />
                    </div>
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button>
                </td>
                    <input type="hidden" name="unit_id[]" value="${unit_id}">
                    <input type="hidden" name="sub_unit_id[]" value="${sub_unit_id}">
            </tr>
        `;
        $('#chargeTable').append(newRow);

        // Reset first row
        firstRow.find('.item_id').val('').trigger('change');
        firstRow.find('.unit_qty').val('0');
        firstRow.find('.unit').val('');
        firstRow.find('.sub_unit_qty').val('0');
        firstRow.find('.sub_unit').val('');
        firstRow.find('.expense_type').val('').trigger('change');
    }

    function removeRow(button) {
        let row = button.closest('tr');
        row.remove();
    }

    @php if( (!empty($type) && $type == 'default') || empty($type) ): @endphp
    $(document).ready(function () {
        $('#yourFormId').submit(function (e) {
            e.preventDefault();
            if ($('#chargeTable').find('tr').length <= 1) {
                alert('Please add at least one item.');
                return false;
            }
            this.submit();
        });
    });
    @php endif @endphp

    function removeRow(button) {
        const row = button.closest('tr');
        row.remove();
    }
</script>


@endpush

