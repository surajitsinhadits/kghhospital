                } else if (phone.length > 0 && !/^\d{10}$/.test(phone)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Name validation
            function validateName() {
                let $input = $('#name');
                let name = $input.val();
                // Check if required and not empty
                if (isRequired($input) && name.trim().length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    // $('#name-error').text('Name is required.');
                    return false;
                }
                // Allow only alphabets and spaces
                if (!/^[A-Za-z\s]+$/.test(name)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    // $('#name-error').text('Name can only contain alphabets and spaces.');
                    return false;
                }
                $input.removeClass('is-invalid').css('border-color', '#007bff');
                // $('#name-error').text('');
                return true;
            }
            $('#name').on('input', function() {
                // Replace any character that is not a letter or space with ''
                this.value = this.value.replace(/[^A-Za-z\s]/g, '');
            });

            // Address validation (no special characters like @, #, etc.)
            function validateAddress() {
                var $input = $('#address');
                var address = $input.val();
                var regex = /^[a-zA-Z0-9\s,.-]*$/;
                if (isRequired($input) && address.trim().length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (address.trim().length > 0 && !regex.test(address)) {
