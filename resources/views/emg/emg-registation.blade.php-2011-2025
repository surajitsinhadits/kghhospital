            function validateMonth() {
                var $input = $('#date_of_birth_month');
                var month = $input.val();
                if (isRequired($input) && month.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (month.length > 0 && !/^\d+$/.test(month)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            function validateDay() {
                var $input = $('#date_of_birth_day');
                var day = $input.val();
                if (isRequired($input) && day.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (day.length > 0 && !/^\d+$/.test(day)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Pin code validation (optional: 6 digits)
            function validatePin() {
                var $input = $('#pin_no');
                var pin = $input.val();
                if (pin.length > 0 && !/^\d{6}$/.test(pin)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Payment amount validation (only numbers, can be decimal)
            function validatePaymentAmount(selector) {
                var $input = $(selector);
                var val = $input.val();
                if (isRequired($input) && val.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (val.length > 0 && !/^\d+(\.\d{1,2})?$/.test(val)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Numeric-only validation for rate, qty, amount (allow decimals)
            function validateNumericField(selector) {
                var $input = $(selector);
                var val = $input.val();
                if (isRequired($input) && val.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (val.length > 0 && !/^\d+(\.\d{1,2})?$/.test(val)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Integer-only validation for discount fields
            function validateIntegerField(selector) {
                var $input = $(selector);
                var val = $input.val();
                if (isRequired($input) && val.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (val.length > 0 && !/^\d+$/.test(val)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Numeric validation for total_discount (allow decimals)
            function validateTotalDiscount() {
                var $input = $('#total_discount');
                var val = $input.val();
                if (isRequired($input) && val.length === 0) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else if (val.length > 0 && !/^\d+(\.\d{1,2})?$/.test(val)) {
                    $input.addClass('is-invalid').css('border-color', '#dc3545');
                    return false;
                } else {
                    $input.removeClass('is-invalid').css('border-color', '#007bff');
                    return true;
                }
            }

            // Restrict input to numbers only for numeric fields
            $('#patient_ph_no, #date_of_birth_year, #date_of_birth_month, #date_of_birth_day, #pin_no, #discount_in_per, #discount_amount')
                .on('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                });

            // Restrict payment fields, numeric fields, and total_discount to numbers and dot only
            $('#case_payment, #bank_payment, input[name="payment_amount[]"], #rate, #qty, #amount, #total_discount')
                .on('input', function() {
                    this.value = this.value.replace(/[^0-9.]/g, '');
                    // Prevent multiple dots
                    if ((this.value.match(/\./g) || []).length > 1) {
                        this.value = this.value.replace(/\.+$/, "");
                    }
                });

            // Attach live validation to keyup/input events
            $('#patient_ph_no').on('input', validatePhone);
            $('#name').on('input', validateName);
            $('#address').on('input', validateAddress); // Only input event needed for address
            $('#date_of_birth_year').on('input', validateYear);
            $('#date_of_birth_month').on('input', validateMonth);
            $('#date_of_birth_day').on('input', validateDay);
            $('#pin_no').on('input', validatePin);

            $('#case_payment').on('input', function() {
                validatePaymentAmount('#case_payment');
            });
            $('#bank_payment').on('input', function() {
                validatePaymentAmount('#bank_payment');
            });
            $('input[name="payment_amount[]"]').on('input', function() {
                validatePaymentAmount(this);
            });

            // Numeric fields live validation (allow decimals)
            $('#rate').on('input', function() {
                validateNumericField('#rate');
            });
            $('#qty').on('input', function() {
                validateNumericField('#qty');
            });
            $('#amount').on('input', function() {
                validateNumericField('#amount');
            });

            // Discount fields live validation (integers only)
            $('#discount_in_per').on('input', function() {
                validateIntegerField('#discount_in_per');
            });
            $('#discount_amount').on('input', function() {
                validateIntegerField('#discount_amount');
            });

            // total_discount live validation
            $('#total_discount').on('input', validateTotalDiscount);

            // Highlight required fields on blur if empty (no message, just border)
            $('form#yourFormId [required]').each(function() {
                var $input = $(this);

                $input.on('blur', function() {
                    if ($input.val().trim() === '') {
                        $input.addClass('is-invalid').css('border-color', '#dc3545');
                    } else {
                        $input.removeClass('is-invalid').css('border-color', '');
                    }
                });

                // Remove red border on input
                $input.on('input', function() {
                    if ($input.val().trim() !== '') {
                        $input.removeClass('is-invalid').css('border-color', '');
                    }
                });
            });

            // On form submit, validate all
            $('#yourFormId').on('submit', function(e) {
                let valid = true;
                if (!validatePhone()) valid = false;
                if (!validateName()) valid = false;
                if (!validateAddress()) valid = false;
                if (!validateYear()) valid = false;
                if (!validateMonth()) valid = false;
                if (!validateDay()) valid = false;
                if (!validatePin()) valid = false;
                if (!validatePaymentAmount('#case_payment')) valid = false;
                if (!validatePaymentAmount('#bank_payment')) valid = false;
                $('input[name="payment_amount[]"]').each(function(idx) {
                    if (!validatePaymentAmount(this)) valid = false;
                });
                if (!validateNumericField('#rate')) valid = false;
                if (!validateNumericField('#qty')) valid = false;
                if (!validateIntegerField('#discount_in_per')) valid = false;
                if (!validateIntegerField('#discount_amount')) valid = false;
                if (!validateNumericField('#amount')) valid = false;
                if (!validateTotalDiscount()) valid = false;

                // Check all required fields again on submit
                $('form#yourFormId [required]').each(function() {
                    var $input = $(this);
                    if ($input.val().trim() === '') {
                        $input.addClass('is-invalid').css('border-color', '#dc3545');
                        valid = false;
                    }
                });

                if (!valid) {
                    e.preventDefault();
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Please fix validation errors before submitting.');
                    } else {
                        alert('Please fix validation errors before submitting.');
                    }
                    return false;
                }
            });
        });
