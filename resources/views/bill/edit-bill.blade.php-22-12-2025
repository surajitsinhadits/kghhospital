            var totalss = (parseInt(new_recept_amount) + parseInt(previous_recpt_amount) + parseInt(rt) + parseInt(
                advance_pay) + parseInt(adv_adjust_amount));
            var grnd_total = $('#grnd_total').val();
            var previous_credit_used = $('#previous_credit_used').val();

            var amnt = 0;
            var due_amnt = 0;
            var credit_amnt = 0;
            // var edit_pt = $('#previous_payment_amount').val() ?? 0;
            if (grnd_total > totalss) {
                due_amnt = parseInt(parseInt(parseInt(grnd_total) + parseInt(previous_credit_used)) - totalss);
