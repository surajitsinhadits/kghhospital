    <script>
        $(function() {
            // Helper: timestamp for filenames
            function ts() {
                const d = new Date();
                return d.toISOString().slice(0, 19).replace(/[:T]/g, '-');
            }

            // Values to use in exported headers
            const reportTitle = @json($title ?? 'Due Reports');
            const orgName = @json(config('app.name', 'Application'));
            const generatedAt = new Date().toLocaleString();

            $('#myTable').DataTable({
                pageLength: 50,
                dom: "<'row mb-2'<'col-sm-6'B><'col-sm-6'f>>" +
                    "tr" +
                    "<'row mt-2'<'col-sm-5'i><'col-sm-7'p>>",
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Download Excel',
                        title: 'Due Reports',
                        filename: 'due-reports_' + ts(),
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customizeData: function(data) {
                            // Strip currency symbols/commas so Excel treats as numbers
                            for (let i = 0; i < data.body.length; i++) {
                                [4, 5, 6].forEach(idx => {
                                    if (data.body[i][idx] != null) {
                                        data.body[i][idx] = String(data.body[i][idx]).replace(/[^\d.-]/g, '');
                                    }
                                });
                            }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: 'Download PDF',
                        title: 'Due Reports',
                        filename: 'due-reports_' + ts(),
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customize: function(doc) {
                            // Basic styles
                            doc.defaultStyle.fontSize = 10;
                            doc.styles.tableHeader.fontSize = 12;

                            // Optional footer with generated timestamp
                            doc.footer = function(currentPage, pageCount) {
                                return {
                                    margin: [40, 0, 40, 20],
                                    columns: [
                                        { text: 'Generated: ' + generatedAt, alignment: 'left', fontSize: 9, color: '#666' },
                                        { text: '', alignment: 'center' },
                                        { text: '', alignment: 'right' }
                                    ]
                                };
                            };

                            // Make all columns auto width
                            if (doc.content && doc.content[1] && doc.content[1].table) {
                                doc.content[1].table.widths =
                                    Array(doc.content[1].table.body[0].length).fill('*');
                            }
                        }
                    },
                    {
                        extend: 'print',
                        text: 'Print',
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customize: function(win) {
                            // Ensure base font-size is readable
                            $(win.document.body).css('font-size', '10pt');

                            // Settings for the header image sizing
                            const headerUrl = "{{ asset('public/assets/images/header/kgh.png') }}";
                            const headerImgWidthPercent = 95; // 100% = full table width
                            const headerImgHeightMM = 25;      // height in mm (adjust as needed)

                            const $table = $(win.document.body).find('table');
                            const $thead = $table.find('thead');

                            // Determine visible column count (respecting colvis/hidden columns)
                            let colCount = 0;
                            $thead.find('tr:first th').each(function() {
                                if ($(this).css('display') !== 'none') colCount++;
                            });
                            if (colCount === 0) {
                                colCount = $table.find('tr:first th').length || 1;
                            }

                            // Rows to inject into THEAD so they repeat on every printed page:
                            const imageRow = `
                                <tr class="repeat-print-header">
                                    <th colspan="${colCount}" style="border:none; padding:0;">
                                        <img src="${headerUrl}" alt="Header"
                                             style="width:${headerImgWidthPercent}%; height:${headerImgHeightMM}mm; object-fit:contain;">
                                    </th>
                                </tr>
                            `;
                            const titleRow = `
                                <tr class="repeat-print-title">
                                    <th colspan="${colCount}" style="border:none; padding:0 0 6px 0; text-align:center;">
                                        <div style="font-weight:700; font-size:12pt;">${reportTitle}</div>
                                    </th>
                                </tr>
                            `;

                            // Prepend in reverse order so final order is: titleRow (top), imageRow, then your table header
                            $thead.prepend(imageRow);
                            $thead.prepend(titleRow);

                            // Print-specific CSS
                            const printCss = `
                                @media print {
                                    thead { display: table-header-group; }
                                    tfoot { display: table-footer-group; }
                                    .dt-print-title { display: none !important; }

                                    .repeat-print-title th,
                                    .repeat-print-header th {
                                        background: #fff !important;
                                        border: none !important;
                                        padding: 0 !important;
                                    }
                                    .repeat-print-title div {
                                        line-height: 1.2;
                                    }

                                    table.dataTable { page-break-inside: auto; }
                                    table.dataTable tr { page-break-inside: avoid; page-break-after: auto; }
                                }
                            `;
                            $(win.document.head).append('<style type="text/css">' + printCss + '</style>');

                            // Tighten table styling for print
                            $table.addClass('compact').css('font-size', '10pt');
                        }
                    },
                    {
                        extend: 'colvis',
                        text: 'Columns'
                    }
                ]
            });
        });
    </script>
