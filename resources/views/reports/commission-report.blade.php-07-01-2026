                        if(response.status == '1') {
                            location.reload();
                        } else {
                            alert(response.message || 'Save failed.');
                        }
                    },
                    error: function(error) {
                        console.log(error);
                    },
                    complete: function() {
                        $("#loader").hide();
                    }
                });
            }

        }
