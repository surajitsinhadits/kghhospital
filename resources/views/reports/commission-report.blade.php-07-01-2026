    <script>
        function updateCommissionExportLinks() {
            const params = new URLSearchParams();
            const marketBy = $('#market_by').val() || [];
            const provider = $('#provider').val() || [];
            const referral = $('#referral').val() || [];
            const from = $('#fromDate').val();
            const to = $('#toDate').val();

            marketBy.forEach(v => params.append('market_by[]', v));
            provider.forEach(v => params.append('provider[]', v));
            referral.forEach(v => params.append('referral[]', v));
            if (from) params.set('from_date', from);
            if (to) params.set('to_date', to);

            const query = params.toString();
            ['#comPdfExport', '#comExcelExport'].forEach(function(sel){
                const link = $(sel);
                if (!link.length) return;
                const baseUrl = link.data('base-url') || link.attr('href');
                link.attr('href', query ? `${baseUrl}?${query}` : baseUrl);
            });
        }
        $(document).on('change', '#market_by, #provider, #referral, #fromDate, #toDate', updateCommissionExportLinks);
        $(document).ready(updateCommissionExportLinks);
    </script>
