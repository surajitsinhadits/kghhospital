@push('js')
    <script>
        $(function() {
            // Helper: timestamp for filenames
            function ts() {
                const d = new Date();
                return d.toISOString().slice(0, 19).replace(/[:T]/g, '-');
            }

            // Values to use in exported headers
            const reportTitle = @json($title ?? 'Due Reports');
            const orgName = @json(config('app.name', 'Application'));
            const generatedAt = new Date().toLocaleString();

            $('#myTable').DataTable({
                pageLength: 50,
                dom: "<'row mb-2'<'col-sm-6'B><'col-sm-6'f>>" +
                    "tr" +
                    "<'row mt-2'<'col-sm-5'i><'col-sm-7'p>>",
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: 'Download Excel',
                        title: 'Due Reports',
                        filename: 'due-reports_' + ts(),
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customizeData: function(data) {
                            // Strip currency symbols/commas so Excel treats as numbers
                            for (let i = 0; i < data.body.length; i++) {
                                [4, 5, 6].forEach(idx => {
                                    if (data.body[i][idx] != null) {
                                        data.body[i][idx] = String(data.body[i][idx]).replace(/[₹,]/g, '');
                                    }
                                });
                            }
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: 'Download PDF',
                        title: 'Due Reports',
                        filename: 'due-reports_' + ts(),
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customize: function(doc) {
                            // Basic styles
                            doc.defaultStyle.fontSize = 10;
                            doc.styles.tableHeader.fontSize = 12;

                            // Optional footer with generated timestamp
                            doc.footer = function(currentPage, pageCount) {
                                return {
                                    margin: [40, 0, 40, 20],
                                    columns: [
                                        { text: 'Generated: ' + generatedAt, alignment: 'left', fontSize: 9, color: '#666' },
                                        { text: '', alignment: 'center' },
                                        { text: '', alignment: 'right' }
                                    ]
                                };
                            };

                            // Make all columns auto width
                            if (doc.content && doc.content[1] && doc.content[1].table) {
                                doc.content[1].table.widths =
                                    Array(doc.content[1].table.body[0].length).fill('*');
                            }
                        }
                    },
                    {
                        extend: 'print',
                        text: 'Print',
                        exportOptions: { columns: ':visible:not(.no-export)' },
                        customize: function(win) {
                            // Ensure base font-size is readable
                            $(win.document.body).css('font-size', '10pt');

                            // Build a header row for the print view
                            const headerHtml = `
                                <div style="margin-bottom:8px; padding-bottom:8px; border-bottom:1px solid #ccc;">
                                    <img src="{{ asset('public/assets/images/header/kgh.png') }}" alt="logo" style="width: 850px;">
                                </div>
                            `;
                            $(win.document.body).prepend(headerHtml);

                            // Optional: tighten table styling for print
                            $(win.document.body).find('table')
                                .addClass('compact')
                                .css('font-size', '10pt');
                        }
                    },
                    {
                        extend: 'colvis',
                        text: 'Columns'
                    }
                ]
            });
        });
    </script>
@endpush
