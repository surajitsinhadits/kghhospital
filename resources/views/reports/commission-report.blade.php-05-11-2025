    <script>
        $('.data-table').DataTable({
            "pageLength": 50, // Default number of rows per page
            "lengthMenu": [10, 25, 50, 100, 200], // Dropdown options for rows per page
            "language": {
                "emptyTable": "No data available in table" // Custom message when table is empty
            }
        });

        function getData(user_type, type_id, bill_id){

            $("#userTable").html('');
            let formData = $(this).serialize();
            console.log(formData);
            if( bill_id ){
                $.ajax({
                    url: "{{ route('reports.commission-patient-charge') }}",
                    type: "POST",
                    data: {
                        _token: '{{ csrf_token() }}',
                        bill_id: bill_id,
                        user_type: user_type,
                        type_id: type_id
                    },
                    beforeSend: function() {
                        $("#loader").show();
                    },
                    success: function(response) {
                        if(response.status == 'success') {
                            $.each(response.data, function(index, user) {
                                var s_no = index + 1;
                                $("#userTable").append(`
                                                    <tr>
                                                        <td class="text-center">${s_no}</td>
                                                        <td class="text-center">${user.billing_id}</td>
                                                        <td class="text-center">${user.charge_name}</td>
                                                        <td class="text-center amount-text">${user.amount}</td>

                                                        <td class="text-center">
                                                            <input type="number" min="0" class="discount" name="discount[]" />
                                                            <input type="hidden" class="total-amount" name="total_amount[]" value="${user.amount}">
                                                            <input type="hidden" name="bill_id[]"    value="${user.billing_id}">
                                                            <input type="hidden" name="patient_id[]" value="${user.patient_id}">
                                                            <input type="hidden" name="charge_id[]"  value="${user.charge_id}">
                                                            <input type="hidden" name="type[]"       value="${user_type}">
                                                            <input type="hidden" name="type_id[]"    value="${type_id}">
                                                        </td>

                                                        <td>
                                                            <input type="text" class="discount-amount" name="discount_amount[]" readonly>
                                                        </td>
                                                        </tr>
                                                    `);

                            });
                            var myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
                            myModal.show();
                        }
                    },
                    error: function(error) {
                        console.log(error);
                    },
                    complete: function() {
                        $("#loader").hide();
                    }
                });
            }

        }

        $('#saveBtn').on('click', function (e) {
            e.preventDefault();

            let invalid = false, firstBad = null;

            $('.discount').each(function () {
                const v = $(this).val().trim();

                if (v === '') {                 // empty → set to 0
                $(this).val(0);
                return;
                }

                const n = Number(v);
                if (!Number.isFinite(n) || n < 0) {
                invalid = true;
                firstBad = firstBad || this;
                return false; // break .each
                }
            });

            if (invalid) {
                alert('Discount must be a number that is 0 or greater.');
                if (firstBad) firstBad.focus();
                return; // don’t submit
            }

            const fd = new FormData(document.getElementById('conssion'));

            $.ajax({
                url: "{{ route('reports.commission-discount') }}",
                type: "POST",
                dataType: "json",
                data: fd,
                processData: false,     // required for FormData
                contentType: false,     // required for FormData
                headers: { 'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content') },
                beforeSend() { $("#loader").show(); },
                success(res) {
                if (String(res.status) === '1') {
                    location.reload();
                } else {
                    alert(res.message || 'Save failed.');
                }
                },
                error(xhr) {
                console.log('AJAX error:', xhr.status, xhr.responseText);
                alert('Request failed.');
                },
                complete() { $("#loader").hide(); }
            });
        });

        /* amount calculate start */

        function toNum(v){ return parseFloat(String(v).replace(/,/g,'')) || 0; }
        function fmt2(n){ return Number(n).toFixed(2); }

        // When user types/pastes a discount %
        $(document).on('input change', '.discount', function () {
            const $tr = $(this).closest('tr');

            // prefer hidden total-amount, fallback to the visible amount-text cell
            let amount = toNum($tr.find('.total-amount').val());
            if (!amount) amount = toNum($tr.find('.amount-text').text());

            // read & clamp percent
            let pct = toNum($(this).val());
            if (pct < 0) pct = 0;
            if (pct > 100) pct = 100;

            const discAmt = amount * (pct / 100);
            $tr.find('.discount-amount').val(fmt2(discAmt));
        });

        /* amount calculate end */

    </script>
@endpush
