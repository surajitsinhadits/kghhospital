        function getPatient(val, col) {
            var div_data = '';
            $('#search_result').attr('style', 'display:none', true);
            $('#search_result_row').html('');
            if (val && col) {
                $.ajax({
                    url: "{{ route('opd.get-patients') }}",
                    type: "POST",
                    data: {
