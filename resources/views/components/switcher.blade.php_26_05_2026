<script>
    function fetch_global_data() {
        var uhid = $('#p_uhid').val();
        var p_mobile = $('#p_mobile').val();
        var p_name = $('#p_name').val();
        var div_data = '';
        $('#search_patient_data_in_global').empty();
        $.ajax({
            url: "{{ route('hr.patient-search-in-global') }}",
            type: "POST",
            data: {
                _token: '{{ csrf_token() }}',
                Patientuhid: uhid,
                Patientmobile: p_mobile,
                Patientname: p_name,
            },
            success: function(response) {
                $.each(response.all_patient, function(key, value) {
                    div_data +=
                        `<tr><td><a  href="{{ route('hr.patient-profile-details', '') }}/${btoa(JSON.stringify(value.id))}" >${value.name|| ''} ( ${value.id} )<br>${value.phone} || ${value.dob_year || 0 }Y ${value.dob_month || 0}M ${value.dob_day || 0}D <br> ${value.address|| ''}</a></td></tr>`
                });
                $('#search_patient_data_in_global').append(div_data);
            },
            error: function(error) {
                console.log(error);
            }
        });

    }
</script>
