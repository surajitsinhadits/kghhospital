    public function index(Request $request){
        $doctor = User::where('user_type','doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        if ($request->ajax()) {
            $data = EmgRegister::select('emg_registers.id',
                'emg_registers.appointment_date',
                'emg_registers.type',
                'emg_registers.patient_id',
                'p.name as patient_name',
                'p.phone',
                'p.gender',
                'p.dob_year',
                'p.dob_month',
                'p.dob_day',
                'bi.due_amount',
                'bi.bill_status',
                'u1.name as doctor_name',
                'd.department_name',
                'bi.id as billing_id',
                'bi.uid'
            )
            ->join('patients as p','p.id','=','emg_registers.patient_id')
            ->join('billings as bi', function ($join) {
                $join->on('bi.section_id', '=', 'emg_registers.id')
                    ->where('bi.section', '=', 'EMG');
            })
            ->join('users as u1','u1.id','=','emg_registers.doctor_id')
            ->join('departments as d','d.id','=','emg_registers.department_id')
            ->where('bi.section','EMG')
            ->where('emg_registers.is_delete',0)
            ->orderBy('emg_registers.id','DESC');

            // Filter based on field_name and field_value
            if (!empty($request->field_name) && !empty($request->field_value)) {
                if ($request->field_name === 'emg_registers.doctor_id') {
                    $data->where('emg_registers.doctor_id', $request->field_value);
                } else {
                    $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                }
            }

            // Filter by date range
            if (!empty($request->from_date)) {
                $data->whereDate('emg_registers.appointment_date', '>=', date('Y-m-d',strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $data->whereDate('emg_registers.appointment_date', '<=', date('Y-m-d',strtotime($request->to_date)));
            }

        return Datatables::of($data)
        ->addIndexColumn()
        ->addColumn('billing', function($row){
            $billingBtn = '<a href="'.route('bill.billing-details', ['emg', ed($row->billing_id, true)]).'" data-placement="top" data-toggle="tooltip" title="Click here to show bill details" data-original-title="Click here to show bill details">'.$row->uid.'</a><br>';
            $billingBtn .= $row->bill_status == 3 ? '<span class="badge badge-gradient-secondary mr-1">Cancel Bill</span>': '';
            $row->due_amount > 0 ? $billingBtn .= '<span class="badge badge-gradient-warning">Due</span>' : $billingBtn .= '<span class="badge badge-gradient-success">No Due</span>';
            return $billingBtn;
        })
        ->addColumn('patient', function($row){
            $patientBtn = '<a href="'.route('hr.patient-profile-details', ed($row->patient_id, true)).'" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important" data-original-title="Click here for patient details">
                '.$row->patient_name.'
                <br>
                <i class="fa fa-venus-mars text-blue"></i> '.$row->gender.'
                <i class="fa fa-calendar-plus-o text-blue"></i> '.$row->dob_year.'Y '.$row->dob_month.'M '.$row->dob_day.'D
                <span class="badge badge-gradient-primary mt-2">'.$row->type.'</span>
                <br>
            </a>';
            return $patientBtn;
        })
        ->addColumn('doctor', function($row){
            $doctorBtn = '<i class="fa fa-cubes text-blue"></i> '.$row->department_name.'
                <br>
                <i class="fa fa-cube text-blue"></i> '.$row->doctor_name;
            return $doctorBtn;
        })
        ->addColumn('action', function($row){
            $actionBtn = '<a href="'.route('bill.billing-details', ['emg', ed($row->billing_id, true)]).'" class="btn btn-primary btn-sm mx-1" title="Click here to show bill details"><i class="fa fa-eye"></i> View</a>';
            return $actionBtn;
        })
        ->rawColumns(['action','patient','doctor','billing'])
        ->make(true);
        }
        $data = compact('doctor');
        return view('emg.emg-listing')->with($data);
    }
    public function emg_registation(){
        $department = Department::where('status','0')->get();
        $doctor = User::where('user_type','doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        $referral = Referral::where('type','referral')->where('is_active', 1)->where('is_delete', 0)->get();
        $provider = Referral::where('type','provider')->where('is_active', 1)->where('is_delete', 0)->get();
        $market_by = Referral::where('type','market_by')->where('is_active', 1)->where('is_delete', 0)->get();
        $states = State::where('country_id','1')->get();
        $charges = Charge::select('charges.id','charges.charge_name','chs.charge_amount')
            ->join('charges_has_sections as chs','chs.charge_id','=','charges.id')
            ->join('charges_sections as cs','cs.id','=','chs.charge_section_id')
            ->where('cs.charges_section_name','EMG')
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->get();
        $data = compact('department','doctor','referral','provider','market_by','states','charges');

        return view('emg.emg-registation')->with($data);
    }
    public function update_emg_register(Request $request){
        $request->validate([
            'appointment_date' => 'required',
            'cons_doctor' => 'required',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'required|digits:10',
            'address' => 'required',
            'state' => 'required',
            'uhid' => 'nullable|exists:patients,id',
        ]);
        // dd($request);
        DB::beginTransaction();
        try {

            //SAVE in Patient
            $patient = Patient::find($request->uhid) ?? new Patient();
            $patient->name = ucwords($request->name);
            $patient->phone = $request->phone;
            $patient->gender = $request->gender;
            $patient->dob_year = $request->date_of_birth_year ?? 0;
            $patient->dob_month = $request->date_of_birth_month ?? 0;
            $patient->dob_day = $request->date_of_birth_day ?? 0;
            $patient->address = $request->address;
            $patient->state = $request->state;
            $patient->district = is_numeric($request->district) ? $request->district : null;
            $patient->pin_code = $request->pin_no;
            $patient->save();
            $patient_id = $patient->id;

            //SAVE in EMG Details
            $emg = new EmgRegister();
            $emg->department_id = $request->department ? $request->department : User::where('id',$request->cons_doctor)->first()->department_id;
            $emg->doctor_id = $request->cons_doctor;
            $emg->patient_id = $patient_id;
            $emg->generate_by = Auth::user()->id;
            $emg->type = $request->uhid ? 'old' : 'new';
            $emg->appointment_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $emg->referred_by = $request->referred_by;
            $emg->provider = $request->provider;
            $emg->market_by = $request->market_by;
            $emg->save();
            $emg_id = $emg->id;

            //SAVE in CASE Reference
            $caseReference = new CaseReference;
            $caseReference->patient_id = $patient_id;
            $caseReference->section = 'EMG';
            $caseReference->section_id = $emg_id;
            $caseReference->save();

            //SAVE in PATIENT DOCTOR STATUS
            $checkStatus = PatientDoctorStatus::where('doctor_id',$request->cons_doctor)->where('patient_id',$patient_id)->first();
            $checkStatus ? $patient_type = 'old' : $patient_type = 'new';
            $doctorPatientStatus = new PatientDoctorStatus();
            $doctorPatientStatus->section = 'EMG';
            $doctorPatientStatus->section_id = $emg_id;
            $doctorPatientStatus->doctor_id = $request->cons_doctor;
            $doctorPatientStatus->patient_id = $patient_id;
            $doctorPatientStatus->patient_type = $patient_type;
            $doctorPatientStatus->date = $request->appointment_date ? date('Y-m-d', strtotime($request->appointment_date)) : null;
            $doctorPatientStatus->save();

            //SAVE in Billing Section
            $bill = new Billing();
            $bill->uid = Billing::where('section', 'EMG')->selectRaw('MAX(CAST(uid AS UNSIGNED)) as max_uid')->value('max_uid') + 1;
            $bill->section = 'EMG';
            $bill->section_id = $emg_id;
            $bill->bill_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $bill->patient_id = $patient_id;
            $bill->doctor_id = $request->cons_doctor;
            $bill->referred_by = $request->referred_by;
            $bill->provider = $request->provider;
            $bill->market_by = $request->market_by;
            $bill->case_id = $caseReference->id;
            $bill->total = $request->total;
            $bill->sub_total = $request->total;
            $bill->discount_amount = $request->total - $request->grand_total;
            $bill->discount = $request->total_discount ?? 0;
            $bill->discount_type = $request->discount_type;
            $bill->discount_status = 'Approved';
            $bill->total_payment = $request->total_payment;
            if($request->grand_total > $request->total_payment){
                $bill->due_amount = $request->grand_total - $request->total_payment;
            }else{
                $bill->cradit_amount = $request->total_payment - $request->grand_total;
            }
            $bill->grand_total = $request->grand_total;
            $bill->status = 'Done';
            $bill->bill_status = 1;
            $bill->created_by = Auth::user()->id;
            $bill->save();
            $bill_id = $bill->id;

            if($bill->cradit_amount > 0){
                PatientCraditAmount::create([
                    'patient_id' => $patient_id,
                    'billing_id' => $bill_id,
                    'date' => date('Y-m-d H:i:s'),
                    'amount' => $bill->cradit_amount,
                    'type' => 'credit',
                    'remarks' => 'added',
                    'generated_by' => Auth::id(),
                ]);
            }

            //SAVE in Billing Details
            $userDetais = User::where('id',$request->cons_doctor)->first();
            ($userDetais->commission_type == 'rs') ? $commisionAmount = (($userDetais->commission_amount / $userDetais->doctor_fees) * 100) : $commisionAmount = $userDetais->commission_amount;

            foreach ($request->charge_name as $key => $value) {
                $commision = 0;
                $charge = Charge::select('charges.*','cc.charges_catagories_name')
                    ->join('charges_catagories as cc','cc.id','=','charges.sub_category_id')
                    ->where('charges.id', $request->charge_name[$key])
                    ->first();
                if(!$charge){
                    continue;
                }
                (@$charge->charges_catagories_name == 'CONSULTANCY FEES') ? $commision = ($request->amount[$key] * ($commisionAmount / 100)) : $commision = 0;

                $bill_details =  new BillingDetail();
                $bill_details->billing_id = $bill_id;
                $bill_details->charge_category_id = $charge->category_id ?? 0;
                $bill_details->charge_sub_category_id = $charge->sub_category_id ?? 0;
                $bill_details->date = date('Y-m-d H:i', strtotime($request->appointment_date));
                $bill_details->charge_id = $request->charge_name[$key];
                $bill_details->charge_name = $charge->charge_name;
                $bill_details->standard_charges = $request->rate[$key];
                $bill_details->commision_amount = $commision;
                $bill_details->discount_percentage = $request->discount_in_per[$key];
                $bill_details->discount_amount = $request->discount_amount[$key];
                $bill_details->qty = $request->qty[$key];
                $bill_details->amount = $request->amount[$key];
                $bill_details->save();

                //SAVE in investigations
                if($charge->charge_type == 'investigation'){
                    $charge_normal = ChargesHasNormal::where('charge_id',$charge->id)->get();
                    if($charge->category_id == 10){
                        $type = 'pathology';
                    }elseif($charge->category_id == 12){
                        $type = 'non-pathology';
                    }elseif($charge->category_id == 11){
                        $type = 'radiology';
                    }else{
                        $type = null;
                    }
                    if($type){
                        $investigation = new Investigation();
                        $investigation->type = $type;
                        $investigation->charge_id = $charge->id;
                        $investigation->bill_id =  $bill_id;
                        $investigation->bill_details_id = $bill_details->id;
                        $investigation->patient_id = $patient_id;
                        $investigation->bill_created_by = Auth::user()->id;
                        $investigation->bill_created_date = date('Y-m-d H:i:s');
                        $investigation->expected_delivery_at = date('Y-m-d');
                        $investigation->report_status = '0'; // 0 => only bill created, 1 => sample collected, 2 => sample collecting, 3 => lab received, 4 => report generated, 5 => report deliverd
                        $investigation->section = 'EMG';
                        $investigation->section_id = $emg_id;
                        $investigation->doctor_id = $request->cons_doctor;
                        $investigation->save();

                        foreach ($charge_normal as $key => $value) {
                            $investigation_details = new InvestigationDetail();
                            $investigation_details->investigation_id = $investigation->id;
                            $investigation_details->charge_normal_id = $value->id;
                            $investigation_details->save();
                        }
                    }
                }
            }

            //SAVE in Payment
            if (count($request->payment_amount ?? []) > 0) {
                foreach($request->payment_amount as $key=>$value){
                    if($request->payment_amount[$key] > 0){
                        $payment = new Payment();
                        $payment->billing_id = $bill_id;
                        $payment->patient_id = $patient_id;
                        $payment->section = 'EMG';
                        $payment->payment_amount = $request->payment_amount[$key];
                        $payment->payment_mode = $request->payment_mode[$key];
                        $payment->payment_bank = $request->payment_mode[$key] == 'Cash' ? null : $request->bank_name;
                        $payment->payment_recived_by = Auth::user()->id;
                        $payment->payment_date = date('Y-m-d H:i');
                        $payment->save();
                    }
                }
            }

            //credit use
            if (count($request->adjust_credit_amount ?? []) > 0) {
                foreach($request->adjust_credit_amount as $key=>$value){
                    if($request->adjust_credit_amount[$key] > 0){
                        $credit = new PatientCraditAmount();
                        $credit->billing_id = $bill_id;
                        $credit->patient_id = $patient_id;
                        $credit->date = date('Y-m-d H:i:s');
                        $credit->amount = $request->adjust_credit_amount[$key];
                        $credit->type = 'debit';
                        $credit->remarks = 'reused';
                        $credit->use_bill_id = $request->credit_bill[$key];
                        $credit->generated_by = Auth::user()->id;
                        $credit->save();

                        $upbill = Billing::find($request->credit_bill[$key]);
                        $upbill->cradit_amount = $upbill->cradit_amount - $request->adjust_credit_amount[$key];
                        $upbill->cradituse_bill_id = $upbill->cradituse_bill_id.'_'.$bill_id;
                        $upbill->cradituse_bill_amount = $upbill->cradituse_bill_amount.'_'.$request->adjust_credit_amount[$key];
                        $upbill->save();
                    }
                }
            }

            DB::commit();
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        if($request->submit == 'close'){
            return redirect()->route('emg.patient-list')->with('success', 'EMG Registration Sucessfully');
        }elseif($request->submit == 'bill'){
            $url1 = route('bill.print-bill', ['emg',ed($bill_id, true)]);
            $return_action = route('emg.registation');
            return view('open-single-tabs', compact('url1', 'return_action'));
        }else{
            return redirect()->route('emg.registation')->with('success', 'EMG Registration Sucessfully');
        }
    }
    public function get_doctors(Request $request){
        $doctors = User::where('department_id', $request->dept_id)->where('is_active','1')->where('is_delete','0')->get();
        return response()->json([
            'success' => true,
            'doctors' => $doctors
        ]);
    }
    public function get_patients(Request $request){
        $patients = Patient::where($request->field, 'LIKE', "%{$request->value}%")->where('is_active','1')->where('is_delete','0')->take(10)->get();
        return response()->json([
            'success' => true,
            'patients' => $patients
        ]);
    }
    public function find_doctor_charge_by_doctor(Request $request)
    {
        $user_details = User::where('id',$request->doctorId)->first();
        $charge_details = Charge::where('id', $user_details->charge_id)->first();
        $charge_amount_details = ChargesHasSection::where('charge_id', $charge_details->id)->first();

        return response()->json([
            'department_id'=>$user_details->department_id,
            'charge_details_id'=>$charge_details->id,
            'charge_details'=>$charge_details->charges_name,
            'charge_amount_details'=>$charge_amount_details->charge_amount
        ]);
    }
