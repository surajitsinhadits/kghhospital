    public function update_admission($ipd_id, Request $request)
    {
        // dd($ipd_id, $request);
        $request->validate([
            'admission_type' => 'required',
            'admission_date' => 'required',
            'patient_package_type' => 'required',
            'insurance_type' => 'required',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'required|digits:10',
            'guardian_name' => 'required',
            'relation' => 'required',
            'address' => 'required',
            'state' => 'required',
            'under_doctor' => 'required',
            'bed_category' => 'required',
            'bed' => 'required',
            'referred_by' => 'required',
            'uhid' => 'nullable|exists:patients,id',
        ]);
        DB::beginTransaction();
        try {
            //SAVE in Patient
            $request->uhid ? $patient = Patient::find($request->uhid) : $patient = new Patient();
            $patient->name = ucwords($request->name);
            $patient->phone = $request->phone;
            $patient->gender = $request->gender;
            $patient->marital_status = $request->marital_status;
            $patient->guardian_name = $request->guardian_name;
            $patient->guardian_realation = $request->relation;
            $patient->guardian_contact_no = $request->guardian_contact_no;
            $patient->date_of_birth = $request->date_of_birth;
            $patient->dob_year = $request->date_of_birth_year;
            $patient->dob_month = $request->date_of_birth_month;
            $patient->dob_day = $request->date_of_birth_day;
            $patient->address = $request->address;
            $patient->state = $request->state;
            $patient->district = is_numeric($request->district) ? $request->district : null;
            $patient->pin_code = $request->pin_code;
            $patient->identification_name = 'Aadhar Card';
            $patient->identification_number = $request->aadhar_card_no;
            $patient->save();
            $patient_id = $patient->id;

            //SAVE in IPD Details
            $old_ipd = IpdRegister::find($ipd_id);
            $ipd = IpdRegister::find($ipd_id);
            $ipd->admission_type = $request->admission_type;
            $ipd->admission_date = $request->admission_date ? date('Y-m-d H:i:s', strtotime($request->admission_date)) : null;
            $ipd->patient_id = $patient_id;
            $ipd->package_type = $request->patient_package_type;
            // $ipd->package_id = $request->patient_package_type;
            // $ipd->package_name = Package::where('id',$request->patient_package_type)->first()->package_name;
            // $ipd->package_amount = Package::where('id',$request->patient_package_type)->first()->package_amount;
            $ipd->insurance_id = $request->insurance_type;
            $ipd->insurance_no = $request->insurance_no;
            $ipd->type = $request->uhid ? 'old' : 'new';
            $ipd->symptoms = $request->symptoms;
            $ipd->diagnosis_id = $request->icd_code_at_the_time_of_admission;
            $ipd->department_id = User::where('id', $request->under_doctor)->first()->department_id;
            $ipd->doctor_id = $request->under_doctor;
            $ipd->other_doctor_id = $request->other_under_doctor;
            $ipd->ward_id = $request->bed_category;
            $ipd->bed_id = $request->bed;
            $ipd->referred_by = $request->referred_by;
            $ipd->provider = $request->provider;
            $ipd->market_by = $request->market_by;
            $ipd->history_alcoholism = $request->history_alcoholism;
            $ipd->medical_surgical_history = $request->medical_surgical_history;
            $ipd->family_history_diagnosis = $request->family_history_diagnosis;
            $ipd->responsible_person = $request->responsible_person;
            $ipd->responsible_person_relation = $request->responsible_person_relation;
            $ipd->responsible_person_ph_no = $request->responsible_person_ph_no;
            $ipd->responsible_person_age = $request->responsible_person_age;
            $ipd->responsible_person_address = $request->responsible_person_address;
            $ipd->edit_by = Auth::user()->id;
            $ipd->edit_at = date('y-m-d H:i:s');
            $ipd->update();
            $ipd_id = $ipd->id;

            if ($old_ipd->doctor_id != $request->under_doctor) {
                //SAVE in PATIENT DOCTOR STATUS
                $checkStatus = PatientDoctorStatus::where('doctor_id', $request->under_doctor)->where('patient_id', $patient_id)->first();
                $checkStatus ? $patient_type = 'old' : $patient_type = 'new';
                $doctorPatientStatus = new PatientDoctorStatus();
                $doctorPatientStatus->section = $request->admission_type;
                $doctorPatientStatus->section_id = $ipd_id;
                $doctorPatientStatus->doctor_id = $request->under_doctor;
                $doctorPatientStatus->patient_id = $patient_id;
                $doctorPatientStatus->patient_type = $patient_type;
                $doctorPatientStatus->date = $request->admission_date ? date('Y-m-d', strtotime($request->admission_date)) : null;
                $doctorPatientStatus->save();
            }

            if ($old_ipd->bed_id != $request->bed) {
                //UPDATE in BED STATUS
                Bed::where('id', $old_ipd->bed_id)->update(['is_used' => 'no']);
                Bed::where('id', $request->bed)->update(['is_used' => 'yes']);

                //UPDATE in PATIENT BED HISTORY
                $patientBedUpdate = PatientBedHistory::where('patient_id', $patient_id)->where('section', 'IPD')->where('section_id', $ipd_id)->orderBy('id', 'DESC')->first();
                // $patientBedUpdate->to_date = date('Y-m-d H:i:s');
                $patientBedUpdate->to_date = Carbon::now();
                $patientBedUpdate->save();

                //SAVE in PATIENT BED HISTORY
                $patientBedHistory = new PatientBedHistory();
                $patientBedHistory->patient_id = $patient_id;
                $patientBedHistory->bed_id = $request->bed;
                $patientBedHistory->from_date = date('Y-m-d H:i:s');
                $patientBedHistory->section = $request->admission_type;
                $patientBedHistory->section_id = $ipd_id;
                $patientBedHistory->department_id = User::where('id', $request->under_doctor)->first()->department_id;
                $patientBedHistory->cons_doctor_id = $request->under_doctor;
                $patientBedHistory->save();
            }

            DB::commit();
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        return redirect()->back()->with('success', 'Admission Updated Sucessfully');
    }
