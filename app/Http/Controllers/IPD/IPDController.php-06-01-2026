    public function index(Request $request)
    {
        $doctor = User::where('user_type', 'doctor')
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->get();

        if ($request->ajax()) {

            $data = IpdRegister::select(
                'ipd_registers.id',
                'ipd_registers.admission_type',
                'ipd_registers.package_type',
                'ipd_registers.type',
                'ipd_registers.discharge_status',
                'ipd_registers.patient_id',
                'ipd_registers.admission_date',
                'p.name as patient_name',
                'p.phone',
                'p.gender',
                'p.dob_year',
                'p.dob_month',
                'p.dob_day',
                'u1.name as doctor_name',
                'u2.name as other_doctor_name',
                'd.department_name',
                'tpa.tpa_name',
                'w.ward_name',
                // 'dr.discharge_date',
                'ipd_registers.discharge_at',
                'dr.discharge_type',
                'b.bed_name',
                DB::raw('MAX(bi.id) as billing_id'),
                // Aggregate billing data
                DB::raw('(SELECT COALESCE(SUM(due_amount),0) FROM billings WHERE patient_id = ipd_registers.patient_id) as overall_due'),
                // DB::raw('COALESCE(SUM(bi.due_amount),0) as overall_due'),
                DB::raw('COALESCE(SUM(bi.cradit_amount),0) as overall_cradit'),
                DB::raw('COALESCE(SUM(bi.refund_amount),0) as overall_refund')
            )
                ->join('patients as p', 'p.id', '=', 'ipd_registers.patient_id')
                ->leftJoin('billings as bi', function ($join) {
                    $join->on('bi.section_id', '=', 'ipd_registers.id')
                        ->whereIn('bi.section', ['IPD', 'DAYCARE']);
                })
                ->leftJoin('discharge_reports as dr', function ($join) {
                    $join->on('dr.section_id', '=', 'ipd_registers.id')
                        ->whereIn('dr.section', ['IPD', 'DAYCARE']);
                })
                ->join('users as u1', 'u1.id', '=', 'ipd_registers.doctor_id')
                ->leftJoin('users as u2', 'u2.id', '=', 'ipd_registers.other_doctor_id')
                ->join('departments as d', 'd.id', '=', 'ipd_registers.department_id')
                ->leftJoin('tpa_managements as tpa', 'tpa.id', '=', 'ipd_registers.insurance_id')
                ->join('wards as w', 'w.id', '=', 'ipd_registers.ward_id')
                ->join('beds as b', 'b.id', '=', 'ipd_registers.bed_id')
                ->groupBy(
                    'ipd_registers.id',
                    'p.name',
                    'p.phone',
                    'p.gender',
                    'p.dob_year',
                    'p.dob_month',
                    'p.dob_day',
                    'u1.name',
                    'u2.name',
                    'd.department_name',
                    'ipd_registers.discharge_at',
                    'dr.discharge_type',
                    'tpa.tpa_name',
                    'w.ward_name',
                    'b.bed_name',
                    'ipd_registers.admission_type',
                    'ipd_registers.package_type',
                    'ipd_registers.discharge_status',
                    'ipd_registers.type',
                    'ipd_registers.patient_id',
                    'ipd_registers.admission_date'
                )
                ->where('ipd_registers.is_delete', 0);

            // Filter based on field_name and field_value
            if (!empty($request->field_name) && !empty($request->field_value)) {
                if ($request->field_name === 'ipd_registers.doctor_id') {
                    $data->where('ipd_registers.doctor_id', $request->field_value);
                } else {
                    $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                }
            }
            if ($request->status_value == 3) {
                $data->where('ipd_registers.discharge_status', $request->status_value);
                $data->orderByRaw('DATE(ipd_registers.discharge_at) DESC');
                // Filter by date range
                if (!empty($request->from_date)) {
                    $data->whereDate('ipd_registers.discharge_at', '>=', date('Y-m-d', strtotime($request->from_date)));
                }
                if (!empty($request->to_date)) {
                    $data->whereDate('ipd_registers.discharge_at', '<=', date('Y-m-d', strtotime($request->to_date)));
                }
            } elseif ($request->status_value == 1) {
                // $data->where('ipd_registers.discharge_status', 0);
                $data->orderBy('ipd_registers.id', 'DESC');
                // Filter by date range
                if (!empty($request->from_date)) {
                    $data->whereDate('ipd_registers.admission_date', '>=', date('Y-m-d', strtotime($request->from_date)));
                }
                if (!empty($request->to_date)) {
                    $data->whereDate('ipd_registers.admission_date', '<=', date('Y-m-d', strtotime($request->to_date)));
                }
            } /*elseif ($request->from_date && $request->to_date) {
                $data->where('ipd_registers.discharge_status', 0);
                $data->orderBy('ipd_registers.id', 'DESC');
                // Filter by date range
                if (!empty($request->from_date)) {
                    $data->whereDate('ipd_registers.admission_date', '>=', date('Y-m-d', strtotime($request->from_date)));
                }
                if (!empty($request->to_date)) {
                    $data->whereDate('ipd_registers.admission_date', '<=', date('Y-m-d', strtotime($request->to_date)));
                }
            }*/ else {
                $data->where(function ($query) {
                    $query->where('ipd_registers.discharge_status', 0)
                        ->orWhere(function ($q) {
                            $q->where('ipd_registers.discharge_status', 1)
                                ->whereDate('ipd_registers.discharge_at', \Carbon\Carbon::today());
                        });
                });
                $data->orderBy('ipd_registers.id', 'DESC');
            }

            // dd($data->toSql());

            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('patient', function ($row) {
                    $patientBtn = '<a href="' . route('hr.patient-profile-details', ed($row->patient_id, true)) . '" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important" data-original-title="Click here for patient details">
                    ' . $row->patient_name . ' (' . $row->patient_id . ')
                    <br>
                    <i class="fa fa-venus-mars text-blue"></i> ' . $row->gender . '
                    <i class="fa fa-calendar-plus-o text-blue ml-1"></i> ' . $row->dob_year . 'Y ' . $row->dob_month . 'M ' . $row->dob_day . 'D
                    <span class="badge badge-gradient-primary mt-2 ml-1">' . $row->type . '</span>
                </a><br>';
                    $patientBtn .= '<i class="fa fa-phone text-primary"></i> ' . $row->phone . '
                    <i class="fas fa-comment-dots mx-2"></i>
                </a>';
                    return $patientBtn;
                })
                ->addColumn('doctor', function ($row) {
                    $doctorBtn = '<i class="fa fa-user-md text-primary"></i> <b>Under Doct: </b> ' . $row->doctor_name;
                    if ($row->other_doctor_name) {
                        $doctorBtn .= '<br><i class="fa fa-user-md text-primary"></i> <b>Other Under Doct: </b> ' . $row->other_doctor_name;
                    }
                    return $doctorBtn;
                })
                ->addColumn('details', function ($row) {
                    $detailsBtn = '<i class="fa fa-calendar-alt text-primary"></i> <b>Adm Dt: </b>' . dateFor($row->admission_date, true) . ' <br>
                    <i class="fa fa-rainbow text-primary"></i> <b>Dept: </b> ' . $row->department_name . ' <br>
                    <i class="fa fa-circle text-primary"></i> <b>Package Type: </b> ' . $row->package_type . ' <br>
                    <i class="fas fa-clinic-medical text-primary"></i> <b>Patient Type: </b>' . $row->tpa_name;
                    if ($row->discharge_type) {
                        $detailsBtn .= '<br><i class="fa fa-calendar-alt text-primary"></i> <b> Dis Dt: </b>' . dateFor($row->discharge_at, true) . ' <br>
                    <i class="fa fa-cube text-primary"></i><b> Dis Status: </b> ' . $row->discharge_type;
                    }
                    return $detailsBtn;
                })
                ->addColumn('bed', function ($row) {
                    $bedBtn = '<i class="fa fa-bed"></i> <b>Bed:</b> ' . $row->bed_name . ' <br>
                    <i class="fas fa-yin-yang"></i> <b>Ward:</b> ' . $row->ward_name;
                    return $bedBtn;
                })
                ->addColumn('overall', function ($row) {
                    $overallBtn = ($row->overall_due > 0) ? '<span class="text-danger font-weight-bolder">Due : ₹' . $row->overall_due . '</span><br>' : '';
