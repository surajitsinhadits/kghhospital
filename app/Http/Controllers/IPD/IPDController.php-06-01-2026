    public function insert_discharge(Request $request, $section)
    {
        // dd($request->all(), $section);
        if($section == 'daycare') {
            $section = 'ipd';
        }
        $request->validate([
            'section_id' => 'required',
            'discharge_date' => 'required',
            'discharge_status' => 'required',
        ]);
        if($section == 'ipd'){
            $data = IpdRegister::find($request->section_id);
			$billStatus = Billing::where('section', $data->admission_type)->where('section_id', $request->section_id)->first();
        }elseif($section == 'dialysis'){
            $data = DialysisRegister::find($request->section_id);
			$billStatus = Billing::where('section', 'DIALYSIS')->where('section_id', $request->section_id)->first();
        }

        $request->upid ? $dischage = DischargeReport::find($request->upid) : $dischage = new DischargeReport();
        $path = public_path('assets/attachments/discharge_patient');
        if ($request->file('attach_document')) {
            $extension = $request->file('attach_document')->getClientOriginalExtension();
            $attach_document = 'discharge-document-' . uniqid() . '.' . $extension;
            $request->file('attach_document')->move($path, $attach_document);
        } else {
            $attach_document = $request->input('old_attach_document');
        }
        $dischage->section = strtoupper($section);
        $dischage->section_id = $request->section_id;
        $dischage->discharge_date = $request->discharge_date;
        $dischage->discharge_type = $request->discharge_status;
        $dischage->refferal_hospital_name = $request->refferal_hospital_name;
        $dischage->next_appointment_date = $request->next_appointment_date;
        $dischage->icd_code = $request->icd_code;
        $dischage->complaiints_duraiton = $request->complaiints_duraiton;
        $dischage->presenting_illness = $request->presenting_illness;
        $dischage->physical_examinaiton_at_admission = $request->physical_examinaiton_at_admission;
        $dischage->summary_inves_during_hos = $request->summary_inves_during_hos;
        $dischage->course_complications = $request->course_complications;
        $dischage->dischage_advice = $request->dischage_advice;
        $dischage->attach_document = $attach_document;
        $dischage->save_type = $request->save_type;
        if ($dischage->save()) {
            if ($request->save_type == '2') {
                if($billStatus->bill_status == 2){
                    $data->discharge_status = 1;
                    $data->discharge_by = Auth::user()->id;
                    $data->discharge_at = date('Y-m-d H:i:s');
                    $data->save();

                    Bed::where('id', $data->bed_id)->update(['is_used' => 'no']);
                    PatientBedHistory::where('patient_id', $data->patient_id)
                        ->where('bed_id', $data->bed_id)
                        ->latest('id')
                        ->limit(1)
                        ->update(['to_date' => now()]);

                    return redirect()->back()->with('success', 'Discharged Sucessfully');
                }else{
                    return redirect()->back()->with('error', 'Please Approve Bill then Discharge');
                }
            } else {
                return redirect()->back()->with('success', 'Discharge Report Saved Sucessfully');
            }
        } else {
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
    }

