    public function update_surgery(Request $request, $id)
    {
        // dd($request->all());
        if ($request->status == 'scheduled') {
            $request->validate([
                'planning_date' => 'required',
                'doctor' => 'required',
                'eye' => 'required',
                'surgery_type' => 'required',
                'diagnosis' => 'required',
                'priority' => 'required',
                'schedule_date' => 'required',
                'schedule_form_time' => 'required',
                'schedule_to_time' => 'required',
                'package_id'        => 'required',
            ]);
        } else {
            $request->validate([
                'planning_date' => 'required',
                'doctor' => 'required',
                'eye' => 'required',
                'surgery_type' => 'required',
                'diagnosis' => 'required',
                'priority' => 'required',
            ]);
        }

        DB::beginTransaction();
        try {
            $path = public_path('assets/images/SurgeryConsent');
            if ($request->file('consent_file')) {
                $consent_file = "consent-file-" . time() . "." . $request->file('consent_file')->getClientOriginalExtension();
                $request->file('consent_file')->move($path, $consent_file);
            } else {
                $consent_file = null;
            }

            $data = OpSurgeryCase::find($id);
            $data->doctor_id = $request->doctor;
            $data->dept_id = $request->department;
            $data->package_id = $request->package_id;
            $data->planning_date = date('Y-m-d', strtotime($request->planning_date));
            $data->eye = $request->eye;
            $data->surgery_type = $request->surgery_type;
            $data->diagnosis = $request->diagnosis;
            $data->priority = $request->priority;
            if ($consent_file) {
                $data->consent_file = $consent_file;
            }
            $data->status = $request->status;
            if ($request->status == 'scheduled') {
                $data->schedule_date = date('Y-m-d', strtotime($request->schedule_date));
                $data->schedule_form_time = date('H:i:s', strtotime($request->schedule_form_time));
                $data->schedule_to_time = date('H:i:s', strtotime($request->schedule_to_time));
                $data->schedule_by = Auth::user()->id;
                $data->schedule_at = date('Y-m-d H:i:s');
            }
            $data->save();

            DB::commit();
            if ($request->submit == 'ot') {
                // Redirect to OT Module
                $Operation = OtPackage::where('id', $request->package_id)->first();
                $ot = new OtRegistration();
                $ot->patient_id = $data->patient_id;
                // $ot->ipd_id = $request->ipd_id;
                $ot->cons_doc = $data->doctor_id;
                $ot->planned_date = $request->schedule_date ? date('Y-m-d H:i', strtotime($request->schedule_date)) : date('Y-m-d H:i:s');
                $ot->package_id = $request->package_id;
                $ot->operation_name = $Operation->package_name;
                $ot->department_id = $data->dept_id;
                $ot->amount = $Operation->package_amount;
                $ot->optical_surgery_id = $data->id;
                $ot->status = 'Planned';
                $ot->register_by = Auth::user()->id;
                $ot->save();
                $ot_reg_id = $ot->id;
                $packageDetails = OtPackageDetail::where('package_id', $request->package_id)->get();
                foreach ($packageDetails as $detail) {
                    $charge = Charge::select('charges.*', 'cc.charges_catagories_name')
                        ->join('charges_catagories as cc', 'cc.id', '=', 'charges.sub_category_id')
                        ->where('charges.id', $detail->charge_id)
                        ->first();
                    if ($charge) {
                        $ot_package_detail = new OtRegPackageDetail();
                        $ot_package_detail->ot_reg_id = $ot_reg_id;
                        $ot_package_detail->ot_package_id = $request->package_id;
                        $ot_package_detail->charge_id = $detail->charge_id;
                        $ot_package_detail->charge_name = $charge->charge_name;
                        $ot_package_detail->rate = $detail->rate;
                        $ot_package_detail->save();
                    }
                }
                return redirect()->route('ot.ot-info', ['id' => ed($ot_reg_id, true)])->with('success', 'Operation Request updated successfully.');
            }
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        return redirect()->route('optical.surgery-planning')->with('success', 'Eye Surgery Registration Sucessfully');
    }

