    public function surgery_planning(Request $request)
    {
        $doctor = User::where('user_type', 'doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        if ($request->ajax()) {
            $data = OpSurgeryCase::select(
                'op_surgery_cases.*',
                'u1.salutation as bs',
                'u1.name as booking_name',
                'u2.salutation as ds',
                'u2.name as doctor_name',
                'p.name as patient_name',
                'p.dob_year',
                'p.phone',
            )
                ->leftJoin('users as u1', 'u1.id', '=', 'op_surgery_cases.generated_by')
                ->leftJoin('users as u2', 'u2.id', '=', 'op_surgery_cases.doctor_id')
                ->leftJoin('patients as p', 'p.id', '=', 'op_surgery_cases.patient_id')
                ->where('op_surgery_cases.is_delete', '0');

            // Filter based on field_name and field_value
            if (!empty($request->field_name) && !empty($request->field_value)) {
                if ($request->field_name === 'op_surgery_cases.doctor_id') {
                    $data->where('op_surgery_cases.doctor_id', $request->field_value);
                } else {
                    $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                }
            }

            // Filter by date range
            if (!empty($request->from_date)) {
                $data->whereDate('op_surgery_cases.planning_date', '>=', date('Y-m-d', strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $data->whereDate('op_surgery_cases.planning_date', '<=', date('Y-m-d', strtotime($request->to_date)));
            }

            // Get the collection
            $collection = $data->get();

            // Sort using Carbon: date desc, time asc
            $sorted = $collection->sort(function ($a, $b) {
                $dateA = \Carbon\Carbon::parse($a->planning_date);
                $dateB = \Carbon\Carbon::parse($b->planning_date);

                // First, compare date descending
                if ($dateA->eq($dateB)) {
                    // If dates are equal, compare time ascending
                    $timeA = \Carbon\Carbon::parse($a->planning_date);
                    $timeB = \Carbon\Carbon::parse($b->planning_date);
                    return $timeA->greaterThan($timeB) ? 1 : ($timeA->lessThan($timeB) ? -1 : 0);
                }
                return $dateA->lessThan($dateB) ? 1 : -1; // Descending
            })->values(); // Re-index

            return Datatables::of($sorted)
                ->addIndexColumn()
                ->addColumn('action', function ($row) {
                    $actionBtn = '<a href="' . route('optical.surgery-planning-details', ed($row->id, true)) . '" class="btn btn-primary btn-sm mx-1" title="View"><i class="fa fa-eye"></i> View</a>';
                    return $actionBtn;
                })
                // ->addColumn('app_date', function($row){
                //     $date = \Carbon\Carbon::parse($row->appointment_date)->format('d-m-Y');
                //     $time = \Carbon\Carbon::parse($row->appointment_time)->format('h:i A');
                //     return $date . ' ' . $time;
                // })
                ->rawColumns(['action'])
                ->make(true);
        }
        $data = compact('doctor');
        return view('optical.surgery.surgery')->with($data);
    }

