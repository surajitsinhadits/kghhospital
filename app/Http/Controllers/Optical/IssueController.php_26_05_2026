    public function update_billing(Request $request, $id = 0)
    {

        $request->validate([
            'appointment_date' => 'required',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'required',
            'address' => 'required',
            'state' => 'required',
            'uhid' => 'nullable|exists:patients,id',
            'prescription' => 'nullable|mimes:jpg,jpeg,png,pdf|max:10000'
        ]);
        // dd($request);




        DB::beginTransaction();
        try {

            $prescription_filename = null;
            if( $request->hasFile('prescription')    ){

                $destinationPath = public_path('uploads/optical_patient_prescription');
                if (!file_exists($destinationPath)) {
                    mkdir($destinationPath, 0775, true); // create folder with permissions
                }

                $file = $request->file('prescription');
                $prescription_filename = time() . '_' . $file->getClientOriginalName();
                $file->move($destinationPath, $prescription_filename);

            }

            //SAVE in Patient
            $request->uhid ? $patient = Patient::find($request->uhid) : $patient = new Patient();
            $patient->name = ucwords($request->name);
            $patient->phone = $request->phone;
            $patient->gender = $request->gender;
            $patient->dob_year = $request->date_of_birth_year ?? 0;
            $patient->dob_month = $request->date_of_birth_month ?? 0;
            $patient->dob_day = $request->date_of_birth_day ?? 0;
            $patient->address = $request->address;
            $patient->state = $request->state;
            $patient->district = is_numeric($request->district) ? $request->district : null;
            $patient->pin_code = $request->pin_no;
            $patient->save();
            $patient_id = $patient->id;

            $op = new OpRegister();
            $op->department_id = $request->department;
            $op->patient_id = $patient_id;
            $op->status = $request->status;
            $op->prescription = $prescription_filename;
            $op->generate_by = Auth::user()->id;
            $op->type = $request->uhid ? 'old' : 'new';
            $op->appointment_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $op->save();
            $op_id = $op->id;

            //SAVE in Billing Section
            $bill = new Billing();
            $bill->uid = Billing::where('section', 'OP')->selectRaw('MAX(CAST(uid AS UNSIGNED)) as max_uid')->value('max_uid') + 1;
            $bill->section = 'OP';
            $bill->section_id = $op_id;
            $bill->bill_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $bill->patient_id = $patient_id;
            $bill->total = $request->total;
            $bill->sub_total = $request->total;
            $bill->discount_amount = $request->total - $request->grand_total;
            $bill->discount = $request->total_discount ?? 0;
            $bill->discount_type = $request->discount_type;
            $bill->discount_status = 'Approved';
            $bill->total_payment = $request->total_payment;
            if($request->grand_total > $request->total_payment){
                $bill->due_amount = $request->grand_total - $request->total_payment;
                $bill->bill_status = 1;
            }else{
                $bill->cradit_amount = $request->total_payment - $request->grand_total;
                $bill->bill_status = 2;
            }
            $bill->grand_total = $request->grand_total;
            $bill->status = 'Done';
            $bill->created_by = Auth::user()->id;
            $bill->save();
            $bill_id = $bill->id;

            //SAVE in Billing Details
            foreach ($request->item_name as $key => $value) {
                // op_items
                $item = OpItem::select('id','item_name')->where('id', $request->item_name[$key])->first();

                //optical_billing_details
                $bill_details =  new OpBillingDetail();
                $bill_details->billing_id = $bill_id;
                $bill_details->date = $request->appointment_date ? date('Y-m-d H:i', strtotime($request->appointment_date)) : date('Y-m-d H:i:s');
                $bill_details->item_id = $item->id;
                $bill_details->item_name = $item->item_name;
                $bill_details->standard_charges = $request->rate[$key];
                $bill_details->discount_percentage = $request->discount_in_per[$key];
                $bill_details->discount_amount = $request->discount_amount[$key];
                $bill_details->qty = $request->qty[$key];
                $bill_details->amount = $request->amount[$key];
                $bill_details->save();
            }

            //SAVE in Payment
            if (count($request->payment_amount) > 0) {
                foreach($request->payment_amount as $key => $value){

                    if($request->payment_amount[$key] > 0){

                        $payment = new Payment();
                        $payment->billing_id = $bill_id;
                        $payment->patient_id = $patient_id;
                        $payment->section = 'OP';
                        $payment->section_id = $op_id;
                        $payment->payment_amount = $request->payment_amount[$key];
                        $payment->payment_mode = $request->payment_mode[$key];
                        $payment->payment_bank = $request->payment_mode[$key] == 'Cash' ? null : $request->bank_name;
                        $payment->payment_recived_by = Auth::user()->id;
                        $payment->payment_date = date('Y-m-d H:i');
                        $payment->save();

                    }
                }
            }

            DB::commit();
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        if($request->submit == 'close'){
            return redirect()->route('optical.optical-billing')->with('success', 'Optical Registration Sucessfully');
        }else{
            return redirect()->route('optical.add-billing')->with('success', 'Optical Registration Sucessfully');
        }
    }

    // Eye Examination
    public function eye_examination(Request $request)
    {
        $doctor = User::where('user_type', 'doctor')->where('is_active', 1)->where('is_delete', 0)->get();

        if ($request->ajax()) {

            $data = OpEnquiry::select(
                    'op_enquiries.*',
                    'u1.salutation as bs',
                    'u1.name as booking_name',
                    'u2.salutation as ds',
                    'u2.name as doctor_name',
                    'b.id as billing_id'
                )
                ->leftJoin('op_registers as reg', function ($join) {
                    $join->on('op_enquiries.id', '=', 'reg.enquiry_id')->where('op_enquiries.is_register', '=', '1');
                })
                ->leftJoin('billings as b', function ($join) {
                    $join->on('b.section_id', '=', 'reg.id')
                         ->where('b.section', '=', 'OP');
                })
                ->join('users as u1', 'u1.id', '=', 'op_enquiries.booking_by')
                ->join('users as u2', 'u2.id', '=', 'op_enquiries.doctor_id')
                ->where('op_enquiries.is_delete', '0')
                ->orderBy('op_enquiries.id', 'DESC');

            // Filter based on field_name and field_value
            /*if (!empty($request->field_name) && !empty($request->field_value)) {
                if ($request->field_name === 'op_enquiries.doctor_id') {
                    $data->where('op_enquiries.doctor_id', $request->select_value);
                } else {
                    $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                }
            }*/

            if (!empty($request->field_name) && !empty($request->field_value)) {
                $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
            } else if ($request->field_name === 'op_enquiries.doctor_id') {
                $data->where('op_enquiries.doctor_id', $request->select_value);
            }

            // Filter by date range
            if (!empty($request->from_date)) {
                $data->whereDate('op_enquiries.appointment_date', '>=', date('Y-m-d', strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $data->whereDate('op_enquiries.appointment_date', '<=', date('Y-m-d', strtotime($request->to_date)));
            }

            // Get the collection
            $collection = $data->get();

            // Sort using Carbon: date desc, time asc
            $sorted = $collection->sort(function ($a, $b) {
                $dateA = \Carbon\Carbon::parse($a->appointment_date);
                $dateB = \Carbon\Carbon::parse($b->appointment_date);

                // First, compare date descending
                if ($dateA->eq($dateB)) {
                    // If dates are equal, compare time ascending
                    $timeA = \Carbon\Carbon::parse($a->appointment_time);
                    $timeB = \Carbon\Carbon::parse($b->appointment_time);
                    return $timeA->greaterThan($timeB) ? 1 : ($timeA->lessThan($timeB) ? -1 : 0);
                }
                return $dateA->lessThan($dateB) ? 1 : -1; // Descending
            })->values(); // Re-index

            return Datatables::of($sorted)
                ->addIndexColumn()
                ->addColumn('action', function ($row) {
                    if ($row->is_register) {
                        $actionBtn = '<a href="' . route('bill.billing-details', ['op', ed($row->billing_id, true)]) . '" class="btn btn-success btn-sm mx-1" title="View"><i class="fa fa-eye"></i> View</a>';
                    } else {
                        $actionBtn = '<a href="' . route('optical.eye-exam-info', ed($row->id, true)) . '" class="btn btn-primary btn-sm mx-1" title="Register"><i class="fa fa-file"></i> Register</a>';
                        $actionBtn .= '<a onclick="return confirm(\'Are you sure you want to delete this optical enquiry!\')" href="' . route('optical.delete-eye-exam', ed($row->id, true)) . '" class="btn btn-sm btn-danger mx-1" title="Delete"><i class="bx bxs-trash"></i></a>';
                    }
                    return $actionBtn;
                })
                ->addColumn('app_date', function ($row) {
                    $date = \Carbon\Carbon::parse($row->appointment_date)->format('d-m-Y');
                    $time = \Carbon\Carbon::parse($row->appointment_time)->format('h:i A');
                    return $date . ' ' . $time;
                })
                ->rawColumns(['action', 'app_date'])
                ->make(true);
        }
        $data = compact('doctor');
        return view('optical.issue.appointments')->with($data);
    }

