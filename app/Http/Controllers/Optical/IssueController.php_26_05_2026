    public function optical_billing(Request $request)
    {
        if ($request->ajax()) {
            $data = OpRegister::select(
                'op_registers.id', 'p.id as patient_id', 'p.name as patient_name',
                'p.gender', 'p.dob_year', 'p.dob_month', 'p.dob_day', 'p.phone', 'p.address', 
                'b.id as billing_id', 'b.total_payment', 'b.due_amount', 'b.bill_date',
                'op_registers.status', 'b.bill_status'
            )
                ->join('patients  as p', 'p.id', '=', 'op_registers.patient_id')
                ->join('billings  as b', 'b.section_id', '=', 'op_registers.id')
                ->where('b.section', 'OP')
                ->where('op_registers.is_active', 1)
                ->where('op_registers.is_delete', 0)
                ->where('op_registers.enquiry_id', 0)
                ->orderBy('op_registers.id', 'DESC');

            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('patient', function ($row) {
                    $patientBtn = '<a href="' . route('hr.patient-profile-details', ed($row->patient_id, true)) . '" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important" data-original-title="Click here for patient details">
                    ' . $row->patient_name . ' (' . $row->patient_id . ')
                    <br>
                    <i class="fa fa-venus-mars text-blue"></i> ' . $row->gender . '
                    <i class="fa fa-calendar-plus-o text-blue ml-1"></i> ' . $row->dob_year . 'Y ' . $row->dob_month . 'M ' . $row->dob_day . 'D
                    <br><i class="fa fa-phone text-primary"></i> ' . $row->phone . '
                </a>';
                    return $patientBtn;
                })
                ->addColumn('bill_date', function ($row) {
                    return date('d-m-Y h:i A', strtotime($row->bill_date));
                })
                ->addColumn('bill_amount', function ($row) {
                    return '<span>Total Payment: ' . $row->total_payment . '</span><br><span>Due Amount: ' . $row->due_amount . '</span>';
                })
                ->addColumn('action', function($row){
                    $actionBtn = '<a href="'.route('bill.billing-details', ['op', ed($row->billing_id, true)]).'" class="btn btn-primary btn-sm mx-1" title="Click here to show bill details"><i class="fa fa-eye"></i> View</a>';
                    return $actionBtn;
                })
                ->addColumn('color_status', function($row){
                    if($row->bill_status == 3){
                        return 5;
                    }else{
                        if($row->due_amount > 0){
                            return 1;
                        } else{
                            if($row->status >= 3){
                               return $row->status;
                            }elseif($row->status < 3){
                                return 2;
                            }
                        }
                    }
                })
                ->rawColumns(['action', 'patient', 'bill_date', 'bill_amount','color_status'])
                ->make(true);
        }
        return view('optical.issue.issue-list');
    }

