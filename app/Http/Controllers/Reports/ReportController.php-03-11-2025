            $genderTypeTotals = (clone $cloned)
                ->select(
                    DB::raw("SUM(CASE WHEN p.gender = 'Male' THEN 1 ELSE 0 END) as male"),
                    DB::raw("SUM(CASE WHEN p.gender = 'Female' THEN 1 ELSE 0 END) as female")
                )
                ->first();

            // Datatable
            $datatable = Datatables::of($baseQuery->orderBy('discharge_reports.id', 'DESC'))
                ->addIndexColumn()
                ->addColumn('adm_date', function ($row) {
                    $dateBtn = dateFor($row->admission_date, true);
                    return $dateBtn;
                })
                ->addColumn('dis_date', function ($row) {
                    $dateBtn = dateFor($row->discharge_date, true);
                    return $dateBtn;
                })
                ->rawColumns(['adm_date', 'dis_date']);

            return $datatable->with([
                'totals' => [
                    'gender' => [(int)$genderTypeTotals->male, (int)$genderTypeTotals->female],
                ],
                'totalsByDoctor' => $totalsByDoctor
            ])->make(true);
        }
        return view('reports.death');
    }

    public function discharge_report(Request $request)
    {
        if ($request->ajax()) {
            $baseQuery = DischargeReport::select('discharge_reports.section_id', 'ir.admission_date', 'discharge_reports.discharge_date', 'discharge_reports.discharge_type', 'p.name as patient_name', 'p.gender', 'ir.patient_id','bill.uid','bill.id as bill_id')
                ->join('ipd_registers as ir', 'ir.id', '=', 'discharge_reports.section_id')
                ->join('billings as bill', 'bill.section_id', '=', 'discharge_reports.section_id')
                ->join('patients as p', 'p.id', '=', 'ir.patient_id')
                ->where('discharge_reports.save_type', '2')
                ->where('bill.section', 'IPD')
                ->where('ir.is_active', '1')
                ->where('ir.is_delete', '0');

            // Filter by data
            if (!empty($request->discharge_status)) {
                $baseQuery->where('discharge_reports.discharge_type', $request->discharge_status);
            }
            if (!empty($request->from_date)) {
                $baseQuery->whereDate('discharge_reports.discharge_date', '>=', date('Y-m-d', strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $baseQuery->whereDate('discharge_reports.discharge_date', '<=', date('Y-m-d', strtotime($request->to_date)));
            }

            // Clone once for reuse
            $cloned = (clone $baseQuery);

            // Totals grouped by delivery mode
            $totalsByType = (clone $cloned)
                ->select(
                    'discharge_reports.discharge_type',
                    DB::raw("COUNT(discharge_reports.id) as total_count")
                )
                ->groupBy('discharge_reports.discharge_type')
                ->get();

            // All totals in one DB query instead of 8 separate ones
            $genderTypeTotals = (clone $cloned)
                ->select(
                    DB::raw("SUM(CASE WHEN p.gender = 'Male' THEN 1 ELSE 0 END) as male"),
                    DB::raw("SUM(CASE WHEN p.gender = 'Female' THEN 1 ELSE 0 END) as female")
                )
                ->first();

            // Datatable
            $datatable = Datatables::of($baseQuery->orderBy('discharge_reports.id', 'DESC'))
                ->addIndexColumn()
                ->addColumn('adm_date', function ($row) {
                    $dateBtn = dateFor($row->admission_date, true);
                    return $dateBtn;
                })
                ->addColumn('dis_date', function ($row) {
                    $dateBtn = dateFor($row->discharge_date, true);
                    return $dateBtn;
                })
                ->addColumn('billBtn', function ($row) {
                    $billBtn = '<a href="' . route('bill.billing-details', ['ipd', ed($row->bill_id, true)]) . '">'.$row->uid.'</a>';
                    return $billBtn;
                })
                ->rawColumns(['adm_date', 'dis_date','billBtn']);

            return $datatable->with([
                'totals' => [
                    'gender' => [(int)$genderTypeTotals->male, (int)$genderTypeTotals->female],
                ],
                'totalsByType' => $totalsByType
            ])->make(true);
        }
        return view('reports.discharge');
    }
