    public function bill_reports(Request $request)
    {
        if ($request->ajax()) {
            $query = $this->buildBillReportQuery($request);

            return \DataTables::of($query)
                ->addIndexColumn()
                ->addColumn('patient', function ($row) {
                    return sprintf(
                        '<a href="%s" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important">
                        %s<br>
                        <i class="fa fa-venus-mars text-blue"></i> %s
                        <i class="fa fa-calendar-plus-o text-blue ml-1"></i> %sY %sM %sD
                    </a>',
                        route('hr.patient-profile-details', ed($row->patient_id, true)),
                        e(strtoupper($row->patient_name) . ' (' . $row->patient_id . ')'),
                        e($row->gender),
                        e($row->dob_year),
                        e($row->dob_month),
                        e($row->dob_day)
                    );
                })
                ->addColumn('billing', function ($row) {
                    $status = $row->bill_status == 3
                        ? '<span class="badge badge-danger">Cancel</span>'
                        : '<span class="badge badge-success">Done</span>';
                    return '<a href="'.route('bill.billing-details', [$row->section == 'DAYCARE' ? 'ipd' :strtolower($row->section), ed($row->id, true)]).'">'.$row->uid.'</a>' . '<br>' . $status;
                })
                ->addColumn('cre_date', function ($row) {
                    return dateFor($row->bill_date, true);
                })
                ->addColumn('payment', function ($row) {
                    $lines = [
                        '<span>Total : ' . e($row->grand_total) . '</span>',
                        '<br><span>Payment : ' . e($row->total_payment) . '</span>',
                    ];
                    if ($row->due_amount > 0) {
                        $lines[] = '<br><span>Due : ' . e($row->due_amount) . '</span>';
                    }
                    if ($row->refund_amount > 0) {
                        $lines[] = '<br><span>Refund : ' . e($row->refund_amount) . '</span>';
                    }
                    return implode('', $lines);
                })
                ->addColumn('action', function ($row) {
                    $detailsUrl = route('bill.billing-details', [$row->section == 'DAYCARE' ? 'ipd' : strtolower($row->section), ed($row->id, true)]);
                    $printUrl = route('bill.print-bill', [$row->section, ed($row->id, true)]);
                    return sprintf(
                        '<a href="%s" class="mx-2" target="_blank" data-placement="left" data-toggle="tooltip" title="Click here to show bill details"><i class="fa fa-eye"></i></a>
                     <a href="%s" class="mx-2" target="_blank" data-placement="left" data-toggle="tooltip" title="Print Bill"><i class="fa fa-print"></i></a>',
                        $detailsUrl,
                        $printUrl
                    );
                })
                ->rawColumns(['action', 'cre_date', 'patient', 'payment', 'billing'])
                ->make(true);
        }

        return view('reports.bill');
    }

    public function bill_export(Request $request, string $format)
    {
        $format = strtolower($format);
        if (!in_array($format, ['pdf', 'excel'])) {
            abort(404);
        }

        $records = $this->buildBillReportQuery($request)->get();

        $filters = [
            'field_name' => $request->field_name,
            'field_value' => $request->field_value,
            'select_value' => $request->select_value,
            'from_date' => $request->from_date,
            'to_date' => $request->to_date,
        ];

        $fromDateString = $request->from_date ?: Carbon::now()->format('d-m-Y');
        $toDateString = $request->to_date ?: Carbon::now()->format('d-m-Y');

        try {
            $fromForFilename = Carbon::createFromFormat('d-m-Y', $fromDateString)->format('Ymd');
        } catch (\Exception $e) {
            $fromForFilename = Carbon::now()->format('Ymd');
        }
        try {
            $toForFilename = Carbon::createFromFormat('d-m-Y', $toDateString)->format('Ymd');
        } catch (\Exception $e) {
            $toForFilename = Carbon::now()->format('Ymd');
        }

        $filename = "bill-list-{$fromForFilename}-{$toForFilename}";

        $viewData = [
            'records' => $records,
            'filters' => $filters,
        ];

        if ($format === 'pdf') {
            $pdf = Pdf::loadView('reports.bill-export', $viewData);
            return $pdf->download("{$filename}.pdf");
        }

        $content = view('reports.bill-export', $viewData)->render();
        return response($content, 200, [
            'Content-Type' => 'application/vnd.ms-excel; charset=UTF-8',
            'Content-Disposition' => "attachment; filename=\"{$filename}.xls\"",
        ]);
    }

    private function buildBillReportQuery(Request $request)
    {
        $query = DB::table('billings')
            ->select([
                'billings.id',
                'billings.uid',
                'billings.section',
                'billings.bill_date',
                'billings.patient_id',
                'billings.grand_total',
                'billings.total_payment',
                'billings.due_amount',
                'billings.refund_amount',
                'billings.bill_status',
                'u.name as created_name',
                'p.name as patient_name',
                'p.phone',
                'p.gender',
                'p.dob_year',
                'p.dob_month',
                'p.dob_day',
            ])
            ->join('users as u', 'u.id', '=', 'billings.created_by')
            ->join('patients as p', 'p.id', '=', 'billings.patient_id');

        if ($request->filled('field_name') && ($request->filled('field_value') || $request->filled('select_value'))) {
            if ($request->field_name === 'billings.section') {
                $query->where('billings.section', $request->select_value);
            } else {
                $query->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
            }
        }

        if ($request->filled('from_date')) {
            $query->whereDate('billings.bill_date', '>=', date('Y-m-d', strtotime($request->from_date)));
        }
        if ($request->filled('to_date')) {
            $query->whereDate('billings.bill_date', '<=', date('Y-m-d', strtotime($request->to_date)));
        }

        return $query->orderByDesc('billings.id');
    }

