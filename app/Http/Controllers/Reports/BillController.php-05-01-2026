    private function buildRefundReportQuery(Request $request)
    {
        $query = Billing::select('billings.*', 'u.name as refund_name', 'p.name as patient_name', 'p.phone', 'pca.id as refund_id')
            ->join('users as u', 'u.id', '=', 'billings.refund_by')
            ->join('patients as p', 'p.id', '=', 'billings.patient_id')
            ->join('patient_cradit_amounts as pca', 'pca.billing_id', '=', 'billings.id')
            ->where('billings.refund_amount', '>', 0)
            ->where('pca.type', 'debit')
            ->where('pca.remarks', 'refund')
            ->orderBy('pca.id', 'DESC');

        if ($request->filled('field_name') && $request->filled('field_value')) {
            if ($request->field_name === 'billings.section') {
                $query->where('billings.section', $request->field_value);
            } else {
                $query->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
            }
        }

        if ($request->filled('from_date')) {
            $query->whereDate('billings.refund_at', '>=', date('Y-m-d', strtotime($request->from_date)));
        }
        if ($request->filled('to_date')) {
            $query->whereDate('billings.refund_at', '<=', date('Y-m-d', strtotime($request->to_date)));
        }

        return $query;
    }

    public function billing_reports(Request $request){

    // Dropdown data
    $charges    = Charge::select('id', 'charge_name')->where('is_active', 1)->where('is_delete', 0)->get();
    $category   = ChargesCatagory::where('parent_id', '0')->where('status', '0')->get();
    $subcategory= ChargesCatagory::where('parent_id', '!=', '0')->where('status', '0')->get();
    $section    = ChargesSection::where('status', '0')->get();
    $users      = User::where('user_type', 'user')->get();
    $doctor     = User::where('user_type', 'doctor')->where('is_active', 1)->where('is_delete', 0)->get();
    $referral   = Referral::where('type', 'referral')->where('is_active', 1)->where('is_delete', 0)->get();
    $provider   = Referral::where('type', 'provider')->where('is_active', 1)->where('is_delete', 0)->get();
    $market_by  = Referral::where('type', 'market_by')->where('is_active', 1)->where('is_delete', 0)->get();

    if ($request->ajax()) {

        $baseQuery = DB::table('billings')
            ->join('patients as p', 'p.id', '=', 'billings.patient_id')
            ->leftJoin('users as u', 'u.id', '=', 'billings.doctor_id')
            ->leftJoin('users as u1', 'u1.id', '=', 'billings.created_by')
            ->leftJoin('referrals as r1', 'r1.id', '=', 'billings.referred_by')
            ->leftJoin('referrals as r2', 'r2.id', '=', 'billings.market_by')
            ->leftJoin('referrals as r3', 'r3.id', '=', 'billings.provider')
            ->where('billings.is_delete', 0);

        // ✅ Charge filters without joining billing_details (avoid duplicates)
        $needBillingDetails = !empty($request->charge) || !empty($request->charge_category) || !empty($request->charge_sub_category);
        if ($needBillingDetails) {
            $baseQuery->whereExists(function ($q) use ($request) {
                $q->select(DB::raw(1))
                    ->from('billing_details as bi')
                    ->whereColumn('bi.billing_id', 'billings.id')
                    ->where('bi.is_delete', 0);

                if (!empty($request->charge)) {
                    $q->whereIn('bi.charge_id', (array) $request->charge);
                }
                if (!empty($request->charge_category)) {
                    $q->whereIn('bi.charge_category_id', (array) $request->charge_category);
                }
                if (!empty($request->charge_sub_category)) {
                    $q->whereIn('bi.charge_sub_category_id', (array) $request->charge_sub_category);
                }
            });
        }

        // Filters
        if (!empty($request->section_name)) {
            $baseQuery->where('billings.section', $request->section_name);
        }
        if (!empty($request->user)) {
            $baseQuery->whereIn('billings.created_by', (array)$request->user);
        }
        if (!empty($request->doctor)) {
            $baseQuery->whereIn('billings.doctor_id', (array)$request->doctor);
        }
        if (!empty($request->doctor_type)) {
            $baseQuery->where('u.doctor_type', $request->doctor_type);
        }

        if (!empty($request->payment)) {
            switch ($request->payment) {
                case 'FP':
                    $baseQuery->where('billings.due_amount', '=', 0);
                    break;
                case 'PP':
                    $baseQuery->where('billings.due_amount', '>', 0)
                        ->where('billings.total_payment', '>', 0);
                    break;
                case 'FD':
                    $baseQuery->where('billings.total_payment', '=', 0);
                    break;
            }
        }

        if (!empty($request->discount) && $request->discount_amount !== null && $request->discount_amount !== '') {
            if ($request->discount === 'G') {
                $baseQuery->where('billings.discount_amount', '>=', $request->discount_amount);
            }
            if ($request->discount === 'L') {
                $baseQuery->where('billings.discount_amount', '<=', $request->discount_amount);
            }
        }

        if (!empty($request->referral)) {
            $baseQuery->whereIn('billings.referred_by', (array)$request->referral);
        }
        if (!empty($request->market_by)) {
            $baseQuery->whereIn('billings.market_by', (array)$request->market_by);
        }
        if (!empty($request->provider)) {
            $baseQuery->whereIn('billings.provider', (array)$request->provider);
        }

        if (!empty($request->from_date)) {
            $baseQuery->whereDate('billings.bill_date', '>=', date('Y-m-d', strtotime($request->from_date)));
        }
        if (!empty($request->to_date)) {
            $baseQuery->whereDate('billings.bill_date', '<=', date('Y-m-d', strtotime($request->to_date)));
        }

        // ✅ Summary (clone AFTER all filters)
        $summaryQuery = clone $baseQuery;
        $billingSummary = $summaryQuery
            ->select(
                'billings.section',
                DB::raw('SUM(billings.total) as total'),
                DB::raw('SUM(billings.discount_amount) as discount_amount'),
                DB::raw('SUM(billings.grand_total) as grand_total'),
                DB::raw('SUM(billings.total_payment) as total_payment'),
                DB::raw('SUM(billings.due_amount) as due_amount')
            )
            ->groupBy('billings.section')
            ->get();

        // Data table main query
        $data = $baseQuery
            ->select(
                'billings.id',
                'billings.uid',
                'billings.section',
                'billings.bill_date',
                'billings.patient_id',
                'p.name as patient_name',
                'p.phone',
                'u.name as doctor_name',
                'u1.name as generated_by',
                'billings.total',
                'billings.grand_total',
                'billings.discount_amount',
                'billings.total_payment',
                'billings.refund_amount',
                'billings.due_amount',
                'billings.cradituse_bill_amount',
                'r1.referral_name as ref_by',
                'r2.referral_name as mar_by',
                'r3.referral_name as pro_by',
                'billings.bill_status'
            )
            ->orderBy('billings.id', 'DESC');

        // ✅ No dd(). If you want debug:
        // \Log::info('Billing SQL', ['sql'=>$data->toSql(), 'bindings'=>$data->getBindings()]);

        $datatable = Datatables::of($data)
            ->addIndexColumn()
            ->addColumn('cre_date', function ($row) {
                return dateFor($row->bill_date, true);
            })
            ->addColumn('billId', function ($row) {
                $link = route('bill.billing-details', [$row->section == 'DAYCARE' ? 'ipd' : strtolower($row->section), ed($row->id, true)]);
                return '<a href="' . $link . '">' . $row->uid . '</a> <span class="badge badge-gradient-primary ml-2">' . $row->section . '</span>';
            })
            ->addColumn('ref_section', function ($row) {
                $amountBtn = '';
                if ($row->due_amount > 0) {
                    $amountBtn .= '<span>DUE : ' . array_sum(explode("_", trim($row->due_amount, "_"))) . '</span><br>';
                }
                if ($row->refund_amount > 0) {
