    private function buildReceiptReportQuery(Request $request)
    {
        $query = Payment::select('payments.*', 'u.name as created_name', 'p.name as patient_name', 'p.phone')
            ->join('users as u', 'u.id', '=', 'payments.payment_recived_by')
            ->join('patients as p', 'p.id', '=', 'payments.patient_id')
            ->orderBy('payments.id', 'DESC');

        if ($request->filled('field_name') && $request->filled('field_value')) {
            if ($request->field_name === 'payments.section') {
                $query->where('payments.section', $request->field_value);
            } else {
                $query->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
            }
        }

        if ($request->filled('from_date')) {
            $query->whereDate('payments.created_at', '>=', date('Y-m-d', strtotime($request->from_date)));
        }
        if ($request->filled('to_date')) {
            $query->whereDate('payments.created_at', '<=', date('Y-m-d', strtotime($request->to_date)));
        }

        return $query;
    }

