    public function collection(Request $request)
    {
        $result = $dateArray = $request_data = [];
        $title = 'Collection';
        $action = route('reports.collection');
        $users = User::select('id', 'empId', 'salutation', 'name')->where('user_type', 'user')->get();

        if ($request->isMethod('post')) {
