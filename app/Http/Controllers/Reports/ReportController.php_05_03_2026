    public function hospital_stay(Request $request)
{
    $from = $request->filled('from_date') ? Carbon::parse($request->from_date)->format('Y-m-d') : null;
    $to   = $request->filled('to_date') ? Carbon::parse($request->to_date)->format('Y-m-d') : null;

    // normalize section so switch matches always
    $activeSection = $request->filled('section') ? strtolower(trim($request->input('section'))) : null;

    $sectionCounts = [];

    if ($from && $to) {

        $opdCount = OpdRegister::query()
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->whereDate('appointment_date', '>=', $from)
            ->whereDate('appointment_date', '<=', $to)
            ->count();

        $emgCount = EmgRegister::query()
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->whereDate('appointment_date', '>=', $from)
            ->whereDate('appointment_date', '<=', $to)
            ->count();

        // OVERLAP logic (admission <= to AND (discharge is null OR discharge >= from))
        $ipdBaseCounts = IpdRegister::query()
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->whereDate('admission_date', '<=', $to)
            ->where(function ($q) use ($from) {
                $q->whereNull('discharge_at')
                  ->orWhereDate('discharge_at', '>=', $from);
            });

        $ipdAdmissionCount = (clone $ipdBaseCounts)->where('admission_type', 'IPD')->count();
        $daycareCount      = (clone $ipdBaseCounts)->where('admission_type', 'DAYCARE')->count();

        $dialysisCount = DialysisRegister::query()
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->whereDate('admission_date', '<=', $to)
            ->where(function ($q) use ($from) {
                $q->whereNull('discharge_at')
                  ->orWhereDate('discharge_at', '>=', $from);
            })
            ->count();

        $investigationCount = InvestigationRegister::query()
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->whereDate('appointment_date', '>=', $from)
            ->whereDate('appointment_date', '<=', $to)
            ->count();

        $sectionCounts = [
            'opd'           => $opdCount,
            'emg'           => $emgCount,
            'ipd'           => $ipdAdmissionCount,
            'daycare'       => $daycareCount,
            'dialysis'      => $dialysisCount,
            'investigation' => $investigationCount,
        ];
    }

    $patientList = ($from && $to && $activeSection)
        ? $this->loadHospitalStayPatients($activeSection, $from, $to)
        : collect();

    return view('reports.hospitalStay', compact('sectionCounts', 'activeSection', 'patientList'));
}

private function applyDateRange($q, string $column, string $from, string $to)
{
    return $q->whereDate($column, '>=', $from)
             ->whereDate($column, '<=', $to);
}

// ✅ FIXED: admission <= to AND (discharge IS NULL OR discharge >= from)
private function applyStayOverlap($q, string $admissionCol, string $dischargeCol, string $from, string $to)
{
    return $q->whereDate($admissionCol, '<=', $to)
             ->where(function ($qq) use ($dischargeCol, $from) {
                 $qq->whereNull($dischargeCol)
                    ->orWhereDate($dischargeCol, '>=', $from);
             });
}

private function loadHospitalStayPatients(string $section, string $from, string $to)
{
    $section = strtolower(trim($section));

    switch ($section) {
        case 'opd':
            return $this->applyDateRange(
                    OpdRegister::query()
                        ->select([
                            'opd_registers.id as section_id',
                            'p.id as patient_id',
                            'p.name as patient_name',
                            'u.name as doctor_name',
                            'd.department_name',
                            'opd_registers.appointment_date as record_date',
                            DB::raw("'OPD' as section_name")
                        ])
                        ->join('patients as p', 'p.id', '=', 'opd_registers.patient_id')
                        ->join('users as u', 'u.id', '=', 'opd_registers.doctor_id')
                        ->leftJoin('departments as d', 'd.id', '=', 'opd_registers.department_id')
                        ->where('opd_registers.is_active', 1)
                        ->where('opd_registers.is_delete', 0),
                    'opd_registers.appointment_date',
                    $from,
                    $to
                )
                ->orderByDesc('opd_registers.appointment_date')
                ->limit(200)
                ->get();

        case 'emg':
            return $this->applyDateRange(
                    EmgRegister::query()
                        ->select([
                            'emg_registers.id as section_id',
                            'p.id as patient_id',
                            'p.name as patient_name',
                            'u.name as doctor_name',
                            'd.department_name',
                            'emg_registers.appointment_date as record_date',
                            DB::raw("'EMG' as section_name")
                        ])
                        ->join('patients as p', 'p.id', '=', 'emg_registers.patient_id')
                        ->join('users as u', 'u.id', '=', 'emg_registers.doctor_id')
                        ->leftJoin('departments as d', 'd.id', '=', 'emg_registers.department_id')
                        ->where('emg_registers.is_active', 1)
                        ->where('emg_registers.is_delete', 0),
                    'emg_registers.appointment_date',
                    $from,
                    $to
                )
                ->orderByDesc('emg_registers.appointment_date')
                ->limit(200)
                ->get();

        case 'ipd':
        case 'daycare':
            $admissionType = strtoupper($section);

            return $this->applyStayOverlap(
                    IpdRegister::query()
                        ->select([
                            'ipd_registers.id as section_id',
                            'p.id as patient_id',
                            'p.name as patient_name',
                            'u.name as doctor_name',
                            'd.department_name',
                            'ipd_registers.admission_date as record_date',
                            'ipd_registers.discharge_at',
                            'ipd_registers.admission_type as section_name'
                        ])
                        ->join('patients as p', 'p.id', '=', 'ipd_registers.patient_id')
                        ->join('users as u', 'u.id', '=', 'ipd_registers.doctor_id')
                        ->join('departments as d', 'd.id', '=', 'ipd_registers.department_id')
                        ->where('ipd_registers.is_active', 1)
                        ->where('ipd_registers.is_delete', 0)
                        ->where('ipd_registers.admission_type', $admissionType),
                    'ipd_registers.admission_date',
                    'ipd_registers.discharge_at',
                    $from,
                    $to
                )
                ->orderByDesc('ipd_registers.admission_date')
                ->limit(200)
                ->get();

        case 'dialysis':
            return $this->applyStayOverlap(
                    DialysisRegister::query()
                        ->select([
                            'dialysis_registers.id as section_id',
                            'p.id as patient_id',
                            'p.name as patient_name',
                            'u.name as doctor_name',
                            'd.department_name',
                            'dialysis_registers.admission_date as record_date',
                            'dialysis_registers.discharge_at',
                            'dialysis_registers.dialysis_type as section_name'
                        ])
                        ->join('patients as p', 'p.id', '=', 'dialysis_registers.patient_id')
                        ->join('users as u', 'u.id', '=', 'dialysis_registers.doctor_id')
                        ->leftJoin('departments as d', 'd.id', '=', 'dialysis_registers.department_id')
                        ->where('dialysis_registers.is_active', 1)
                        ->where('dialysis_registers.is_delete', 0),
                    'dialysis_registers.admission_date',
                    'dialysis_registers.discharge_at',
                    $from,
                    $to
                )
                ->orderByDesc('dialysis_registers.admission_date')
                ->limit(200)
                ->get();

        case 'investigation':
            return InvestigationRegister::query()
                ->select([
                    'investigation_registers.id as section_id',
                    'investigation_registers.patient_id as patient_id',
                    DB::raw("COALESCE(p.name, 'N/A') as patient_name"),
                    DB::raw("COALESCE(u.name, 'N/A') as doctor_name"),
                    'd.department_name',
                    'investigation_registers.appointment_date as record_date',
                    DB::raw('NULL as discharge_at'),
                    'investigation_registers.type as section_name'
                ])
                ->leftJoin('patients as p', 'p.id', '=', 'investigation_registers.patient_id')
                ->leftJoin('users as u', 'u.id', '=', 'investigation_registers.doctor_id')
                ->leftJoin('departments as d', 'd.id', '=', 'investigation_registers.department_id')
                ->where('investigation_registers.is_active', 1)
                ->where('investigation_registers.is_delete', 0)
                ->whereDate('investigation_registers.appointment_date', '>=', $from)
                ->whereDate('investigation_registers.appointment_date', '<=', $to)
                ->orderByDesc('investigation_registers.appointment_date')
                ->limit(200)
                ->get();

        default:
            return collect();
    }
}

