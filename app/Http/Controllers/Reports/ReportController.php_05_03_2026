    private function buildOpdReportQuery(Request $request)
    {
        $query = OpdRegister::query()
            ->select(
                'opd_registers.id',
                'opd_registers.patient_id',
                'opd_registers.type',
                'opd_registers.appointment_date',
                'p.name as patient_name',
                'p.phone',
                'p.gender',
                'p.dob_year',
                'p.dob_month',
                'p.dob_day',
                'u.name as doctor_name',
                'd.department_name'
            )
            ->join('users as u', 'u.id', '=', 'opd_registers.doctor_id')
            ->join('departments as d', 'd.id', '=', 'opd_registers.department_id')
            ->join('patients as p', 'p.id', '=', 'opd_registers.patient_id')
            ->where('opd_registers.is_active', 1)
            ->where('opd_registers.is_delete', 0);

        return $this->applyOpdFilters($query, $request);
    }

    private function applyOpdFilters($query, Request $request)
    {
        $filterMap = [
            'visit_type' => 'type',
            'department' => 'department_id',
            'doctor' => 'doctor_id',
            'referral' => 'referred_by',
            'market_by' => 'market_by',
            'provider' => 'provider',
            'opd_type' => 'opd_type',
        ];
        foreach ($filterMap as $input => $column) {
            if ($value = $request->input($input)) {
                $query->where("opd_registers.$column", $value);
            }
        }
        if ($request->filled('from_date')) {
            $query->whereDate('opd_registers.appointment_date', '>=', date('Y-m-d', strtotime($request->from_date)));
        }
        if ($request->filled('to_date')) {
            $query->whereDate('opd_registers.appointment_date', '<=', date('Y-m-d', strtotime($request->to_date)));
        }
        return $query;
    }

    private function ensureOpdDateRange(Request $request)
    {
        if (!$request->filled('from_date') && !$request->filled('to_date')) {
            $request->merge([
                'from_date' => now()->subMonths(6)->format('Y-m-d'),
                'to_date' => now()->format('Y-m-d'),
            ]);
        }
    }

