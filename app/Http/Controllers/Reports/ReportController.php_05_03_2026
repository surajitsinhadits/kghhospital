    public function admission_report(Request $request)
    {
        if ($request->ajax()) {

            // dd($request->all());

            $baseQuery = IpdRegister::query()
                ->select([
                    'ipd_registers.id',
                    'bill.section_id',
                    'ipd_registers.admission_date',
                    'ipd_registers.discharge_at',
                    'p.name as patient_name',
                    'p.gender',
                    'ipd_registers.patient_id',
                    'bill.uid',
                    'bill.id as bill_id',
                    'u.name as doctor_name',
                    'ipd_registers.type',
                    'ipd_registers.discharge_status',
                    DB::raw("CASE
                        WHEN ipd_registers.discharge_status = 1 AND ipd_registers.discharge_at IS NOT NULL
                        THEN DATEDIFF(DATE(ipd_registers.discharge_at), DATE(ipd_registers.admission_date)) + 1
                        ELSE NULL
                    END as stay_days")
                ])
                ->join('billings as bill', 'bill.section_id', '=', 'ipd_registers.id')
                ->join('patients as p', 'p.id', '=', 'ipd_registers.patient_id')
                ->join('users as u', 'u.id', '=', 'ipd_registers.doctor_id')
                ->whereIn('bill.section', ['DAYCARE', 'IPD'])
                ->where('ipd_registers.is_active', '1')
                ->where('ipd_registers.is_delete', '0');

            $from = $request->from_date ? date('Y-m-d', strtotime($request->from_date)) : null;
            $to   = $request->to_date ? date('Y-m-d', strtotime($request->to_date)) : null;

            if ((int) $request->patient_status === 2) {

                $baseQuery->where(function ($q) use ($from) {

                    // ✅ 1) Not discharged => admission_date <= searched date
                    $q->where(function ($q1) use ($from) {
                        $q1->where('ipd_registers.discharge_status', 0)
                        ->whereDate('ipd_registers.admission_date', '<=', $from);
                    });

                    // ✅ 2) Discharged => searched date between admission_date and discharge_at
                    $q->orWhere(function ($q2) use ($from) {
                        $q2->where('ipd_registers.discharge_status', 1)
                        ->whereNotNull('ipd_registers.discharge_at')
                        ->whereDate('ipd_registers.admission_date', '<=', $from)
                        ->whereDate('ipd_registers.discharge_at', '>=', $from);
                    });

                });

            } else {
                // Admission => single day (or same logic)
                if (!empty($request->from_date)) {
                    $baseQuery->whereDate('ipd_registers.admission_date', '>=', $from);
                }
                if (!empty($request->to_date)) {
                    $baseQuery->whereDate('ipd_registers.admission_date', '<=', $to);
                }
            }

            // dd($baseQuery->toSql(), $baseQuery->getBindings());

            return DataTables::of($baseQuery->orderBy('ipd_registers.id', 'DESC'))
                ->addIndexColumn()
                ->addColumn('adm_date', function ($row) {
                    return dateFor($row->admission_date, true);
                })
                ->addColumn('dis_date', function ($row) {
                    return dateFor($row->discharge_at, true);
                })
                ->addColumn('billBtn', function ($row) {
