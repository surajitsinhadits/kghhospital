    function latestRegisterSub(string $table, string $alias, string $idCol = 'id', string $patientCol = 'patient_id') {
        // subquery to get latest id per patient (change MAX(id) to MAX(created_at) if preferred)
        $latest = DB::table($table)
            ->select($patientCol, DB::raw("MAX($idCol) as latest_id"))
            ->groupBy($patientCol);

        // join that latest back to table and return a query usable in leftJoinSub
        return DB::table("{$table} as {$alias}")
                ->joinSub($latest, "l_{$alias}", function($join) use ($alias, $patientCol, $idCol) {
                    $join->on("{$alias}.{$patientCol}", "=", "l_{$alias}.{$patientCol}")
                        ->on("{$alias}.{$idCol}", "=", "l_{$alias}.latest_id");
                })
                ->select(
                    "{$alias}.{$patientCol} as patient_id",
                    "{$alias}.market_by",
                    "{$alias}.provider",
                    "{$alias}.referred_by"
                );
    }

