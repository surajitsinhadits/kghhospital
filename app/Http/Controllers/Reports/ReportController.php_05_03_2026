                'b.uid',
                'b.patient_id',
                'b.bill_date',
                'b.section',
                'b.total',
                'b.sub_total',
                'p.name as patient_name',
            ];
            if (!empty($marketByIds)) {
                $selects[] = DB::raw(
                    "CASE WHEN dr.market_by IN (" . implode(',', $marketByIds) . ") THEN dr.market_by
                          WHEN er.market_by IN (" . implode(',', $marketByIds) . ") THEN er.market_by
                          WHEN ir.market_by IN (" . implode(',', $marketByIds) . ") THEN ir.market_by
                          WHEN ipr.market_by IN (" . implode(',', $marketByIds) . ") THEN ipr.market_by
                          WHEN opr.market_by IN (" . implode(',', $marketByIds) . ") THEN opr.market_by
                          ELSE 0 END as market_by_id"
                );
            } else {
                $selects[] = DB::raw('0 as market_by_id');
            }
            if (!empty($providerIds)) {
                $selects[] = DB::raw(
                    "CASE WHEN dr.provider IN (" . implode(',', $providerIds) . ") THEN dr.provider
                          WHEN er.provider IN (" . implode(',', $providerIds) . ") THEN er.provider
                          WHEN ir.provider IN (" . implode(',', $providerIds) . ") THEN ir.provider
                          WHEN ipr.provider IN (" . implode(',', $providerIds) . ") THEN ipr.provider
                          WHEN opr.provider IN (" . implode(',', $providerIds) . ") THEN opr.provider
                          ELSE 0 END as provider_id"
                );
            } else {
                $selects[] = DB::raw('0 as provider_id');
            }
            if (!empty($referredByIds)) {
                $selects[] = DB::raw(
                    "CASE WHEN dr.referred_by IN (" . implode(',', $referredByIds) . ") THEN dr.referred_by
                          WHEN er.referred_by IN (" . implode(',', $referredByIds) . ") THEN er.referred_by
                          WHEN ir.referred_by IN (" . implode(',', $referredByIds) . ") THEN ir.referred_by
                          WHEN ipr.referred_by IN (" . implode(',', $referredByIds) . ") THEN ipr.referred_by
                          WHEN opr.referred_by IN (" . implode(',', $referredByIds) . ") THEN opr.referred_by
                          ELSE 0 END as referred_by_id"
                );
            } else {
                $selects[] = DB::raw('0 as referred_by_id');
            }

            $response = $query->select($selects)->get();
        }

        $viewData = compact('title', 'market_by', 'provider', 'referral', 'request_data', 'response');

        $fromForFilename = Carbon::parse($request_data['from_date'])->format('Ymd');
        $toForFilename = Carbon::parse($request_data['to_date'])->format('Ymd');
        $filename = "commission-report-{$fromForFilename}-{$toForFilename}";

        if ($format === 'pdf') {
            $pdf = Pdf::loadView('reports.commission-report-export', $viewData);
            return $pdf->download("{$filename}.pdf");
        }

        $content = view('reports.commission-report-export', $viewData)->render();
        return response($content, 200, [
            'Content-Type' => 'application/vnd.ms-excel; charset=UTF-8',
            'Content-Disposition' => "attachment; filename=\"{$filename}.xls\"",
        ]);
    }

