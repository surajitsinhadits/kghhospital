                ->join('patients as p', 'p.id', '=', 'ipd_registers.patient_id')
                ->join('wards as w', 'w.id', '=', 'ipd_registers.ward_id')
                ->join('beds as b', 'b.id', '=', 'ipd_registers.bed_id')
