                ],
                'totalsByDept' => $totalsByDept,
                'totalsByTpa' => $totalsByTpa
            ])->make(true);
        }
        $data = compact('department', 'doctor', 'referral', 'provider', 'market_by', 'tpa', 'wards', 'charges');
        return view('reports.ipd')->with($data);
