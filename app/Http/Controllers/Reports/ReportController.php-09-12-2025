    public function commission_discount(Request $request){

        // dd($request->all());

        $n = count($request->charge_id);
        $uid = Auth::user()->id;

        DB::beginTransaction();
        try {

            $insertId = DB::table('charge_commission_masters')->insertGetId([
                'bill_id'                 => (int) $request->bill_id,
                'patient_id'              => (int) $request->patient_id,
                'referred_by'             => $request->type === 'referred_by' ? (int) $request->type_id : 0,
                'market_by'               => $request->type === 'market_by'   ? (int) $request->type_id : 0,
                'provider'                => $request->type === 'provider'    ? (int) $request->type_id : 0,
                'created_by'              => (int) $uid,
                'commission_total_amount' => (string) $request->commission_total_amount
            ]);

            $rows = [];
            for ($i = 0; $i < $n; $i++) {
                $rows[] = [
                    'charge_commission_master_id'       => $insertId,
                    'charge_id'                         => (int) ($request->charge_id[$i] ?? 0),
                    'charge_amount'                     => (float) ($request->total_amount[$i] ?? 0),
                    'discount'                          => $request->discount[$i],
                    'discount_amount'                   => (float) ($request->discount_amount[$i] ?? 0),
                ];
            }

            // Save in one go
            DB::table('charge_commission')->insert($rows);

        DB::commit();
        } catch (Exception $e) {
            DB::rollback();
        }

        return response()->json(['status' => 1, 'message' => 'OK', 'count' => count($rows)]);

    }

