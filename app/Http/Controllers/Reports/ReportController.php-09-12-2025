                ->where('ipd_registers.is_active', '1')
                ->where('ipd_registers.is_delete', '0');

            // Apply filters
            foreach (['visit_type' => 'type', 'admission' => 'discharge_status', 'admission_type' => 'admission_type', 'patient_type' => 'insurance_id', 'ward' => 'ward_id', 'department' => 'department_id', 'doctor' => 'doctor_id', 'referral' => 'referred_by', 'market_by' => 'market_by', 'provider' => 'provider'] as $input => $column) {
                if (!empty($request->$input)) {
                    $baseQuery->where("ipd_registers.$column", $request->$input);
                }
            }
            if (!empty($request->charge) && count($request->charge) > 0) {
                $baseQuery->join('billings as bill', function ($join) {
                    $join->on('bill.section_id', '=', 'ipd_registers.id')
                        ->where('bill.section', '=', 'IPD');
                })
                    ->join('billing_details as bd', 'bd.billing_id', '=', 'bill.id')
                    ->whereIn('bd.charge_id', $request->charge);
            }
            if (!empty($request->from_date)) {
                $baseQuery->whereDate('ipd_registers.admission_date', '>=', date('Y-m-d', strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $baseQuery->whereDate('ipd_registers.admission_date', '<=', date('Y-m-d', strtotime($request->to_date)));
