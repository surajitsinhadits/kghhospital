    public function commission_patient_charge(Request $request){

        $bill_id = $request->bill_id;
        $user_type = $request->user_type;
        $type_id = $request->type_id;

        if( $user_type == 'referred_by' ){
            $user_type = 'b.referred_by';
        } else if( $user_type == 'market_by' ){
            $user_type = 'b.market_by';
        } else{
            $user_type = 'b.provider';
        }

        $rows = DB::table('billing_details as bd')
                ->join('billings as b', 'b.id', '=', 'bd.billing_id')
                ->join('charges as c', 'c.id', '=', 'bd.charge_id')
                ->where('bd.billing_id', $bill_id)
                ->where($user_type, $type_id)
                // ->whereIn('bd.charge_category_id', [10,11,12])
                ->whereIn('bd.is_delete', [0,1])
                ->select(['bd.billing_id', 'c.charge_name', 'bd.amount', 'b.patient_id', 'c.id as charge_id'])
                ->get();

        if( $rows->count() > 0 ){
            return response()->json([
                'status'  => 'success',
                'message' => 'Data retrieved successfully',
                'data'    => $rows
            ]);
        } else {
            return response()->json([
                'status'  => 'fail',
                'message' => 'No Data found!'
            ]);
        }

    }

    public function commission_discount(Request $request){

        $n = count($request->bill_id);
        $uid = Auth::user()->id;
        $now = now();


        $rows = [];
        for ($i = 0; $i < $n; $i++) {
            $rows[] = [
                'bill_id'         => (int) ($request->bill_id[$i] ?? 0),
                'patient_id'      => (int) ($request->patient_id[$i] ?? 0),
                'charge_id'       => (int) ($request->charge_id[$i] ?? 0),
                'referred_by'     => ($request->type[$i] == 'referred_by') ? $request->type_id[$i] : null,
                'market_by'       => ($request->type[$i] == 'market_by') ? $request->type_id[$i] : null,
                'provider'        => ($request->type[$i] == 'provider') ? $request->type_id[$i] : null,
                'charge_amount'   => (float) ($request->total_amount[$i] ?? 0),
                'discount'        => $request->discount[$i],
                'discount_amount' => (float) ($request->discount_amount[$i] ?? 0),
                'created_by'      => $uid
            ];
        }

        // Save in one go
        DB::table('charge_commission')->insert($rows);

        return response()->json(['status' => 1, 'message' => 'OK', 'count' => count($rows)]);

    }

