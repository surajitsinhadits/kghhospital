    public function update_patient_details(Request $request)
    {
        // dd($request);
        $request->validate([
            'name' => 'required',
            'gender' => 'required',
            'dob_year' => 'required|numeric',
            'dob_month' => 'nullable|numeric',
            'dob_day' => 'nullable|numeric',
            'phone' => 'required|digits:10',
            'address' => 'required',
            'state' => 'required',
            'district' => 'required'
        ]);
        $patient = Patient::find($request->uhid);
        $patient->name = ucwords($request->name);
        $patient->phone = $request->phone;
        $patient->gender = $request->gender;
        $patient->guardian_name = $request->guardian_name;
        $patient->guardian_contact_no = $request->guardian_contact_no;
        $patient->dob_year = $request->dob_year;
        $patient->dob_month = $request->dob_month;
        $patient->dob_day = $request->dob_day;
        $patient->address = $request->address;
        $patient->state = $request->state;
        $patient->district = $request->district;
        $patient->pin_code = $request->pin_code;
        $patient->identification_name = 'Aadhar Card';
        $patient->identification_number = $request->identification_number;
        $patient->save();
        return redirect()->route('hr.patient-list')->with('success', 'Patient Updated Sucessfully');
    }
    public function patient_list(Request $request)
    {
        if ($request->ajax()) {
            $data = Patient::select(
                'patients.*',
                's.name as state_name',
                'd.name as district_name',
                DB::raw('(SELECT SUM(due_amount) FROM billings WHERE billings.patient_id = patients.id) as total_due')
            )
                ->leftjoin('districts as d', 'd.id', '=', 'patients.district')
                ->leftjoin('states as s', 's.id', '=', 'patients.state')
                ->orderBy('patients.id', 'DESC');

            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('address', function ($row) {
                    $district = $row->district_name ?? 'N/A';
                    $state = $row->state_name ?? 'N/A';
                    return "{$row->address}, {$district},<br>{$state},";
                })
                ->addColumn('action', function ($row) {
                    $actionBtn = '<a href="' . route('hr.patient-edit-details', ed($row->id, true)) . '" class="btn btn-sm btn-outline-primary" title="Click here to Edit patient details"><i class="fa fa-edit"></i>Edit</a>';
                    return $actionBtn;
                })
                ->rawColumns(['action', 'address'])
                ->make(true);
        }
        return view('patient.patient_list');
    }
