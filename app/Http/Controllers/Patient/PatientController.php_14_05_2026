    public function global_pateint_bill_search(Request $request)
    {
        $uhid = trim($request->input('p_uhid'));
        $billNo = trim($request->input('bill_no'));

        if ($uhid && !$billNo) {
            return $this->searchByUhid($uhid);
        }

        if ($billNo && !$uhid) {
            return $this->searchByBillNo($billNo);
        }

        // If both or neither are filled
        return redirect()->back()->with('error', 'Please enter only one value — either UHID or Bill No.');
    }

    private function searchByUhid($uhid)
    {
        $patient = Patient::where('id', $uhid)->first();

        if (!$patient) {
            return redirect()->back()->with('error', 'No patient found with this UHID.');
        }

        // Redirect to the patient profile details route with patient ID
        return redirect()->route('hr.patient-profile-details', ['id' => ed($patient->id, 'encrypt')]);
    }

    private function searchByBillNo($billNo)
    {
        $bill = Billing::where('uid', $billNo)->first();

        if (!$bill) {
            return redirect()->back()->with('error', 'No bill found with this Bill No.');
        }

        return redirect()->route('bill.billing-details', ['section' => $bill->section, 'bill_id' => ed($bill->id, 'encrypt')]);
    }
}
