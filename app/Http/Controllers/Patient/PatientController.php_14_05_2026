    public function child_register_save(Request $request)
    {
        $request->validate([
            'name' => 'required|max:100',
            'gender' => 'required',
            'address' => 'required|max:255',
            'state' => 'required',
            'district' => 'required',
            'doctor_id' => 'required',
            'baby_status' => 'required'
        ]);

        $childcare = $request->id ? Childcare::find($request->id) : new Childcare();
        $childcare->name = ucwords(strtolower($request->name));
        $childcare->guardian_name = ucwords(strtolower($request->guardian_name));
        $childcare->blood_group = $request->blood_group;
        $childcare->gender = $request->gender;
        $childcare->date_of_birth = $request->date_of_birth ? date('Y-m-d H:i:s', strtotime($request->date_of_birth)) : null;
        $childcare->dob_year = $request->date_of_birth_year;
        $childcare->dob_month = $request->date_of_birth_month;
        $childcare->dob_day = $request->date_of_birth_day;
        $childcare->address = $request->address;
        $childcare->state = $request->state;
        $childcare->district = $request->district;
        $childcare->pin_code = $request->pin_code;
        $childcare->doctor_id = $request->doctor_id;
        $childcare->diagnosis = $request->diagnosis;
        $childcare->operation = $request->operation;
        $childcare->weight    = $request->weight;
        $childcare->baby_status = $request->baby_status;
        $childcare->delivery_mode = $request->delivery_mode;
        $childcare->admission_date = $request->admission_date ? date('Y-m-d H:i:s', strtotime($request->admission_date)) : null;
        $childcare->discharge_date = $request->discharge_date ? date('Y-m-d H:i:s', strtotime($request->discharge_date)) : null;
        $childcare->created_by = Auth::user()->id;

        if ($request->id) {
            $childcare->edit_by = Auth::user()->id;
            $childcare->edit_at = now();
        }

        if ($childcare->save()) {
            return redirect()->route('hr.child-list')->with('success', 'Childcare Registration Sucessfully');
        } else {
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
    }
