            $damage = StReturn::select('st_returns.*','d.department_name','v.vendor_name','rm.return_date','u.name as created_by','ui.unit','sui.unit as sub_unit')
                ->leftJoin('st_return_masters as rm','rm.id','=','st_returns.mas_id')
                ->leftJoin('st_departments as d','d.id','=','rm.dept_id')
                ->leftJoin('st_vendors as v','v.id','=','rm.vendor_id')
                ->leftJoin('st_items as i','i.id','=','st_returns.item_id')
                ->leftJoin('st_units as ui', 'ui.id', '=', 'i.unit_id')
                ->leftJoin('st_units as sui', 'sui.id', '=', 'i.sub_unit_id')
                ->leftJoin('users as u','u.id','=','rm.return_by')
                ->where('st_returns.item_id',$item_details->id)
                ->where('st_returns.status', 1)
                ->get();
            $batch_no = StStock::where('item_id', $item_details->id)
                ->distinct()
                ->pluck('part_no');
            $pasent_stock = [];
            foreach($batch_no as $item){
                $item_stock = DB::table('st_stocks')
                    ->where('item_id', $item_details->id)
                    ->where('part_no', $item)
                    ->selectRaw('
                        unit,
                        sub_unit,
                        exp_date,
                        unit_sub_no,
                        unit_rate,
                        SUM(present_qty) as present_qty,
                        SUM(unit_qty) as unit_qty,
                        SUM(sub_unit_qty) as sub_unit_qty
                    ')
                    ->groupBy('unit_sub_no','exp_date','unit','sub_unit','unit_rate')
                    ->first();

                // $item_issue = DB::table('st_issues')
                //     ->where('item_id', $item_details->id)
                //     ->where('part_no', $item)
                //     ->selectRaw('
                //         SUM(unit_qty) as unit_qty,
                //         SUM(sub_unit_qty) as sub_unit_qty
                //     ')
                //     ->first();

                $unit_sub_no = $item_stock->unit_sub_no;

                // $stock_unit = $item_stock->unit_qty ?? 0;
                // $stock_sub  = $item_stock->sub_unit_qty ?? 0;

                // $issue_unit = $item_issue->unit_qty ?? 0;
                // $issue_sub  = $item_issue->sub_unit_qty ?? 0;

                // Convert to total sub-units
                // $stock_total_sub = ($stock_unit * $unit_sub_no) + $stock_sub;
                // $issue_total_sub = ($issue_unit * $unit_sub_no) + $issue_sub;

                // Calculate remaining sub-units
                // $remaining_sub = max($stock_total_sub - $issue_total_sub, 0);
                $remaining_sub = $item_stock->present_qty;

                // Convert back to unit + sub-unit
                $present_unit = intdiv($remaining_sub, $unit_sub_no);
                $present_sub  = $remaining_sub % $unit_sub_no;

                $pasent_stock[] = [
                    'part_no' => $item,
                    'unit' => $item_stock->unit,
                    'sub_unit' => $item_stock->sub_unit,
                    'unit_qty' => $present_unit,
                    'sub_unit_qty' => $present_sub,
                    'rate' => $item_stock->unit_rate,
                    'exp_date' => dateFor($item_stock->exp_date),
                ];
            }
        }

        $data = compact('item_details','stocks','issues','damage','pasent_stock');
