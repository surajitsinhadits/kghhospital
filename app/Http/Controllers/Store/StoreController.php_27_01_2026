    public function update_item_type(Request $request, $id = 0)
    {
        if(!empty($id)){
            $request->validate([
                'type_name' => 'required|max:100|unique:st_item_types,type_name,' . $id,
            ]);
        }else{
            $request->validate([
                'type_name' => 'required|max:100|unique:st_item_types,type_name',
            ]);
        }

        $id ? $data = StItemType::find($id) : $data = new StItemType();
        $data->type_name = $request->type_name;
        if($data->save()){
            return redirect()->route('store.item-type')->with('success', 'Successfully Updated!');
        }else{
            return redirect()->route('store.item-type')->with('error', 'Something wrong try again!');
        }
    }
