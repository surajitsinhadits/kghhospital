    public function getUnitDetails(Request $request)
    {

        $item = StItem::where('st_items.id', $request->itemId)
        ->leftJoin('st_units as unit', 'st_items.unit_id', '=', 'unit.id')
        ->leftJoin('st_units as sub_unit', 'st_items.sub_unit_id', '=', 'sub_unit.id')
        ->select([
            'unit.unit as unit_name',
            'unit.id as unit_id',
            'sub_unit.unit as sub_unit_name',
            'sub_unit.id as sub_unit_id',
            'st_items.sub_unit_no'
        ])
        ->first();

        /* 29-10-2025 start department qty and total qty item wise */

        $department_issue = DB::table('st_issues as s')
                ->join('st_product_issue as pi', 'pi.id', '=', 's.issue_id')
                ->where('pi.department_id', $request->departmentId)
                ->where('s.item_id', $request->itemId)
                ->where('pi.status', 1)
                ->where('pi.is_delete', 0)
                ->selectRaw('
                    COALESCE(SUM(s.total_qty), 0)  AS total_qty,
                    COALESCE(SUM(s.return_qty), 0) AS return_qty,
                    COALESCE(SUM(s.total_qty) - SUM(s.return_qty), 0) AS net_qty
                ')
                ->first();

        $department_expense = DB::table('st_expense_items as ei')
            ->join('st_expenses as e', 'e.id', '=', 'ei.expense_id')
            ->where('e.dept_id', $request->departmentId)
            ->where('ei.item_id', $request->itemId)
            ->where('e.is_delete', 0)   // optional but recommended
            ->where('ei.is_delete', 0)  // optional but recommended
            // ->where('e.status', 1)    // uncomment if only approved expenses
            ->selectRaw('COALESCE(SUM(ei.unit_qty), 0) as qty')
            ->value('qty');  // returns a single number

        $usedQty = $department_issue->net_qty - $department_expense;
        $totalQty = DB::table('st_stocks')
            ->where('item_id', $request->itemId)
            ->selectRaw('SUM(COALESCE(present_qty,0) - COALESCE(return_qty,0)) AS total_qty')
            ->value('total_qty'); // single scalar

        /* 29-10-2025 end */

        if ($item) {
            return response()->json([
                'unit'          => $item->unit_name,
                'sub_unit'      => $item->sub_unit_name,
                'unit_id'       => $item->unit_id,
                'sub_unit_id'   => $item->sub_unit_id,
                'sub_unit_no'   => $item->sub_unit_no,
                'dept_unit'     => $usedQty,
                'total_unit'    => $totalQty
            ]);
        }

        return response()->json([
            'unit'          => '',
            'sub_unit'      => '',
            'unit_id'       => '',
            'sub_unit_id'   => '',
            'sub_unit_no'   => '',
            'dept_unit'     => '',
            'total_unit'    => ''
        ]);
    }
