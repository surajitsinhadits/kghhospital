    public function getProductDetails(Request $request)
    {
        // $item_stock = StStock::where('item_id', $request->itemId)
        //     ->where('part_no', $request->partNo)
        //     ->first();
        $item_stock = DB::table('st_stocks')
            ->where('item_id', $request->itemId)
            ->where('part_no', $request->partNo)
            ->where(function($query) {
                $query->whereDate('exp_date', '>=', now())
                    ->orWhereNull('exp_date');
            })
            ->selectRaw('
                unit,
                sub_unit,
                exp_date,
                unit_sub_no,
                SUM(unit_qty) as unit_qty,
                SUM(sub_unit_qty) as sub_unit_qty
            ')
            ->groupBy('unit_sub_no','exp_date','unit','sub_unit')
            ->first();
        // $item_issue = StIssue::where('item_id', $request->itemId)
        //     ->where('part_no', $request->partNo)
        //     ->first();
        $item_issue = DB::table('st_issues')
            ->where('item_id', $request->itemId)
            ->where('part_no', $request->partNo)
            ->selectRaw('
                SUM(unit_qty) as unit_qty,
                SUM(sub_unit_qty) as sub_unit_qty
            ')
            ->first();

        // Safely get units and sub-units or default to 0
        $unit_sub_no = $item_stock->unit_sub_no;

        $stock_unit = $item_stock->unit_qty ?? 0;
        $stock_sub  = $item_stock->sub_unit_qty ?? 0;

        $issue_unit = $item_issue->unit_qty ?? 0;
        $issue_sub  = $item_issue->sub_unit_qty ?? 0;

        // Convert to total sub-units
        $stock_total_sub = ($stock_unit * $unit_sub_no) + $stock_sub;
        $issue_total_sub = ($issue_unit * $unit_sub_no) + $issue_sub;

        // Calculate remaining sub-units
        $remaining_sub = max($stock_total_sub - $issue_total_sub, 0);

        // Convert back to unit + sub-unit
        $present_unit = intdiv($remaining_sub, $unit_sub_no);
        $present_sub  = $remaining_sub % $unit_sub_no;

        if($item_stock) {
            return response()->json([
                'unit' => $item_stock->unit,
                'sub_unit' => $item_stock->sub_unit,
                'unit_qty' => $present_unit,
                'sub_unit_qty' => $present_sub,
                'exp_date' => dateFor($item_stock->exp_date),
                'avi_qty' => $present_unit.' '.$item_stock->unit.' '.$present_sub.' '.$item_stock->sub_unit,
                'remaining' => $remaining_sub,
            ]);
        }else{
            return response()->json([
                'unit' => '',
                'sub_unit' => '',
                'unit_qty' => '',
                'sub_unit_qty' => '',
                'exp_date' => '',
                'avi_qty' => '',
                'remaining' => ''
            ]);
        }
    }

    public function getVendorPriceItemWise(Request $request){

        $item_id = $request->itemId;

        $results = DB::table('st_purchases AS t1')
            ->select(
                't1.date',
                't1.invoice_no',
                't3.vendor_name',
                't4.item_name',
                't2.unit_qty',
                't2.sub_unit_qty',
                't2.test_qty',
                't2.rate',
                't2.mrp',
                't2.net_amount',
                't2.discount_percentage',
                't2.discount_amount',
                't2.cgst',
                't2.sgst',
                't2.igst',
                't2.cgst_amount',
                't2.sgst_amount',
                't2.igst_amount',
                't2.amount'
            )
            ->join('st_purchase_details AS t2', 't1.id', '=', 't2.purchase_id')
            ->join('st_vendors AS t3', 't1.vendor_id', '=', 't3.id')
            ->join('st_items AS t4', 't2.item_id', '=', 't4.id')
            ->where('t2.item_id', $item_id)
            ->where('t1.is_delete', 0)
            ->where('t2.is_delete', 0)
            ->where('t3.is_delete', 0)
            ->limit(20)
            ->get();

        // echo '<pre>'; print_r($results); die;

        if( $results->count() > 0 ):
            return response()->json(['status' => 1, 'message' => 'success', 'data' => $results]);
        else:
            return response()->json(['status' => 0, 'message' => 'failed']);
        endif;

    }

