    public function getRequisitionItems(Request $request)
    {
        $requisitionIds = $request->requisition_ids;
        if( !empty($requisitionIds) ) {

            $items = DB::table('st_requisition_items as ri')
                ->join('st_items as i', 'i.id', '=', 'ri.item_id')
                ->join('st_units as u', 'u.id', '=', 'i.unit_id')
                ->join('st_units as u2', 'u2.id', '=', 'i.sub_unit_id')
                ->whereIn('ri.requisition_id', $requisitionIds)   // $requisitionIds = [1,2,3...]
                ->where('ri.is_delete', 0)
                ->selectRaw('
                    ri.item_id,
                    i.item_name,
                    i.unit_id,
                    i.sub_unit_id,
                    u.unit  as unit_name,
                    u2.unit as sub_unit_name,
                    i.sub_unit_no,
                    i.item_unit_price,
                    SUM(ri.unit_qty)     as unit_qty,
                    SUM(ri.sub_unit_qty) as sub_unit_qty,
                    GROUP_CONCAT(DISTINCT ri.requisition_id) as requisitions
                ')
                ->groupBy(
                    'ri.item_id',
                    'i.item_name',
                    'i.unit_id',
                    'i.sub_unit_id',
                    'u.unit',
                    'u2.unit',
                    'i.sub_unit_no',
                    'i.item_unit_price'
                )
                ->get();

            // dd($items);
            return response()->json([
                'status'    => true,
                'data'      =>  $items
            ]);
        } else {
            return response()->json(['status' => false, 'message' => 'Requisition not found']);
        }
    }

