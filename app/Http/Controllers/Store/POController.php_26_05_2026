    public function vendorPurchasedOrderItemsSave( Request $request, $id = 0 ){

        $request->validate([
            'item_price.*' => 'required|numeric|min:0',
        ]);

        $purchase_order_items = StPurchaseOrderItem::where('po_id', $request->po_id)->where('is_delete', 0)->get();
        // print_r($purchase_order_items);die;
        if( $purchase_order_items->count() > 0 ){

            $id ? $vendorPrice = StVendorPrice::find($id) : $vendorPrice = new StVendorPrice();
            $vendorPrice->po_id         = $request->po_id;
            $vendorPrice->total_price   = $request->total_price;
            $vendorPrice->vendor_id     = session('vendor_id');
            $vendorPrice->save();

            if( $id ){
                StVendorItemsPrice::where('vendor_price_id', $vendorPrice->id)->delete();
            }

            foreach( $purchase_order_items as $item ){

                $vendorItemsPrice = new StVendorItemsPrice();
                $vendorItemsPrice->item_id           = $item->item_id;
                $vendorItemsPrice->vendor_price_id   = $vendorPrice->id;
                $vendorItemsPrice->unit_price        = $request->input('item_price')[$item->id];
                $vendorItemsPrice->save();

            }

            return redirect()->route('vendor-dashboard')->with('success', 'Items saved successfully!');
        } else {
            return redirect()->route('vendor-purchased-order-items')->with('error', 'Someting wrong.');
        }

    }

