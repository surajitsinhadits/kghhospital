    public function update_purchase_order(Request $request, $id = 0, $type = '')
    {

        // dd($request->all());

        if( empty($type) || !empty($type) && $type == 'default' ){

            $request->validate([
                'po_date' => 'required',
                // 'vendor_id' => 'required',
            ]);
        }

        try {
            DB::beginTransaction();

            $po = $id ? StPurchaseOrder::find($id) : new StPurchaseOrder();

            if( empty($type) || !empty($type) && $type == 'default' ){

                $po->po_date = date('Y-m-d H:i:s', strtotime($request->po_date));
                $po->vendor_id = ($request->vendor_id) ? $request->vendor_id : 0;
                $po->requisition_ids = implode(',', $request->requisition_ids);

            }

            $po->note = $request->note;

            if($id){
                $po->edit_by = Auth::user()->id;
                $po->edit_at = date('Y-m-d h:i:s');
            }else{
                $po->generated_by = Auth::user()->id;
            }

            if( !empty($type) && $type == 'verify' ){
                $po->verified_by = Auth::id();
                $po->verified_at = now();
            }

            if( !empty($type) && $type == 'approve' ){
                $po->approved_by = Auth::id();
                $po->approved_at = now();
            }


            $po->status = $request->save_action;
            $po->save();
            $po_id = $po->id;

            $existingItemIds = StPurchaseOrderItem::where('po_id', $po_id)->pluck('id')->toArray();
            $submittedItemIds = $request->item_detail_id ?? [];
            $toDelete = array_diff($existingItemIds, $submittedItemIds);

            if (!empty($toDelete)) {
                StPurchaseOrderItem::whereIn('id', $toDelete)->update(['is_delete' => 1]);
            }

            $vendorState = StVendor::where('id', $request->vendor_id)->first(['state']);
            $settingState = Setting::where('id', 9)->first(['value']);

            foreach ($request->item_id as $key => $item_id) {

                if($request->unit_qty[$key] == 0 && $request->sub_unit_qty[$key] == 0){
                    DB::rollback();
                    return back()->with('error', 'Unit & Subunit both are not zero');
                }
                $item_detail_id = $request->item_detail_id[$key]?? '';

                $item = $item_detail_id ? StPurchaseOrderItem::find($item_detail_id) : new StPurchaseOrderItem();

                $item->po_id           = $po_id;
                $item->item_id         = $item_id;
                $item->unit_qty        = $request->unit_qty[$key];
                $item->unit_id         = $request->unit_id[$key];
                $item->unit_name       = $request->unit_name[$key];
                $item->sub_unit_qty    = $request->sub_unit_qty[$key];
                $item->sub_unit_id     = $request->sub_unit_id[$key];
                $item->sub_unit_name   = $request->sub_unit_name[$key];
                $item->present_qty     = $request->present_qty[$key] ?? 0;
                $item->rate            = $request->rate[$key];

                if( !empty($vendorState) && !empty($settingState) && $vendorState->state == $settingState->value ){
                    $item->cgst   = $request->gst[$key] ?? 0.00;
                    $item->sgst   = $request->gst[$key] ?? 0.00;
                } else{
                    $item->cgst   = 0.00;
                    $item->sgst   = 0.00;
                    $item->igst   = $request->gst[$key] ?? 0.00;
                }

                $item->discount  = $request->discount[$key] ?? 0.00;
                $item->total_price  = $request->total_price[$key] ?? 0.00;
                $item->save();
            }

            DB::commit();

            $route_name = 'store.listing-purchase-order';
            if( !empty($type) && $type == 'verify' ){
                $route_name = 'store.listing-purchase-order-verify';
            }elseif( !empty($type) && $type == 'approve' ){
                $route_name = 'store.listing-purchase-order-approved';
            }

            return redirect()->route($route_name)->with('success', 'Purchase Order Saved Successfully!');

        } catch (\Exception $e) {
            DB::rollback();
            return back()->with('error', 'Something went wrong. Try again!');
        }
    }

    public function delete_purchase_order($id, $type = '')
    {
        $id = ed($id, false);
        $data = StPurchaseOrder::where('id',$id)->first();
        if ($data) {
            $data->update([
                'is_delete' => 1
            ]);

            $route_name = 'store.listing-purchase-order';
            if( !empty($type) && $type == 'verify' ){
                $route_name = 'store.listing-purchase-order-verify';
            }

            return redirect()->route($route_name)->with('success', 'The Purchase Order Deleted Successfully');
        } else {
            return back()->with('error', "Something Went Wrong");
        }
    }

    public function get_po_details(Request $request)
    {
        $po_id = $request->po_id;
        $po = StPurchaseOrder::find($po_id);
        if ($po) {

            DB::statement("SET SESSION sql_mode = (SELECT REPLACE(@@sql_mode, 'ONLY_FULL_GROUP_BY', ''))");

            $items = StPurchaseOrderItem::select('st_purchase_order_items.*', 'st_items.item_name',
                'st_items.sub_unit_no', DB::raw('SUM(st_purchase_details.unit_qty) as sold_qty'))
                ->join('st_items', 'st_items.id', '=', 'st_purchase_order_items.item_id')

                ->leftJoin('st_purchases', 'st_purchases.po_id', '=', 'st_purchase_order_items.po_id')
                ->leftJoin('st_purchase_details', function ($join) {
                    $join->on('st_purchase_details.purchase_id', '=', 'st_purchases.id')
                        ->on('st_purchase_details.item_id', '=', 'st_purchase_order_items.item_id');
                })

                ->where('st_purchase_order_items.po_id', $po_id)
                ->where('st_purchase_order_items.is_delete', 0)
                ->groupBy('st_purchase_order_items.id')
                ->orderBy('st_purchases.po_id', 'desc')
                ->get();

            // dd($items);
            foreach( $items as $key => $item ){
                $items[$key]['unit_qty'] = ($items[$key]['unit_qty'] - ($item['sold_qty'] ?? 0));
            }

            return response()->json([
                'status' => true,
                'data' => [
                    'po_date' => date('Y-m-d', strtotime($po->po_date)),
                    'vendor_id' => $po->vendor_id,
                    'note' => $po->note,
                    'items' => $items
                ]
            ]);
        } else {
            return response()->json(['status' => false, 'message' => 'PO not found']);
        }
    }

