    public function getLowLevelItems(){

        $itemIds = StStock::select('item_id')->distinct('item_id')->pluck('item_id');
        $items = StItem::select('st_items.*','u1.unit','u2.unit as sub_unit')
            ->join('st_units as u1','u1.id','=','st_items.unit_id')
            ->join('st_units as u2','u2.id','=','st_items.sub_unit_id')
            ->whereIn('st_items.id', $itemIds)
            ->where('st_items.is_delete', 0)
            ->get();

        $allItems = [];
        $stocks = StStock::get();
        foreach($items as $key => $item){

            if( $key == 20 ) break;

            $unit_sub_no = $item->sub_unit_no;
            $remaining_sub = $stocks->where('item_id', $item->id)->sum('present_qty') ?? 0;
            $remaining_unit = intdiv($remaining_sub, $unit_sub_no);
            $remaining_sub_unit = $remaining_sub % $unit_sub_no;

            $record = DB::table('st_purchase_orders as po')
                ->join('st_purchase_order_items as poi', 'po.id', '=', 'poi.po_id')
                ->where('po.status', '!=', 3)
                ->where('po.is_delete', 0)
                ->where('poi.is_delete', 0)
                ->where('poi.item_id', $item->id)
                ->first();

            if( $remaining_unit < $item->low_level ){

                $allItems[] = [
                    'id'                => $item->id,
                    'item_name'         => $item->item_name,
                    'item_unit_price'   => $item->item_unit_price,
                    'low_level'         => $item->low_level,
                    'unit'              => $item->unit,
                    'sub_unit'          => $item->sub_unit,
                    'unit_qty'          => $remaining_unit,
                    'sub_unit_qty'      => $remaining_sub_unit,
                    'total_qty'         => $remaining_sub,
                    'unit_sub_no'       => $unit_sub_no,
                    'unit_id'           => $item->unit_id,
                    'sub_unit_id'       => $item->sub_unit_id,
                    'is_exist_in_po'   => $record ? 1 : 0,
                ];

            }

        }

        if( !empty($allItems) ){
            return response()->json(['status' => true, 'data' => $allItems]);
        } else {
            return response()->json(['status' => false, 'message' => 'No low level items found.']);
        }

    }

