    public function update_return(Request $request, $id = 0)
    {
        $request->validate([
            'date' => 'required',
            'issue_id' => 'required',
            'issue_id.*' => 'required',
            'part_no.*' => 'required',
        ]);
        try {
            DB::beginTransaction();

            $return = $id ? StReturnMaster::find($id) : new StReturnMaster();
            $return->return_type = $request->return_type;
            $return->return_date = date('Y-m-d H:i:s',strtotime($request->date));
            $return->remarks = $request->remarks;
            if($id){
                $return->edit_by = Auth::user()->id;
                $return->edit_at = date('Y-m-d h:i:s');
            }else{
                $return->return_by = Auth::user()->id;
            }
            if($request->return_type == 'vendor'){
                $return->vendor_id = $request->vendor_id;
                $return->status = 1;
            }else{
                $return->dept_id = $request->dept_id;
                $return->status = $request->save == 'Save' ? 0 : ($request->save == 'Reject' ? 2 : 1);
            }
            $return->save();
            $return_id = $return->id;

            if (!empty($request->uppid) && is_array($request->uppid)) {
                StReturn::where('mas_id', $return_id)
                    ->whereNotIn('id', $request->uppid)
                    ->update(['status' => 2]);
            }

            foreach ($request->issue_id as $key => $items) {
                if($request->return_type == 'store'){
                    $get_issue = StIssue::where('id', $request->issue_id[$key])->first();
                }else{
                    $get_issue = StStock::where('id', $request->issue_id[$key])->first();
                }
                $unit_sub_no = optional(StStock::where('item_id', $get_issue->item_id)->where('part_no', $request->part_no[$key])->first())->unit_sub_no;
                $return_qty = ($request->unit_qty[$key] * $unit_sub_no) + $request->sub_unit_qty[$key];

                $sub_total = ($get_issue->unit_rate / $unit_sub_no) * $return_qty;
                $cgst = $sub_total * ($get_issue->cgst / 100);
                $sgst = $sub_total * ($get_issue->sgst / 100);
                $igst = $sub_total * ($get_issue->igst / 100);
                $total = $sub_total + $cgst + $sgst + $igst;

                if(@$request->uppid[$key]){
                    $return_details = StReturn::find($request->uppid[$key]);
                }else{
                    $return_details = new StReturn();
                    $return_details->mas_id = $return_id;
                }
                $return_details->issue_id = $request->issue_id[$key];
                $return_details->item_id = $get_issue->item_id;
                $return_details->type = @$request->type[$key] ?? 'return';
                $return_details->part_no = $request->part_no[$key];
                $return_details->unit_qty = $request->unit_qty[$key];
                $return_details->sub_unit_qty = $request->sub_unit_qty[$key];
                $return_details->total = $total;
                $return_details->sub_total = $sub_total;
                $return_details->cgst = $get_issue->cgst;
                $return_details->cgst_value = $cgst;
                $return_details->sgst = $get_issue->sgst;
                $return_details->sgst_value = $sgst;
                $return_details->igst = $get_issue->igst;
                $return_details->igst_value = $igst;
                $return_details->note = $request->note[$key];
                if($request->save == 'Save & Approved'){
                    if($request->return_type == 'store'){
                        $return_details->type == 'repair' ? $return_details->status = 0 : $return_details->status = 1; // return
                        $return_details->approved_by = Auth::user()->id;
                        $get_issue->return_qty = $get_issue->return_qty + $return_qty;
                        $get_issue->update();
                        if($return_details->type == 'return'){
                            $stock = StStock::where('item_id', $get_issue->item_id)->where('part_no', $request->part_no[$key])->first();
                            if($stock){
                                $stock->present_qty = $stock->present_qty + $return_qty;
                                $stock->update();
                            }
                        }
                    }else{
                        $return_details->status = 1; // return to vendor
                        $return_details->approved_by = Auth::user()->id;
                        $get_issue->return_qty = $get_issue->return_qty + $return_qty;
                        $get_issue->present_qty = $get_issue->present_qty - $return_qty;
                        $get_issue->update();
                    }
                }
                $return_details->save();
            }

            DB::commit();
            return redirect()->route('store.return-list')->with('success', 'Return Request Saved Successfully!');
        } catch (\Exception $e) {
            DB::rollback();
            return back()->with('error', 'Something went wrong. Try again!');
        }
    }
