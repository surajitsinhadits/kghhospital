    public function update_item_issue(Request $request, $id = 0)
    {
        // dd($request->all());

        $request->validate([
            'date' => 'required',
            'department' => 'required',
            'item_name.*' => 'required',
            'part_no.*' => 'required',
        ]);
        try {
            DB::beginTransaction();

            $product_issue = $id ? StProductIssue::find($id) : new StProductIssue();
            $product_issue->date = date('Y-m-d H:i:s',strtotime($request->date));
            $product_issue->department_id = $request->department;
            $product_issue->requisition_id = $request->requisition_id;
            $product_issue->note = $request->note;
            $product_issue->status = $request->status;
            if($id){
                $product_issue->edit_by = Auth::user()->id;
                $product_issue->edit_at = date('Y-m-d h:i:s');
            }else{
                $product_issue->generated_by = Auth::user()->id;
            }
            $product_issue->status = $request->action_type;
            $product_issue->save();
            $product_issue_id = $product_issue->id;

            // $item_issued = StRequisition::find($request->requisition_id);
            // $item_issued->is_given = 4;
            // $item_issued->save();

            if (!empty($request->uppid) && is_array($request->uppid)) {
                StProductIssueDetail::where('issue_id', $product_issue_id)
                    ->whereNotIn('id', $request->uppid)
                    ->update(['is_delete' => 1]);
            }

            foreach ($request->item_name as $key => $items) {
                if(@$request->uppid[$key]){
                    $issue_details = StProductIssueDetail::find($request->uppid[$key]);
                }else{
                    $issue_details = new StProductIssueDetail();
                }
                $issue_details->issue_id = $product_issue_id;
                $issue_details->item_id = $request->item_name[$key];
                $issue_details->part_no = $request->part_no[$key];
                $issue_details->exp_date = $request->exp_date[$key];
                $issue_details->unit_qty = $request->unit_qty[$key];
                $issue_details->sub_unit_qty = $request->sub_unit_qty[$key];
                $issue_details->sub_unit = $request->sub_unit[$key];
                $issue_details->unit = $request->unit[$key];
                $issue_details->save();
            }

            if((int)$request->action_type == 1){
                if($request->status == 1){
                    StRequisition::find($request->requisition_id)->update(['is_given' => 4]);
                }

                $full_stocks = [];
                foreach ($request->item_name as $key => $items) {
                    $stock_summary = DB::table('st_stocks')
                        ->where('item_id', $request->item_name[$key])
                        ->where('part_no', $request->part_no[$key])
                        ->where(function($query) {
                            $query->whereDate('exp_date', '>=', now())
                                ->orWhereNull('exp_date');
                        })
                        ->selectRaw('
                            unit_rate,
                            unit_mrp,
                            unit_sub_no,
                            cgst,
                            sgst,
                            igst,
                            SUM(present_qty) as present_qty,
                            SUM(unit_qty) as unit_qty,
                            SUM(sub_unit_qty) as sub_unit_qty
                        ')
                        ->groupBy('unit_rate','unit_mrp','unit_sub_no','igst','sgst','cgst')
                        ->first();
                    // $issue_summary = DB::table('st_issues')
                    //     ->where('item_id', $request->item_name[$key])
                    //     ->where('part_no', $request->part_no[$key])
                    //     ->selectRaw('
                    //         SUM(unit_qty) as unit_qty,
                    //         SUM(sub_unit_qty) as sub_unit_qty
                    //     ')
                    //     ->first();
                    // $total_stk_qty = ($stock_summary->unit_qty * $stock_summary->unit_sub_no) + $stock_summary->sub_unit_qty;
                    // $total_iss_qty = ($issue_summary->unit_qty * $stock_summary->unit_sub_no) + $issue_summary->sub_unit_qty;
                    // $total_avi_qty = $total_stk_qty - $total_iss_qty;
                    $total_avi_qty = $stock_summary->present_qty;
                    $total_obt_qty = ($request->unit_qty[$key] * $stock_summary->unit_sub_no) + $request->sub_unit_qty[$key];
                    if($total_avi_qty >= $total_obt_qty){
                        $sub_total = ($stock_summary->unit_rate / $stock_summary->unit_sub_no) * $total_obt_qty;
                        $cgst = $sub_total * ($stock_summary->cgst / 100);
                        $sgst = $sub_total * ($stock_summary->sgst / 100);
                        $igst = $sub_total * ($stock_summary->igst / 100);
                        $total = $sub_total + $cgst + $sgst + $igst;

                        $full_stocks[] = [
                            'issue_id' => $product_issue_id,
                            'date' => now(),
                            'item_id' => $request->item_name[$key],
                            'exp_date' => $request->exp_date[$key] ? date('Y-m-d',strtotime($request->exp_date[$key])) : null,
                            'part_no' => $request->part_no[$key],
                            'unit_qty' => $request->unit_qty[$key]  ?? 0,
                            'unit' => $request->unit[$key],
                            'sub_unit_qty' => $request->sub_unit_qty[$key] ?? 0,
                            'sub_unit' => $request->sub_unit[$key],
                            'total' => $total,
                            'sub_total' => $sub_total,
                            'cgst' => $stock_summary->cgst,
                            'cgst_value' => $cgst,
                            'sgst' => $stock_summary->sgst,
                            'sgst_value' => $sgst,
                            'igst' => $stock_summary->igst,
                            'igst_value' => $igst,
                            'unit_mrp' => $stock_summary->unit_mrp,
                            'unit_rate' => $stock_summary->unit_rate,
                            'total_qty' => $total_obt_qty,
                            'generated_by' => Auth::user()->id,
                        ];
                    }else{
                        $product_issue_up = StProductIssue::find($product_issue_id);
                        $product_issue_up->status = 0;
                        $product_issue_up->save();
                        return redirect()->route('store.listing-item-issue')->with('error', 'Stock not available! Check & try again');
                    }
                }
                DB::table('st_issues')->insert($full_stocks);

                foreach ($full_stocks as $fs) {
                    $pre_stock = StStock::where('item_id', $fs['item_id'])->where('part_no', $fs['part_no'])->first();
                    $pre_stock->present_qty = $pre_stock->present_qty - $fs['total_qty'];
                    $pre_stock->update();

                    $req = StRequisitionItem::where('requisition_id', $request->requisition_id)->where('item_id', $fs['item_id'])->first();
                    $req->iunit_qty = $req->iunit_qty + $fs['unit_qty'];
                    $req->isubunit_qty = $req->isubunit_qty + $fs['sub_unit_qty'];
                    $req->update();
                }
            }
            DB::commit();
            return redirect()->route('store.listing-item-issue')->with('success', 'Issue Saved Successfully!');
        } catch (\Exception $e) {
            DB::rollback();
            return back()->with('error', 'Something went wrong. Try again!');
        }
    }
    public function delete_item_issue($id)
    {
        $id = ed($id, false);
        $data = StProductIssue::where('id',$id)->first();

        if ($data) {
            if($data->status == 1){
                return back()->with('error', "Item Issued can't Delete this!");
            }else{
                $data->update([
                    'is_delete' => 1
                ]);
                return redirect()->route('store.listing-item-issue')->with('success', 'The Purchase Deleted Successfully');
            }
        } else {
            return back()->with('error', "Something Went Wrong");
        }
    }
    public function get_req_details(Request $request)
    {
        $requisition_id = $request->requisition_id;
        $req = StRequisition::find($requisition_id);
        if ($req) {
            $items = StRequisitionItem::select('st_requisition_items.*', 'st_items.item_name','st_items.sub_unit_no')
                ->join('st_items', 'st_items.id', '=', 'st_requisition_items.item_id')
                ->where('st_requisition_items.requisition_id', $requisition_id)
                ->where('st_requisition_items.is_delete', 0)
                ->get()
                ->map(function($item) {
                    $item->batch_info = StStock::where('item_id', $item->item_id)
                        ->where(function($query) {
                            $query->whereDate('exp_date', '>=', Carbon::now())
                                ->orWhereNull('exp_date');
                        })
                        ->get()
                        ->toArray();
                    return $item;
                });

            return response()->json([
                'status' => true,
                'data' => [
                    'req_date' => date('Y-m-d', strtotime($req->requisition_date)),
                    'department_id' => $req->department_id,
                    'note' => $req->note,
                    'items' => $items,
                ]
            ]);
        } else {
            return response()->json(['status' => false, 'message' => 'Requisition not found']);
        }
    }

