    public function update_expense(Request $request, $id = 0)
    {

        // dd($id, $request->all());
        // dd($request->all_remarks[16]);

        $request->validate([
            'expense_date'      => 'required',
            'department_id'     => 'required',
            'requisition_id'    => 'required'
        ]);

        try {

            DB::beginTransaction();

            $expense = $id ? StExpense::find($id) : new StExpense();
            $expense->expense_date = date('Y-m-d H:i:s', strtotime($request->expense_date));
            $expense->dept_id = $request->department_id;
            $expense->requisition_id = $request->requisition_id;
            $expense->remarks = !empty($request->remarks) ? $request->remarks : null;

            if($id){
                $expense->edit_by = Auth::user()->id;
                $expense->edit_at = date('Y-m-d h:i:s');
            }else{
                $expense->generated_by = Auth::user()->id;
            }

            $expense->save();


            // $existingItemIds = StRequisitionItem::where('requisition_id', $request->requisition_id)->pluck('id')->toArray();
            // $submittedItemIds = [];
            // $toDelete = array_diff($existingItemIds, $submittedItemIds);

            // if (!empty($toDelete)) {
            //     StRequisitionItem::whereIn('id', $toDelete)->update(['is_delete' => 1]);
            // }

            foreach ($request->req_item_id as $key => $id) {

                $item = StRequisitionItem::find($id);
                $StItem = StItem::where('id', $request->item_name[$key])->first(['sub_unit_no']);

                $pcsPerBox = $StItem->sub_unit_no;
                $totalPc   = (int) $request->sub_unit_qty[$key];

                $unit_qty       = intdiv($totalPc, $pcsPerBox);
                $sub_unit_qty    = $totalPc % $pcsPerBox;

                $item->exp_unit_qty    = $unit_qty ?? 0;
                $item->exp_subunit_qty = $sub_unit_qty ?? 0;
                $item->exp_remarks     = $request->all_remarks[$key] ?? null;

                $item->save();

            }

            DB::commit();

            return redirect()->route('store.expense-list')->with('success', 'Expense Saved Successfully!');

        } catch (\Exception $e) {
            DB::rollback();
            return back()->with('error', 'Something went wrong. Try again!');
        }
    }

