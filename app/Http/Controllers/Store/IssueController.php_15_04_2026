    public function repair_items_return(Request $request)
    {
        $request->validate([
            'return_id' => 'required',
            'repair_from' => 'required',
            'repair_time' => 'required',
            'repair_amount' => 'required',
        ]);
        $data = StReturn::where('id', $request->return_id)->first();
        if ($data) {
            $unit_sub_no = optional(StStock::where('item_id', $data->item_id)->where('part_no', $data->part_no)->first())->unit_sub_no;
            $return_qty = ($data->unit_qty * $unit_sub_no) + $data->sub_unit_qty;
            $issue = StIssue::find($data->issue_id);
            $issue->return_qty = $issue->return_qty - $return_qty;
            $issue->update();

            if ($request->hasfile('repair_bill')) {
                $file = $request->file('repair_bill');
                $repair_bill = uniqid() . '.' . $file->getClientOriginalExtension();
                $fileSave =  $file->move("public/assets/images/billdocument/", $repair_bill);
            }else{
                $repair_bill = null;
            }

            $data->status = 1;
            $data->repair_completed_at = date('Y-m-d H:i:s');
            $data->repair_completed_by = Auth::user()->id;
            $data->repair_from = $request->repair_from;
            $data->repair_time = $request->repair_time;
            $data->repair_amount = $request->repair_amount;
            $data->repair_bill = $repair_bill;
            $data->update();
            return redirect()->route('store.repair-list')->with('success', 'Item successfully Re-Issue!');
        } else {
            return back()->with('error', "Something Went Wrong");
        }
    }

