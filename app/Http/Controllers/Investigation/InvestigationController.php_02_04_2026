    public function index(Request $request){
        $doctor = Referral::where('type','referral')->where('is_active', 1)->where('is_delete', 0)->get();
        if ($request->ajax()) {
            $data = InvestigationRegister::select('investigation_registers.id','investigation_registers.type','investigation_registers.patient_id','investigation_registers.appointment_date','investigation_registers.referred_by','b.id as billing_id','b.uid','b.due_amount','b.bill_status','p.name as patient_name','p.phone','p.gender','p.dob_year','p.dob_month','p.dob_day','r.referral_name')
                ->join('billings as b', function ($join) {
                    $join->on('b.section_id', '=', 'investigation_registers.id')
                         ->where('b.section', '=', 'INVESTIGATION');
                })
                ->join('patients as p','p.id','=','investigation_registers.patient_id')
                ->join('referrals as r','r.id','=','investigation_registers.referred_by')
                ->where('investigation_registers.is_delete',0)
                ->orderBy('investigation_registers.id','DESC');

                // Filter based on field_name and field_value
                if (!empty($request->field_name) && !empty($request->field_value)) {
                    if ($request->field_name === 'investigation_registers.referred_by') {
                        $data->where('investigation_registers.referred_by', $request->field_value);
                    } else {
                        $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                    }
                }

                // Filter by date range
                if (!empty($request->from_date)) {
                    $data->whereDate('investigation_registers.appointment_date', '>=', date('Y-m-d',strtotime($request->from_date)));
                }
                if (!empty($request->to_date)) {
                    $data->whereDate('investigation_registers.appointment_date', '<=', date('Y-m-d',strtotime($request->to_date)));
                }
            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('billing', function($row){
                    $billingBtn = '<a href="'.route('bill.billing-details', ['investigation', ed($row->billing_id, true)]).'" data-placement="top" data-toggle="tooltip" title="Click here to show bill details" data-original-title="Click here to show bill details">'.$row->uid.'</a><br>';
                    $billingBtn .= $row->bill_status == 3 ? '<span class="badge badge-gradient-secondary mr-1">Cancel Bill</span>': '';
                    $row->due_amount > 0 ? $billingBtn .= '<span class="badge badge-gradient-warning">Due</span>' : $billingBtn .= '<span class="badge badge-gradient-success">No Due</span>';
                    return $billingBtn;
                })
                ->addColumn('patient', function($row){
                    $patientBtn = '<a href="'.route('hr.patient-profile-details', ed($row->patient_id, true)).'" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important" data-original-title="Click here for patient details">
                        '.$row->patient_name.'
                        <br>
                        <i class="fa fa-venus-mars text-blue"></i> '.$row->gender.'
                        <i class="fa fa-calendar-plus-o text-blue ml-1"></i> '.$row->dob_year.'Y '.$row->dob_month.'M '.$row->dob_day.'D
                        <span class="badge badge-gradient-primary mt-2 ml-1">'.$row->type.'</span>
                    </a>';
                    return $patientBtn;
                })
                ->addColumn('action', function($row){
                    $actionBtn = '<a href="'.route('bill.billing-details', ['investigation', ed($row->billing_id, true)]).'" class="btn btn-primary btn-sm mx-1" title="Click here to show bill details"><i class="fa fa-eye"></i> View</a>';
                    return $actionBtn;
                })
                ->rawColumns(['action','billing','patient'])
                ->make(true);
        }
        return view('investigation.investigation', compact('doctor'));
    }
    public function investigation_register(){
