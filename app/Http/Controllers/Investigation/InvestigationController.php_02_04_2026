    public function update_investigation_register(Request $request){

        $request->validate([
            'appointment_date' => 'required',
            'referred_by' => 'required',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'required',
            'address' => 'required',
            'state' => 'required',
            'uhid' => 'nullable|exists:patients,id',
        ]);
        // dd($request);
        DB::beginTransaction();
        try {
            //SAVE in Patient
            $request->uhid ? $patient = Patient::find($request->uhid) : $patient = new Patient();
            $patient->name = ucwords($request->name);
            $patient->phone = $request->phone;
            $patient->gender = $request->gender;
            $patient->dob_year = $request->date_of_birth_year ?? 0;
            $patient->dob_month = $request->date_of_birth_month ?? 0;
            $patient->dob_day = $request->date_of_birth_day ?? 0;
            $patient->address = $request->address;
            $patient->state = $request->state;
            $patient->district = is_numeric($request->district) ? $request->district : null;
            $patient->pin_code = $request->pin_no;
            $patient->identification_number = $request->aadhaar_card;
            $patient->save();
            $patient_id = $patient->id;

            //SAVE in INVESTIGATION Details
            $investigation = new InvestigationRegister();
            $investigation->doctor_id = $request->cons_doctor;
            $investigation->patient_id = $patient_id;
            $investigation->generate_by = Auth::user()->id;
            $investigation->type = $request->uhid ? 'old' : 'new';
            $investigation->appointment_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $investigation->referred_by = $request->referred_by;
            $investigation->provider = $request->provider;
            $investigation->market_by = $request->market_by;
            $investigation->save();
            $investigation_id = $investigation->id;

            //SAVE in CASE Reference
            $caseReference = new CaseReference;
            $caseReference->patient_id = $patient_id;
            $caseReference->section = 'INVESTIGATION';
            $caseReference->section_id = $investigation_id;
            $caseReference->save();

            //SAVE in Billing Section
            $bill = new Billing();
            $bill->uid = Billing::where('section', 'INVESTIGATION')->selectRaw('MAX(CAST(uid AS UNSIGNED)) as max_uid')->value('max_uid') + 1;
            $bill->section = 'INVESTIGATION';
            $bill->section_id = $investigation_id;
            $bill->bill_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $bill->patient_id = $patient_id;
            $bill->doctor_id = $request->cons_doctor;
            $bill->referred_by = $request->referred_by;
            $bill->provider = $request->provider;
            $bill->market_by = $request->market_by;
            $bill->case_id = $caseReference->id;
            $bill->total = $request->total;
            $bill->sub_total = $request->total;
            $bill->discount_amount = $request->total - $request->grand_total;
            $bill->discount = $request->total_discount ?? 0;
            $bill->discount_type = $request->discount_type;
            $bill->discount_status = 'Approved';
            $bill->total_payment = $request->total_payment;
            if($request->grand_total > $request->total_payment){
                $bill->due_amount = $request->grand_total - $request->total_payment;
            }else{
                $bill->cradit_amount = $request->total_payment - $request->grand_total;
            }
            $bill->grand_total = $request->grand_total;
            $bill->status = 'Done';
            $bill->bill_status = 1;
            $bill->created_by = Auth::user()->id;
            $bill->save();
            $bill_id = $bill->id;

            if($bill->cradit_amount > 0){
                PatientCraditAmount::create([
                    'patient_id' => $patient_id,
                    'billing_id' => $bill_id,
                    'date' => date('Y-m-d H:i:s'),
                    'amount' => $bill->cradit_amount,
                    'type' => 'credit',
                    'remarks' => 'added',
                    'generated_by' => Auth::id(),
                ]);
            }

            //SAVE in Billing Details
            foreach ($request->charge_name as $key => $value) {
                $charge = Charge::select('charges.*','cc.charges_catagories_name')
                    ->leftjoin('charges_catagories as cc','cc.id','=','charges.sub_category_id')
                    ->where('charges.id', $request->charge_name[$key])
                    ->first();

                $bill_details =  new BillingDetail();
                $bill_details->billing_id = $bill_id;
                $bill_details->charge_category_id = $charge->category_id;
                $bill_details->charge_sub_category_id = $charge->sub_category_id;
                $bill_details->date = $request->appointment_date ? date('Y-m-d H:i', strtotime($request->appointment_date)) : date('Y-m-d H:i:s');
                $bill_details->charge_id = $request->charge_name[$key];
                $bill_details->charge_name = $charge->charge_name;
                $bill_details->standard_charges = $request->rate[$key];
                $bill_details->discount_percentage = $request->discount_in_per[$key];
                $bill_details->discount_amount = $request->discount_amount[$key];
                $bill_details->qty = $request->qty[$key];
                $bill_details->amount = $request->amount[$key];
                $bill_details->save();

                //SAVE in investigations
                if($charge->charge_type == 'investigation'){
                    $charge_normal = ChargesHasNormal::where('charge_id',$charge->id)->get();

                    if($charge->category_id == 10){
                        $type = 'pathology';
                    }elseif($charge->category_id == 12){
                        $type = 'non-pathology';
                    }elseif($charge->category_id == 11){
                        $type = 'radiology';
                    }else{
                        $type = null;
                    }
                    // dd($charge,$type);

                    if($type){
                        $investiga = new Investigation();
                        $investiga->type = $type;
                        $investiga->charge_id = $charge->id;
                        $investiga->bill_id =  $bill_id;
                        $investiga->bill_details_id = $bill_details->id;
                        $investiga->patient_id = $patient_id;
                        $investiga->bill_created_by = Auth::user()->id;
                        $investiga->bill_created_date = date('Y-m-d H:i:s');
                        $investiga->expected_delivery_at = date('Y-m-d');
                        $investiga->report_status = '0'; // 0 => only bill created, 1 => sample collected, 2 => sample collecting, 3 => lab received, 4 => report generated, 5 => report deliverd
                        $investiga->section =  'INVESTIGATION';
                        $investiga->section_id = $investigation_id;
                        $investiga->referral_id = $request->referred_by;
                        $investiga->save();

                        foreach ($charge_normal as $key => $value) {
                            $investigation_details = new InvestigationDetail();
                            $investigation_details->investigation_id = $investiga->id;
                            $investigation_details->charge_normal_id = $value->id;
                            $investigation_details->save();
                        }
                    }
                }
            }

            //SAVE in Payment
            if (count($request->payment_amount) > 0) {
                foreach($request->payment_amount as $key=>$value){
                    if($request->payment_amount[$key] > 0){
                        $payment = new Payment();
                        $payment->billing_id = $bill_id;
                        $payment->patient_id = $patient_id;
                        $payment->section = 'INVESTIGATION';
                        $payment->payment_amount = $request->payment_amount[$key];
                        $payment->payment_mode = $request->payment_mode[$key];
                        $payment->payment_bank = $request->payment_mode[$key] == 'Cash' ? null : $request->bank_name;
                        $payment->payment_recived_by = Auth::user()->id;
                        $payment->payment_date = date('Y-m-d H:i');
                        $payment->save();
                    }
                }
            }

            //credit use
            if (count($request->adjust_credit_amount ?? []) > 0) {
                foreach($request->adjust_credit_amount as $key=>$value){
                    if($request->adjust_credit_amount[$key] > 0){
                        $credit = new PatientCraditAmount();
                        $credit->billing_id = $bill_id;
                        $credit->patient_id = $patient_id;
                        $credit->date = date('Y-m-d H:i:s');
                        $credit->amount = $request->adjust_credit_amount[$key];
                        $credit->type = 'debit';
                        $credit->remarks = 'reused';
                        $credit->use_bill_id = $request->credit_bill[$key];
                        $credit->generated_by = Auth::user()->id;
                        $credit->save();

                        $upbill = Billing::find($request->credit_bill[$key]);
                        $upbill->cradit_amount = $upbill->cradit_amount - $request->adjust_credit_amount[$key];
                        $upbill->cradituse_bill_id = $upbill->cradituse_bill_id.'_'.$bill_id;
                        $upbill->cradituse_bill_amount = $upbill->cradituse_bill_amount.'_'.$request->adjust_credit_amount[$key];
                        $upbill->save();
                    }
                }
            }

            DB::commit();
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        $url1 = route('bill.print-bill', ['investigation',ed($bill_id, true)]);
        $return_action = route('investigation.investigation');
        return view('open-single-tabs', compact('url1', 'return_action'));
    }
    public function investigation_report(Request $request, $type, $value = null){
        if($type == 'pathology'){
            if($value == 'collection'){
                $tag = 'Collect';
                $url['single'] = route('investigation.sample-collected');
                $url['bulk'] = route('investigation.bulk-sample-collected');
                $status['key'] = ['All','Collected','Not Collected'];
                $status['value'] = ['0-1','1','0'];
                $title = 'Pathology Collections';
            }elseif($value == 'lab-recived'){
                $tag = 'Receive';
                $url['single'] = route('investigation.lab-received');
                $url['bulk'] = route('investigation.bulk-lab-received');
                $status['key'] = ['All','Received By Lab','Not Receive By Lab'];
                $status['value'] = ['1-2','2','1'];
                $title = 'Pathology Lab Receive';
            }else{
                $tag = 'Generate';
                $url['single'] = route('investigation.report-generate');
                $url['bulk'] = route('investigation.bulk-report-generate');
                $status['key'] = ['All','Report Updated','Report Not Update'];
                $status['value'] = ['2-3','3','2'];
                $title = 'Pathology Reports';
            }
        }else{
            $tag = 'Generate';
            $url['single'] = route('investigation.report-generate');
            $url['bulk'] = route('investigation.bulk-report-generate');
            $status['key'] = ['All','Report Updated','Report Not Update'];
            $status['value'] = ['0-1','1','0'];
            $title = ucwords($type).' Reports';
        }
        if ($request->ajax()) {
            $data = Investigation::select(
                'investigations.id',
                'investigations.bill_id',
                'investigations.patient_id',
                'b.uid',
                'investigations.bill_created_date',
                'p.name as patient_name',
                'p.phone',
                'p.gender',
                'p.dob_year',
                'p.dob_month',
                'p.dob_day',
                'r.referral_name',
                'u.name as doctor_name',
                'investigations.section',
                'investigations.section_id',
                'beds.bed_name'
            )
            ->leftjoin('billings as b','b.id','=','investigations.bill_id')
            ->leftjoin('patients as p','p.id','=','investigations.patient_id')
            ->leftJoin('referrals as r','r.id','=','investigations.referral_id')
            ->leftJoin('users as u','u.id','=','investigations.doctor_id')
            ->leftJoin('ipd_registers', function ($join) {
                $join->on('ipd_registers.id', '=', 'investigations.section_id')
                     ->where('investigations.section', 'IPD')
                     ->leftjoin('beds', 'beds.id', '=', 'ipd_registers.bed_id');
            })
            ->where('investigations.type', '=', $type)
            ->where('investigations.is_delete', 0)
            // ->where('investigations.report_status', $rs)
            // ->whereIn('investigations.id', function ($subQuery) use ($rs) {
            //     $subQuery->select(DB::raw('MAX(id)'))
            //              ->from('investigations')
            //              ->where('report_status', $rs)
            //              ->groupBy('bill_id');
            // })
            ->OrderBy('investigations.bill_created_date','DESC');

            // Filter based on field_name and field_value
            if (!empty($request->field_name) && !empty($request->field_value)) {
                $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
            }

            // Filter by status
            if (is_numeric($request->status_value) && $request->status_value == 0) {
                $status = (string)$request->status_value;
                $data->where('investigations.report_status', $status);
                $data->whereIn('investigations.id', function ($subQuery) use ($status, $type) {
                    $subQuery->select(DB::raw('MAX(id)'))
                            ->from('investigations')
                            ->where('report_status', (string)$status)
                            ->where('type', '=', (string)$type)
                            ->groupBy('bill_id');
                });
            } else {
                $status = explode('-', $request->status_value);
                $data->whereIn('investigations.report_status', $status);
                $data->whereIn('investigations.id', function ($subQuery) use ($status, $type) {
                    $subQuery->select(DB::raw('MAX(id)'))
                            ->from('investigations')
                            ->whereIn('report_status', $status)
                            ->where('type', '=', (string)$type)
                            ->groupBy('bill_id');
                });
            }

            // Filter by test
            if (!empty($request->select_value)) {
                $data->whereIn('investigations.charge_id', $request->select_value);
            }

            // Filter by date range
            if (!empty($request->from_date)) {
                $data->whereDate('investigations.bill_created_date', '>=', date('Y-m-d',strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $data->whereDate('investigations.bill_created_date', '<=', date('Y-m-d',strtotime($request->to_date)));
            }
            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('cre_date', function($row){
                    $dateBtn = dateFor($row->bill_created_date, true);
                    return $dateBtn;
                })
                ->rawColumns(['cre_date'])
                ->make(true);
        }
        $charge = Charge::select('id','charge_name')->where('is_active',1)->where('is_delete',0)->get();
        $data = compact('type','value','tag','url','title','charge','status');
        return view('investigation.investigation-reports')->with($data);
    }
    public function investigation_deatils(Request $request){
        if (is_numeric($request->status)) {
            $status = [(string)$request->status];
        } else {
            $status = explode('-', $request->status);
        }
        $bill_date = Billing::where('id', $request->bill_id)
            ->select('bill_date')
            ->first();
        $response = Investigation::select('investigations.id','investigations.charge_id','c.charge_name','st.sample_name','v.vial_name','investigations.report_status','investigations.bill_created_date','investigations.attach_document')
            ->leftjoin('charges as c','c.id','=','investigations.charge_id')
            ->leftJoin('sample_types as st','st.id','=','c.sample_id')
            ->leftJoin('vials as v','v.id','=','c.vial_id')
            ->where('investigations.bill_id', $request->bill_id)
            ->when($request->type, function($query) use ($request) {
                return $query->where('investigations.type', $request->type);
            })
            // ->whereDate('investigations.bill_created_date', date('Y-m-d', strtotime($bill_date->bill_date)))
            ->whereIn('investigations.report_status', $status)
            ->where('investigations.is_delete', '0')
            ->get()
            ->map(function($item) {
                $item->id_ed = ed($item->id, true);
                if($item->attach_document){
                    $item->attach_document = url('public/assets/attachments/investigation').'/'.$item->attach_document;
                }else{
                    $item->attach_document = null;
                }
                return $item;
            });
        return response()->json([
            'success' => true,
            'results' => $response,
            'route' => route('investigation.print-bulk-reports'),
            'billId' => $request->bill_id,
        ]);
    }
