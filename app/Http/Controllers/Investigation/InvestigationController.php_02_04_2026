    public function update_report(Request $request){
        $path = public_path('assets/attachments/investigation');
        if ($request->file('attach_document')) {
            $attach_document = rand() . "." . $request->file('attach_document')->getClientOriginalExtension();
            $request->file('attach_document')->move($path, $attach_document);
        } else {
            $attach_document = null;
        }

        $investigation = Investigation::where('id',$request->investigation_id)->update([
            'note'=> $request->note,
            'extra_note'=>$request->extra_note,
            // 'remarks'=> $request->remarks,
            // 'special_remarks'=> $request->special_remarks,
            'attach_document'=> $attach_document,
            'approved_at' =>  date('Y-m-d H:i'),
            'approved_doctor_by' => $request->approved_test_doctor,
            'report_deliverd_at'=> date('Y-m-d H:i'),
            'report_template_result'=> $request->report_template_result
        ]);

        if(@$request->report_details_id){
            foreach ($request->report_details_id as $key => $value) {
                $pathology_details = InvestigationDetail::where('id', $value)->first();
                $pathology_details->test_result_value = $request->result[$key];
                $pathology_details->comment = $request->comment[$key];
                $pathology_details->save();
            }
        }

        if($request->save_type == 'only_update_and_print'){
            return redirect()->route('investigation.print-from-report-update',ed($request->investigation_id, true));
        }else{
            return redirect()->back()->with('success','Result update successfully');
        }
    }
