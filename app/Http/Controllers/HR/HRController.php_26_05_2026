    public function update_doctor(Request $request, $id = 0)
    {
        $request->validate([
            "registation_id" => 'required|unique:users,empId,' . $id,
            "department" => 'required',
            "name" => 'required|max:100',
            "gender" => 'required',
            "phone_no" => 'required|digits:10',
            "address" => 'nullable|max:255',
            "qualification" => 'nullable|max:255',
            "experience" => 'nullable|max:255',
            "specialization" => 'nullable|max:255',
            "doctor_type" => 'required',
            "charges_catagory" => 'required',
            "charges_sub_catagory" => 'required',
        ]);
        $path = public_path('assets/images/users');
        if ($request->file('signature')) {
            $signature = "signature-" . time() . "." . $request->file('signature')->getClientOriginalExtension();
            $request->file('signature')->move($path, $signature);
        } else {
            $signature = $request->input('old_signature') ?? null;
        }
        if ($request->input('doctor_fees')) {

            $id ? $charge_id = User::find($id)->charge_id : $charge_id = 0;
            if ($charge_id) {
                $charge = Charge::find($charge_id);
                if (!$charge) {
                    $charge = new Charge();  // important fix
                }
            } else {
                $charge = new Charge();
            }
            $charge->charge_type = 'other-services';
            $charge->charge_section = 'Profile';
            $charge->category_id = $request->charges_catagory;
            $charge->sub_category_id = $request->charges_sub_catagory;
            $charge->charge_name = 'Dr. '.$request->name;

            if ($charge->save()) {

                $charge_id = $charge->id;

                $chargeSection = ChargesHasSection::where('charge_id', $charge_id)->first();

                if ($chargeSection) {
                    $chargeSection->update([
                        'charge_section_id' => '1',
                        'charge_amount' => $request->doctor_fees,
                    ]);
                } else {
                    ChargesHasSection::create([
                        'charge_id' => $charge_id,
                        'charge_section_id' => '1',
                        'charge_amount' => $request->doctor_fees,
                    ]);
                }
            }
        } else {
            $charge_id = 0;
        }
        $id ? $data = User::find($id) : $data = new User();
        $data->role_id = Role::where('role', 'DOCTOR')->first()->id;
        $data->empId = $request->input('registation_id');
        $data->department_id = $request->input('department');
        $data->salutation = $request->input('salutation');
        $data->name = $request->input('name');
        $data->gender = $request->input('gender');
        $data->phone_no = $request->input('phone_no');
        $data->current_address = $request->input('address');
        $data->qualification = $request->input('qualification');
        $data->experience = $request->input('experience');
        $data->specialization = $request->input('specialization');
        $data->doctor_type = $request->input('doctor_type');
        $data->doctor_fees = ($request->input('doctor_fees')) ? $request->input('doctor_fees') : 0.00;
        $data->signature = $signature;
        $data->category_id = $request->input('charges_catagory');
        $data->sub_category_id = $request->input('charges_sub_catagory');
        $data->charge_id = $charge_id;
        $data->commission_type = $request->input('commission_type');
        $data->commission_amount = $request->input('commission_amount');
        $data->user_type = 'doctor';
        if ($data->save()) {
            return redirect()->route('hr.doctors')->with('success', 'Successfully Updated!');
        } else {
            return redirect()->route('hr.doctors')->with('error', 'Something wrong try again!');
        }
    }
