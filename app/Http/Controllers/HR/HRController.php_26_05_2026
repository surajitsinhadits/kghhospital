        $request->validate([
            'department_name' => 'required|max:100',
            'department_code' => ['required', 'max:45', $departmentCodeRule],
        ]);

        $id ? $data = Department::find($id) : $data = new Department();
        $data->department_code = $request->department_code;
        $data->department_name = ucwords(str_replace("_", " ", $request->department_name));
        if ($data->save()) {
            return redirect()->route('hr.departments')->with('success', 'Successfully Updated!');
