    public function search_by_bill(Request $request)
    {
        if ($request->bill_no != null || $request->p_uhid_bill != null) {
            $data = Billing::where('uid', $request->bill_no)->where('section', $request->section)->first();
            if ($data != null) {
                return redirect()->route('bill.billing-details', [
                    'section' => $data->section,
                    'bill_id' => ed($data->id, true),
                ]);
            } else {
                if ($request->p_uhid_bill != null) {
                    $search_by_p = Billing::where('uid', $request->p_uhid_bill)->where('section', $request->section)->latest()->first();
                    if ($search_by_p != null) {
                        return redirect()->route('bill.billing-details', [
                            'section' => $search_by_p->section,
                            'bill_id' => ed($search_by_p->id, true),
                        ]);
                    } else {
                        return redirect()->back();
                    }
                } else {
                    return redirect()->back();
                }
            }
        } else {
            return redirect()->back();
        }
    }
    public function patient_search_in_global(Request $request)
    {
        $request_data = $request->all();
        $trimmedString = str_replace(' ', '', $request->Patientname);

        if (!empty($request_data)) {
            $all_patient = Patient::where(function ($query) use ($request, $trimmedString) {
                if (!empty($request->Patientmobile)) {
                    $query->where('phone', '=', $request->Patientmobile);
                }
                if (!empty($request->Patientuhid)) {
                    $query->where('id', '=', $request->Patientuhid);
                }
                if (!empty($request->Patientname)) {
                    $query->where(DB::raw("REPLACE(CONCAT_WS('', name), ' ', '')"), 'like', '%' . $trimmedString . '%');
                }
            })
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->orderBy('id', 'DESC')
            ->limit(10)
            ->get();
        } else {
            $all_patient = Patient::where('is_active', 1)
                ->where('is_delete', 0)
                ->orderBy('id', 'DESC')
                ->limit(10)
                ->get();
        }

        return response()->json([
            'all_patient' => $all_patient,
            'request_data' => $request_data
        ]);
    }

