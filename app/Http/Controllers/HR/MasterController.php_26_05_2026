    public function update_all_header_listing(Request $request, $id = 0)
    {
        if ($id) {
            $request->validate([
                'header_name' => 'required|max:100',
            ]);
        } else {
            $request->validate([
                'header_name' => 'required|max:100',
                'logo' => 'required|image|mimes:jpeg,png,jpg'
            ]);
        }

        $id ? $data = Header::find($id) : $data = new Header();

        $path = public_path('assets/images/header');
        if ($request->hasFile('logo')) {
            if ($id && $data->logo && File::exists($path . '/' . $data->logo)) {
                File::delete($path . '/' . $data->logo);
