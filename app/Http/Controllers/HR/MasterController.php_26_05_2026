    public function tds_management(Request $request)
    {
        // dd($request->all());

        $title = 'TDS Management';
        $sections = ChargesSection::orderBy('charges_section_name')->get();
        $records = collect();
        $tdsPercent = (float) (hospital('tds') ?? 0);
        $hasPaymentTdsColumn = Schema::hasColumn('payments', 'tds_amount');

        if ($request->filled('section') || $request->filled('bill_no')) {

            $query = Payment::select(
                'payments.*',
                'billings.uid as billing_uid',
                'billings.section as billing_section',
                'billings.bill_date as billing_date',
                'billings.tds_amount as billing_tds_amount',
                'billings.grand_total as billing_grand_total',

                // IPD Register fields (optional, add what you need)
                'ipd_registers.admission_type',
                'ipd_registers.admission_date',
                'ipd_registers.insurance_id',
                'ipd_registers.insurance_no',

                // TPA fields
                'tpa_managements.tpa_name',
                'tpa_managements.contact_person_name',
                'tpa_managements.contact_person_ph_no'
            )
            ->join('billings', 'billings.id', '=', 'payments.billing_id')

            // ✅ Join IPD register with billing section_id + section
            ->leftJoin('ipd_registers', function ($join) {
                $join->on('ipd_registers.id', '=', 'billings.section_id')
                    ->where('billings.section', '=', 'IPD');
            })

            // ✅ Join TPA with ipd_registers.insurance_id = tpa_managements.id
            ->leftJoin('tpa_managements', 'tpa_managements.id', '=', 'ipd_registers.insurance_id')

            ->where('payments.payment_mode', '!=', 'cash');

            // filter by section (billing OR payment)
            if ($request->filled('section')) {
                $section = $request->section;
                $query->where(function ($q) use ($section) {
                    $q->where('billings.section', $section)
                    ->orWhere('payments.section', $section);
                });
            }

            // filter by bill no
            if ($request->filled('bill_no')) {
                $query->where('billings.uid', $request->bill_no);
            }

            $records = $query->orderBy('payments.id', 'desc')->get()
                ->map(function ($item) use ($hasPaymentTdsColumn, $tdsPercent) {
                    $item->payment_tds_amount = $hasPaymentTdsColumn ? ($item->tds_amount ?? 0) : 0;
                    $item->billing_tds_amount = $item->billing_tds_amount ?? 0;
                    $item->tds_applied        = $item->payment_tds_amount > 0;
                    $item->tds_to_apply       = round((($item->payment_amount ?? 0) * $tdsPercent) / 100, 2);
                    return $item;
                });
        }


        $data = compact('title', 'sections', 'tdsPercent', 'records');
        return view('hr.tds-management')->with($data);
    }
    public function apply_tds_management(Request $request)
    {
        $request->validate([
            'selected_payments' => 'required|array|min:1',
            'selected_payments.*' => 'integer',
        ]);

        $paymentIds = array_filter((array) $request->input('selected_payments'));
        $billingIds = $request->input('billing_ids', []);
        $paymentHasTdsColumn = Schema::hasColumn('payments', 'tds_amount');
        $tdsPercent = (float) (hospital('tds') ?? 0);
        $errors = [];
        $savedCount = 0;

        DB::beginTransaction();
        try {
            foreach ($paymentIds as $paymentId) {
                $payment = Payment::find($paymentId);
                $billingId = $billingIds[$paymentId] ?? null;
                $billing = $billingId ? Billing::find($billingId) : null;

                if (!$payment || !$billing) {
                    $errors[] = "Payment #{$paymentId} is missing related billing data.";
                    continue;
                }

                // if ($billing->tds_amount > 0) {
                //     $errors[] = "TDS already applied for bill {$billing->uid}.";
                //     continue;
                // }

                if ($paymentHasTdsColumn && $payment->tds_amount > 0) {
                    $errors[] = "TDS already applied for payment #{$payment->id}.";
                    continue;
                }

                $tdsAmount = round(($payment->payment_amount * $tdsPercent) / 100, 2);
                if ($tdsAmount <= 0) {
                    $errors[] = "Computed TDS is zero for payment #{$payment->id}.";
                    continue;
                }

                $billing->tds_amount = $billing->tds_amount + $tdsAmount;
                $billing->save();

                if ($paymentHasTdsColumn) {
                    $payment->tds_amount = $tdsAmount;
                    $payment->save();
                }

                $savedCount++;
            }

            DB::commit();
        } catch (\Throwable $th) {
            DB::rollBack();
            return redirect()->back()->with('error', 'Failed to apply TDS. Please try again.');
        }

        if ($savedCount > 0) {
            $message = "Applied TDS ({$tdsPercent}%) for {$savedCount} bill(s).";
            if ($errors) {
                $message .= ' ' . implode(' ', $errors);
            }
            return redirect()->back()->with('success', trim($message));
        }

        return redirect()->back()->with('error', implode(' ', $errors) ?: 'No valid payments were selected.');
    }
