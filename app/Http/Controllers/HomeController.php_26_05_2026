                        'in_out_status' => $s,
                        'in_out_details' => $in_out,
                        'color' => $color,
                    ];
                    $active_doctor = collect($datar)->sortBy('avilable_time1')->values()->all();
                }
            }

            return compact('opd_details', 'emg_details', 'ipd_details', 'daycare_details', 'active_doctor');
        });

        return view('dashboard')->with($data);
