    public function index(Request $request){
        $doctor = User::where('user_type','doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        if ($request->ajax()) {
            $data = OpdRegister::select('opd_registers.id','opd_registers.ticket_no','opd_registers.type','opd_registers.patient_id','opd_registers.appointment_date','b.id as billing_id','b.uid','b.due_amount','b.bill_status','p.name as patient_name','p.phone','p.gender','p.dob_year','p.dob_month','p.dob_day','u.name as doctor_name','d.department_name')
                ->join('billings as b', function ($join) {
                    $join->on('b.section_id', '=', 'opd_registers.id')
                         ->where('b.section', '=', 'OPD');
                })
                ->join('patients as p','p.id','=','opd_registers.patient_id')
                ->join('users as u','u.id','=','opd_registers.doctor_id')
                ->join('departments as d','d.id','=','opd_registers.department_id')
                ->where('opd_registers.is_delete',0)
                ->orderBy('opd_registers.id','DESC');

                // Filter based on field_name and field_value
                if (!empty($request->field_name) && !empty($request->field_value)) {
                    if ($request->field_name === 'opd_registers.doctor_id') {
                        $data->where('opd_registers.doctor_id', $request->field_value);
                    } else {
                        $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                    }
                }

                // Filter by date range
                if (!empty($request->from_date)) {
                    $data->whereDate('opd_registers.appointment_date', '>=', date('Y-m-d',strtotime($request->from_date)));
                }
                if (!empty($request->to_date)) {
                    $data->whereDate('opd_registers.appointment_date', '<=', date('Y-m-d',strtotime($request->to_date)));
                }
            return Datatables::of($data)
                ->addIndexColumn()
                ->addColumn('billing', function($row){
                    $billingBtn = '<a href="'.route('bill.billing-details', ['opd', ed($row->billing_id, true)]).'" data-placement="top" data-toggle="tooltip" title="Click here to show bill details" data-original-title="Click here to show bill details">'.$row->uid.'</a><br>';
                    $billingBtn .= $row->bill_status == 3 ? '<span class="badge badge-gradient-secondary mr-1">Cancel Bill</span>': ($row->due_amount > 0 ? '<span class="badge badge-gradient-warning">Due</span>' : '<span class="badge badge-gradient-success">No Due</span>');
                    return $billingBtn;
                })
                ->addColumn('patient', function($row){
                    $patientBtn = '<a href="'.route('hr.patient-profile-details', ed($row->patient_id, true)).'" data-placement="left" data-toggle="tooltip" title="Click here for patient details" style="cursor: pointer !important" data-original-title="Click here for patient details">
                        '.$row->patient_name.'
                        <br>
                        <i class="fa fa-venus-mars text-blue"></i> '.$row->gender.'
                        <i class="fa fa-calendar-plus-o text-blue ml-1"></i> '.$row->dob_year.'Y '.$row->dob_month.'M '.$row->dob_day.'D
                        <span class="badge badge-gradient-primary mt-2 ml-1">'.$row->type.'</span>
                    </a>';
                    return $patientBtn;
                })
                ->addColumn('doctor', function($row){
                    $doctorBtn = '<i class="fa fa-cubes text-blue"></i> '.$row->department_name.'
                        <br>
                        <i class="fa fa-cube text-blue"></i> Dr. '.$row->doctor_name;
                    return $doctorBtn;
                })
                ->addColumn('action', function($row){
                    $actionBtn = '<a href="'.route('bill.billing-details', ['opd', ed($row->billing_id, true)]).'" class="btn btn-primary btn-sm mx-1" title="Click here to show bill details"><i class="fa fa-eye"></i> View</a>';
                    return $actionBtn;
                })
                ->addColumn('cancel_count', function($row){
                    $billBtn = Billing::join('billing_details as bd', 'bd.billing_id', '=', 'billings.id')
                        ->where('billings.section', 'OPD')
                        ->where('billings.section_id', $row->id)
                        ->where('bd.is_delete', 1)
                        ->count();
                    return $billBtn;
                })
                ->rawColumns(['action','billing','patient','doctor','cancel_count'])
                ->make(true);
        }
        $data = compact('doctor');
        return view('opd.opd')->with($data);
    }
    public function opd_register($id = 0){
        $id = ed($id, false);
        $department = Department::where('status','0')->get();
        $doctor = User::where('user_type','doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        $states = State::where('country_id','1')->get();
        $referral = Referral::where('type','referral')->where('is_active', 1)->where('is_delete', 0)->get();
        $provider = Referral::where('type','provider')->where('is_active', 1)->where('is_delete', 0)->get();
        $market_by = Referral::where('type','market_by')->where('is_active', 1)->where('is_delete', 0)->get();
        $charges = Charge::select('charges.id','charges.charge_name','chs.charge_amount')
            ->join('charges_has_sections as chs','chs.charge_id','=','charges.id')
            ->join('charges_sections as cs','cs.id','=','chs.charge_section_id')
            ->where('cs.charges_section_name','OPD')
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->get();
        if($id){
            $enq = OpdEnquiry::where('id',$id)->first();
        }else{
            $enq = null;
        }
        $data = compact('department','doctor','enq','states','referral','provider','market_by','charges');
        // dd($data);
        return view('opd.opd-register')->with($data);
    }
    public function update_opd_register(Request $request){
        $request->validate([
            'appointment_date' => 'required',
            'cons_doctor' => 'required',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'required',
            'address' => 'required',
            'state' => 'required',
            'uhid' => 'nullable|exists:patients,id',
        ]);
        // dd($request);
        DB::beginTransaction();
        try {
            //SAVE in Patient
            $request->uhid ? $patient = Patient::find($request->uhid) : $patient = new Patient();
            $patient->name = ucwords($request->name);
            $patient->phone = $request->phone;
            $patient->gender = $request->gender;
            $patient->dob_year = $request->date_of_birth_year ?? 0;
            $patient->dob_month = $request->date_of_birth_month ?? 0;
            $patient->dob_day = $request->date_of_birth_day ?? 0;
            $patient->address = $request->address;
            $patient->state = $request->state;
            $patient->district = is_numeric($request->district) ? $request->district : null;
            $patient->pin_code = $request->pin_no;
            $patient->save();
            $patient_id = $patient->id;

            //SAVE in OPD Details
            $ticket_no = OpdRegister::where('doctor_id',$request->cons_doctor)->where('appointment_date','like','%'.date('Y-m-d', strtotime($request->appointment_date)).'%')->max('ticket_no');
            $check = OpdRegister::where('patient_id', $patient_id)
                ->where('doctor_id', $request->cons_doctor)
                ->where('generate_by', Auth::user()->id)
                ->whereDate('appointment_date', date('Y-m-d H:i:s', strtotime($request->appointment_date)))
                ->first();
            if($check){
                return redirect()->back()->with('error', 'Already registered for this doctor on this date!');
            }

            $opd = new OpdRegister();
            $opd->department_id = $request->department ? $request->department : User::where('id',$request->cons_doctor)->first()->department_id;
            $opd->doctor_id = $request->cons_doctor;
            $opd->patient_id = $patient_id;
            $opd->generate_by = Auth::user()->id;
            $opd->type = $request->uhid ? 'old' : 'new';
            $opd->appointment_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $opd->enquiry_id = $request->enq_id;
            $opd->ticket_no = $ticket_no + 1;
            $opd->referred_by = $request->referred_by;
            $opd->provider = $request->provider;
            $opd->market_by = $request->market_by;
            $opd->save();
            $opd_id = $opd->id;

            //SAVE in CASE Reference
            $caseReference = new CaseReference;
            $caseReference->patient_id = $patient_id;
            $caseReference->section = 'OPD';
            $caseReference->section_id = $opd_id;
            $caseReference->save();

            //SAVE in PATIENT DOCTOR STATUS
            $checkStatus = PatientDoctorStatus::where('doctor_id',$request->cons_doctor)->where('patient_id',$patient_id)->first();
            $checkStatus ? $patient_type = 'old' : $patient_type = 'new';
            $doctorPatientStatus = new PatientDoctorStatus();
            $doctorPatientStatus->section = 'OPD';
            $doctorPatientStatus->section_id = $opd_id;
            $doctorPatientStatus->doctor_id = $request->cons_doctor;
            $doctorPatientStatus->patient_id = $patient_id;
            $doctorPatientStatus->patient_type = $patient_type;
            $doctorPatientStatus->date = $request->appointment_date ? date('Y-m-d', strtotime($request->appointment_date)) : null;
            $doctorPatientStatus->in_time = date('H:i');
            $doctorPatientStatus->save();

            //SAVE in Billing Section
            $bill = new Billing();
            $bill->uid = Billing::where('section', 'OPD')->selectRaw('MAX(CAST(uid AS UNSIGNED)) as max_uid')->value('max_uid') + 1;
            $bill->section = 'OPD';
            $bill->section_id = $opd_id;
            $bill->bill_date = $request->appointment_date ? date('Y-m-d H:i:s', strtotime($request->appointment_date)) : null;
            $bill->patient_id = $patient_id;
            $bill->doctor_id = $request->cons_doctor;
            $bill->referred_by = $request->referred_by;
            $bill->provider = $request->provider;
            $bill->market_by = $request->market_by;
            $bill->case_id = $caseReference->id;
            $bill->total = $request->total;
            $bill->sub_total = $request->total;
            $bill->discount_amount = $request->total - $request->grand_total;
            $bill->discount = $request->total_discount ?? 0;
            $bill->discount_type = $request->discount_type;
            $bill->discount_status = 'Approved';
            $bill->total_payment = $request->total_payment;
            if($request->grand_total > $request->total_payment){
                $bill->due_amount = $request->grand_total - $request->total_payment;
            }else{
                $bill->cradit_amount = $request->total_payment - $request->grand_total;
            }
            $bill->grand_total = $request->grand_total;
            $bill->status = 'Done';
            $bill->bill_status = 1;
            $bill->created_by = Auth::user()->id;
            $bill->save();
            $bill_id = $bill->id;

            if($bill->cradit_amount > 0){
                PatientCraditAmount::create([
                    'patient_id' => $patient_id,
                    'billing_id' => $bill_id,
                    'date' => date('Y-m-d H:i:s'),
                    'amount' => $bill->cradit_amount,
                    'type' => 'credit',
                    'remarks' => 'added',
                    'generated_by' => Auth::id(),
                ]);
            }

            //SAVE in Billing Details
            $userDetais = User::where('id',$request->cons_doctor)->first();
            ($userDetais->commission_type == 'rs') ? $commisionAmount = (($userDetais->commission_amount / $userDetais->doctor_fees) * 100) : $commisionAmount = $userDetais->commission_amount;

            foreach ($request->charge_name as $key => $value) {
                $charge = Charge::select('charges.*','cc.charges_catagories_name')
                    ->join('charges_catagories as cc','cc.id','=','charges.sub_category_id')
                    ->where('charges.id', $request->charge_name[$key])
                    ->first();
                ($charge->charges_catagories_name == 'CONSULTANCY FEES') ? $commision = ($request->amount[$key] * ($commisionAmount / 100)) : $commision = 0;

                $bill_details =  new BillingDetail();
                $bill_details->billing_id = $bill_id;
                $bill_details->charge_category_id = $charge->category_id;
                $bill_details->charge_sub_category_id = $charge->sub_category_id;
                $bill_details->date = $request->appointment_date ? date('Y-m-d H:i', strtotime($request->appointment_date)) : date('Y-m-d H:i:s');
                $bill_details->charge_id = $request->charge_name[$key];
                $bill_details->charge_name = $charge->charge_name;
                $bill_details->standard_charges = $request->rate[$key];
                $bill_details->commision_amount = $commision;
                $bill_details->discount_percentage = $request->discount_in_per[$key];
                $bill_details->discount_amount = $request->discount_amount[$key];
                $bill_details->qty = $request->qty[$key];
                $bill_details->amount = $request->amount[$key];
                $bill_details->save();

                //SAVE in investigations
                if($charge->charge_type == 'investigation'){
                    $charge_normal = ChargesHasNormal::where('charge_id',$charge->id)->get();
                    if($charge->category_id == 10){
                        $type = 'pathology';
                    }elseif($charge->category_id == 12){
                        $type = 'non-pathology';
                    }elseif($charge->category_id == 11){
                        $type = 'radiology';
                    }else{
                        $type = null;
                    }
                    if($type){
                        $investigation = new Investigation();
                        $investigation->type = $type;
                        $investigation->charge_id = $charge->id;
                        $investigation->bill_id =  $bill_id;
                        $investigation->bill_details_id = $bill_details->id;
                        $investigation->patient_id = $patient_id;
                        $investigation->bill_created_by = Auth::user()->id;
                        $investigation->bill_created_date = date('Y-m-d H:i:s');
                        $investigation->expected_delivery_at = date('Y-m-d');
                        $investigation->report_status = '0'; // 0 => only bill created, 1 => sample collected, 2 => sample collecting, 3 => lab received, 4 => report generated, 5 => report deliverd
                        $investigation->section =  'OPD';
                        $investigation->section_id = $opd_id;
                        $investigation->doctor_id = $request->cons_doctor;
                        $investigation->save();

                        foreach ($charge_normal as $key => $value) {
                            $investigation_details = new InvestigationDetail();
                            $investigation_details->investigation_id = $investigation->id;
                            $investigation_details->charge_normal_id = $value->id;
                            $investigation_details->save();
                        }
                    }
                }
            }

            //SAVE in Payment
            if (count($request->payment_amount) > 0) {
                foreach($request->payment_amount as $key=>$value){
                    if($request->payment_amount[$key] > 0){
                        $payment = new Payment();
                        $payment->billing_id = $bill_id;
                        $payment->patient_id = $patient_id;
                        $payment->section = 'OPD';
                        $payment->payment_amount = $request->payment_amount[$key];
                        $payment->payment_mode = $request->payment_mode[$key];
                        $payment->payment_bank = $request->payment_mode[$key] == 'Cash' ? null : $request->bank_name;
                        $payment->payment_recived_by = Auth::user()->id;
                        $payment->payment_date = date('Y-m-d H:i');
                        $payment->save();
                    }
                }
            }

            //credit use
            if (count($request->adjust_credit_amount ?? []) > 0) {
                foreach($request->adjust_credit_amount as $key=>$value){
                    if($request->adjust_credit_amount[$key] > 0){
                        $credit = new PatientCraditAmount();
                        $credit->billing_id = $bill_id;
                        $credit->patient_id = $patient_id;
                        $credit->date = date('Y-m-d H:i:s');
                        $credit->amount = $request->adjust_credit_amount[$key];
                        $credit->type = 'debit';
                        $credit->remarks = 'reused';
                        $credit->use_bill_id = $request->credit_bill[$key];
                        $credit->generated_by = Auth::user()->id;
                        $credit->save();

                        $upbill = Billing::find($request->credit_bill[$key]);
                        $upbill->cradit_amount = $upbill->cradit_amount - $request->adjust_credit_amount[$key];
                        $upbill->cradituse_bill_id = $upbill->cradituse_bill_id.'_'.$bill_id;
                        $upbill->cradituse_bill_amount = $upbill->cradituse_bill_amount.'_'.$request->adjust_credit_amount[$key];
                        $upbill->save();
                    }
                }
            }

            if($request->enq_id){
                $enq = OpdEnquiry::find($request->enq_id);
                $enq->is_register = 1;
                $enq->update();
            }

            DB::commit();
        } catch (Exception $e) {
            DB::rollback();
            return redirect()->back()->with('error', 'Failed! Please try again!');
        }
        if($request->submit == 'close'){
            return redirect()->route('opd.appointments')->with('success', 'OPD Registration Sucessfully');
        }elseif($request->submit == 'bill'){
            $url1 = route('bill.print-bill', ['opd',ed($bill_id, true)]);
            $return_action = route('opd.appointments');
            return view('open-single-tabs', compact('url1', 'return_action'));
        }elseif($request->submit == 'bill_pre'){
            $url1 = route('bill.print-prescription', ['opd', ed($bill_id, true), 'withoutheader']);
            $url2 = route('bill.print-bill', ['opd', ed($bill_id, true)]);
            $return_action = route('opd.appointments');
            return view('open-multiple-tabs', compact('url1', 'url2', 'return_action'));
        }else{
            return redirect()->route('opd.appointments')->with('success', 'OPD Registration Sucessfully');
        }
    }
    public function appointments(Request $request){
        $doctor = User::where('user_type','doctor')->where('is_active', 1)->where('is_delete', 0)->get();
        if ($request->ajax()) {
            $data = OpdEnquiry::select(
                    'opd_enquiries.*',
                    'u1.salutation as bs',
                    'u1.name as booking_name',
                    'u2.salutation as ds',
                    'u2.name as doctor_name'
                )
                ->join('users as u1','u1.id','=','opd_enquiries.booking_by')
                ->join('users as u2','u2.id','=','opd_enquiries.doctor_id')
                ->where('opd_enquiries.is_delete','0');

            // Filter based on field_name and field_value
            if (!empty($request->field_name) && !empty($request->field_value)) {
                if ($request->field_name === 'opd_enquiries.doctor_id') {
                    $data->where('opd_enquiries.doctor_id', $request->field_value);
                } else {
                    $data->where($request->field_name, 'LIKE', '%' . $request->field_value . '%');
                }
            }

            // Filter by date range
            if (!empty($request->from_date)) {
                $data->whereDate('opd_enquiries.appointment_date', '>=', date('Y-m-d',strtotime($request->from_date)));
            }
            if (!empty($request->to_date)) {
                $data->whereDate('opd_enquiries.appointment_date', '<=', date('Y-m-d',strtotime($request->to_date)));
            }

            // Get the collection
            $collection = $data->get();

            // Sort using Carbon: date desc, time asc
            $sorted = $collection->sort(function($a, $b) {
                $dateA = \Carbon\Carbon::parse($a->appointment_date);
                $dateB = \Carbon\Carbon::parse($b->appointment_date);

                // First, compare date descending
                if ($dateA->eq($dateB)) {
                    // If dates are equal, compare time ascending
                    $timeA = \Carbon\Carbon::parse($a->appointment_time);
                    $timeB = \Carbon\Carbon::parse($b->appointment_time);
                    return $timeA->greaterThan($timeB) ? 1 : ($timeA->lessThan($timeB) ? -1 : 0);
                }
                return $dateA->lessThan($dateB) ? 1 : -1; // Descending
            })->values(); // Re-index

            return Datatables::of($sorted)
                ->addIndexColumn()
                ->addColumn('action', function($row){
                    if($row->is_register){
                        $actionBtn = '<span style="font-size: 16px;font-weight: 700;color: #a93838;">Registered</span>';
                    }else{
                        $actionBtn = '<a href="'.route('opd.opd-register',ed($row->id, true)).'" class="btn btn-primary btn-sm mx-1" title="Register"><i class="fa fa-file"></i> Register</a>';
                        $actionBtn .= '<a onclick="return confirm(\'Are you sure you want to delete this enquiry or appointment, if you delete this enquiry then slot will be empty!\')" href="'.route('opd.delete-appointment', ed($row->id, true)).'" class="btn btn-sm btn-danger mx-1" title="Delete"><i class="bx bxs-trash"></i></a>';
                    }
                    return $actionBtn;
                })
                ->addColumn('app_date', function($row){
                    $date = \Carbon\Carbon::parse($row->appointment_date)->format('d-m-Y');
                    $time = \Carbon\Carbon::parse($row->appointment_time)->format('h:i A');
                    return $date . ' ' . $time;
                })
                ->rawColumns(['action','app_date'])
                ->make(true);
        }
        $data = compact('doctor');
        return view('opd.appointments')->with($data);
    }
    public function delete_appointment($id){
        $id = ed($id, false);
        $data = OpdEnquiry::where('id',$id)->first();
        if($data){
            $slot = TimeSchedule::where('id',$data->slot_id)->first();
            $slot->booked -= 1;
            $slot->save();
        }
        $data->is_delete = 1;
        $data->update();
        return redirect()->back()->with('success','Appointment deleted successfully and free this slot');
    }
    public function opd_doctor_charge(Request $request){
        $doctor = User::where('id',$request->doctorId)->first();
        $charges = Charge::select('charges.id','charges.charge_name','chs.charge_amount')
            ->join('charges_has_sections as chs','chs.charge_id','=','charges.id')
            ->join('charges_sections as cs','cs.id','=','chs.charge_section_id')
            ->where('cs.charges_section_name',$request->section)
            ->where('charges.id',$doctor->charge_id)
            ->where('is_active', 1)
            ->where('is_delete', 0)
            ->first();
        if($charges){
            return response()->json([
                'success' => true,
                'charges' => $charges,
                'department' => $doctor->department_id,
            ]);
        }else{
            return response()->json([
                'success' => false,
            ]);
        }
    }

