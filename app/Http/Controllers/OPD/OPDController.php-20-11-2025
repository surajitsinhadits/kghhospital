    }
    public function change_timeslot(Request $request){
        $data = OpdEnquiry::find($request->enq_id);
        if($data){
            $pre = TimeSchedule::find($data->slot_id);
            $pre->booked -= 1;
            $pre->save();
        }
        $data->slot_id = $request->id;
        $data->appointment_date = $request->a_date;
        $data->appointment_time = date("h:i A", strtotime($request->from_time));
        if($data->save()){
            $next = TimeSchedule::find($request->id);
            $next->booked += 1;
            $next->save();
            return redirect()->route('opd.appointments')->with('success', 'Next Appointment date & time Updated Sucessfully');
        }
    }

