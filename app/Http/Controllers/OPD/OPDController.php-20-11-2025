    public function save_enquiry(Request $request){
        $request->validate([
            'slot_id' => 'required',
            'doctor' => 'required',
            'appointment_date' => 'required',
            'appointment_time' => 'required',
            'uhid' => 'nullable|exists:patients,id',
            'name' => 'required',
            'gender' => 'required',
            'phone' => 'nullable|digits:10'
        ]);
        $data = new OpdEnquiry();
        $data->slot_id = $request->slot_id;
        $data->department_id = $request->department;
        $data->doctor_id = $request->doctor;
        $data->appointment_date  = $request->appointment_date;
        $data->appointment_time = $request->appointment_time;
        $data->booking_time = date('Y-m-d H:i:s');
        $data->booking_by = Auth::user()->id;
        $data->uhid = $request->uhid;
        $data->phone = $request->phone;
        $data->name = ucwords(strtolower($request->name));
        $data->gender = $request->gender;
        $data->dob_year = $request->date_of_birth_year;
        $data->dob_month = $request->date_of_birth_month;
        $data->dob_day = $request->date_of_birth_day;
        $data->address = $request->address;
        if($data->save()){
            $time = TimeSchedule::find($request->slot_id);
            $time->booked += 1;
            $time->save();
            return redirect()->route('opd.add-enquiry')->with('success', 'Enquiry Booked Sucessfully');
        }else{
            return redirect()->route('opd.appointments')->with('error', 'Please try again!');
        }
    }
